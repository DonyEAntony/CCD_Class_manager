<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('dashboard') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .program-card {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--white);
      padding: 1.4rem 1.25rem 1.25rem;
      text-decoration: none;
      display: block;
      transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
      height: 100%;
    }
    .program-card:hover {
      box-shadow: 0 6px 24px var(--shadow-md);
      transform: translateY(-2px);
      border-color: var(--blue-sky);
      text-decoration: none;
    }
    .program-card .prog-icon {
      width: 42px; height: 42px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 0.85rem;
    }
    .program-card .prog-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.05rem; font-weight: 600;
      color: var(--navy); margin-bottom: 0.15rem;
    }
    .program-card .prog-subtitle {
      font-size: 0.75rem; color: var(--blue-sky);
      font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.05em; margin-bottom: 0.5rem;
    }
    .program-card .prog-desc {
      font-size: 0.82rem; color: var(--muted); line-height: 1.5; margin: 0;
    }
    .prog-children .prog-icon { background: rgba(26,39,68,0.08); color: var(--navy); }
    .prog-family   .prog-icon { background: rgba(59,115,87,0.12); color: var(--forest); }
    .prog-ocia     .prog-icon { background: rgba(26,39,68,0.08); color: var(--navy); }
    .prog-baptism  .prog-icon { background: rgba(74,127,193,0.12); color: var(--blue-sky); }
    .prog-confirm  .prog-icon { background: rgba(200,146,42,0.12); color: var(--gold); }
    .prog-sponsor  .prog-icon { background: rgba(26,39,68,0.08); color: var(--navy-soft); }
    .section-label {
      font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.75rem;
    }
  </style>
</head>
<body>
<%- include('_topbar') %>
<% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
<% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
<% const uploadPathsForView = typeof certificateUploadPaths === 'function' ? certificateUploadPaths : ((value) => value ? [value] : []); %>
<main class="container py-4 app-shell mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>
  <% const myFeeBreakdown = Array.isArray(typeof feeBreakdown === 'undefined' ? null : feeBreakdown) ? feeBreakdown : []; %>
  <% const myTotalFeesDue = typeof totalFeesDue === 'number' ? totalFeesDue : 0; %>
  <% const canOpenFaithFormation = user.role === 'admin' || user.role === 'catechist' || (faithFormationSettings && faithFormationSettings.faithFormationRegistrationOpen); %>
  <% const canOpenSponsorForm = user.role === 'admin' || user.role === 'catechist' || (faithFormationSettings && faithFormationSettings.sponsorFormRegistrationOpen); %>

  <% const myIncompleteStudentRegs = (studentRegs || []).filter((r) => String(r.user_id) === String(user.id) && !r.archived_at && r.status === 'incomplete'); %>
  <% if (myIncompleteStudentRegs.length) { %>
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
      <div>
        <strong><%= myIncompleteStudentRegs.length > 1 ? t('unfinished_registration_banner_title_plural') : t('unfinished_registration_banner_title') %></strong>
        <div class="mt-1" style="font-size:.9rem">
          <%= t('unfinished_registration_banner_body').replace('%s', myIncompleteStudentRegs.map((r) => r.student_full_name).join(', ')) %>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <% myIncompleteStudentRegs.forEach((r) => { %>
          <a class="btn btn-warning btn-sm <%= canOpenFaithFormation ? '' : 'disabled' %>" href="<%= canOpenFaithFormation ? ('/registration/children/edit/' + r.id) : '#' %>">
            <%= t('finish_registration_button') %><%= myIncompleteStudentRegs.length > 1 ? ': ' + r.student_full_name : '' %>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (myTotalFeesDue > 0) { %>
    <div class="border rounded-3 p-3 bg-light mb-3">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
        <div>
          <div class="text-muted small"><%= t('total_fees_due_all_active') %></div>
          <div class="fw-semibold fs-5">$<%= myTotalFeesDue %></div>
        </div>
        <a class="btn btn-primary" href="https://giving.myparishsoft.io/App/Form/5dd2d671-d113-4fb2-88d5-dced2fe8a5f3" target="_blank" rel="noreferrer"><%= t('pay_registration_fee_online') %></a>
      </div>
      <% if (myFeeBreakdown.length > 1) { %>
        <div class="table-responsive mt-2">
          <table class="table table-sm mb-0" style="font-size:.85rem">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><%= t('registration_fee_col') %></th>
                <th><%= t('sacramental_fee_col') %></th>
                <th><%= t('late_fee_col') %></th>
                <th><%= t('subtotal_col') %></th>
              </tr>
            </thead>
            <tbody>
              <% myFeeBreakdown.forEach((item) => { %>
                <tr>
                  <td><%= item.name %></td>
                  <td>$<%= item.registrationFee %></td>
                  <td>$<%= item.sacramentalFee %></td>
                  <td>$<%= item.lateFee %></td>
                  <td><strong>$<%= item.total %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>

  <% const myActiveStudentRegs = (studentRegs || []).filter((r) => String(r.user_id) === String(user.id) && !r.archived_at); %>
  <% if (myActiveStudentRegs.length) { %>
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
      <div>
        <strong><%= t('already_have_prefix') %> <%= myActiveStudentRegs.length === 1 ? t('registration_singular') : (myActiveStudentRegs.length + ' ' + t('registrations_word')) %> <%= t('on_file_for_suffix') %></strong>
        <span>
          <% myActiveStudentRegs.forEach((r, i) => { %><%= i > 0 ? ', ' : ' ' %><%= r.student_full_name %> (<%= t(r.status) %>)<% }) %>
        </span>
        <div class="mt-1" style="font-size:.85rem"><%= t('check_my_registrations_prefix') %> "<%= t('my_registrations_tab') %>" <%= t('check_my_registrations_suffix') %></div>
      </div>
      <button type="button" class="btn btn-outline-primary btn-sm" id="jump-to-my-registrations"><%= t('view_my_registrations') %></button>
    </div>
  <% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('dashboard') %></h1>
      <p class="sub mb-0">
        <%= t('signed_in_as') %> <strong><%= user.email %></strong>
        &ensp;<span class="badge badge-role badge-<%= user.role %>"><%= user.role %></span>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (user.role === 'admin') { %>
        <a class="btn btn-primary" href="/admin"><%= t('admin_area') %></a>
      <% } %>
      <% if (user.role === 'family_faith_leader') { %>
        <a class="btn btn-outline-primary" href="/family-faith/visits/availability"><%= t('manage_visit_availability') %></a>
      <% } %>
      <% if (user.role === 'catechist') { %>
        <a class="btn btn-outline-primary" href="/admin/classes"><%= t('my_classes_nav') %></a>
      <% } %>
      <a class="btn btn-outline-primary" href="/calendar"><%= t('calendar') %></a>
      <a class="btn btn-outline-primary" href="/resources"><%= t('resources_nav') %></a>
      <a class="btn btn-outline-primary" href="/account/uploads"><%= t('my_uploads') %></a>
      <% if (user.provider === 'local') { %>
        <a class="btn btn-outline-secondary" href="/account/password"><%= t('change_password') %></a>
      <% } %>
      <a class="btn btn-outline-secondary" href="/logout"><%= t('logout') %></a>
    </div>
  </div>

  <% const myStudentsList = Array.isArray(typeof myStudents === 'undefined' ? null : myStudents) ? myStudents : []; %>

  <ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
    <% if (myStudentsList.length) { %>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="my-students-tab" data-bs-toggle="tab" data-bs-target="#my-students-pane" type="button" role="tab" aria-controls="my-students-pane" aria-selected="false"><%= t('my_students_tab') %></button>
    </li>
    <% } %>
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="new-registration-tab" data-bs-toggle="tab" data-bs-target="#new-registration-pane" type="button" role="tab" aria-controls="new-registration-pane" aria-selected="true"><%= t('new_registration_heading') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="my-registrations-tab" data-bs-toggle="tab" data-bs-target="#my-registrations-pane" type="button" role="tab" aria-controls="my-registrations-pane" aria-selected="false"><%= t('my_registrations_tab') %></button>
    </li>
  </ul>

  <div class="tab-content" id="dashboardTabsContent">
  <% if (myStudentsList.length) { %>
  <div class="tab-pane fade" id="my-students-pane" role="tabpanel" aria-labelledby="my-students-tab">
    <div class="page-card mb-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><%= t('grade') %></th>
                <th><%= t('student_status') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% myStudentsList.forEach((s) => { %>
                <tr>
                  <td style="font-weight:600"><%= s.student_full_name %></td>
                  <td><%= s.grade_level || '—' %></td>
                  <td>
                    <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                      <%= t(s.student_status) %>
                    </span>
                  </td>
                  <td>
                    <a class="btn btn-sm btn-outline-primary <%= canOpenFaithFormation ? '' : 'disabled' %>" href="<%= canOpenFaithFormation ? ('/registration/children?prefillStudentId=' + s.id) : '#' %>"><%= t('register_next_year') %></a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <% } %>
  <div class="tab-pane fade show active" id="new-registration-pane" role="tabpanel" aria-labelledby="new-registration-tab">

  <div class="page-card mb-4">
    <div class="card-body">

      <div class="mb-4">
        <h2 class="h6 mb-3"><%= t('program_registrations_tab') %></h2>
          <div class="row g-3">
            <div class="col-sm-6 col-lg-4">
              <a href="<%= canOpenFaithFormation ? '/registration/children' : '#' %>" class="program-card prog-children <%= canOpenFaithFormation ? '' : 'opacity-75' %>">
                <div class="prog-icon">🎓</div>
                <div class="prog-title"><%= t('prog_children_title') %></div>
                <div class="prog-subtitle"><%= faithFormationSettings && faithFormationSettings.schoolYear ? `${t('school_year')} ${faithFormationSettings.schoolYear}` : t('prog_children_subtitle') %></div>
                <p class="prog-desc"><%= canOpenFaithFormation ? t('prog_children_desc') : t('registration_closed_notice') %></p>
              </a>
            </div>
            <% if (user.role === 'admin') { %>
            <div class="col-sm-6 col-lg-4">
              <a href="/registration/family-faith" class="program-card prog-family">
                <div class="prog-icon">FF</div>
                <div class="prog-title"><%= t('prog_family_title') %></div>
                <div class="prog-subtitle"><%= t('prog_family_subtitle') %></div>
                <p class="prog-desc"><%= t('prog_family_desc') %></p>
              </a>
            </div>
            <% } %>
            <div class="col-sm-6 col-lg-4">
              <a href="/registration/adult/ocia" class="program-card prog-ocia">
                <div class="prog-icon"><%= ADULT_PROGRAMS.ocia.icon %></div>
                <div class="prog-title"><%= ADULT_PROGRAMS.ocia.title %></div>
                <div class="prog-subtitle"><%= ADULT_PROGRAMS.ocia.subtitle %></div>
                <p class="prog-desc"><%= ADULT_PROGRAMS.ocia.description %></p>
              </a>
            </div>
            <div class="col-sm-6 col-lg-4">
              <a href="/registration/adult/baptism_prep" class="program-card prog-baptism">
                <div class="prog-icon"><%= ADULT_PROGRAMS.baptism_prep.icon %></div>
                <div class="prog-title"><%= ADULT_PROGRAMS.baptism_prep.title %></div>
                <div class="prog-subtitle"><%= ADULT_PROGRAMS.baptism_prep.subtitle %></div>
                <p class="prog-desc"><%= ADULT_PROGRAMS.baptism_prep.description %></p>
              </a>
            </div>
            <div class="col-sm-6 col-lg-4">
              <a href="/registration/adult/adult_confirmation" class="program-card prog-confirm">
                <div class="prog-icon"><%= ADULT_PROGRAMS.adult_confirmation.icon %></div>
                <div class="prog-title"><%= ADULT_PROGRAMS.adult_confirmation.title %></div>
                <div class="prog-subtitle"><%= ADULT_PROGRAMS.adult_confirmation.subtitle %></div>
                <p class="prog-desc"><%= ADULT_PROGRAMS.adult_confirmation.description %></p>
              </a>
            </div>
          </div>
      </div>

      <div>
        <h2 class="h6 mb-3"><%= t('sponsor_ministry_signups_tab') %></h2>
        <div class="row g-3">
          <div class="col-sm-6 col-lg-4">
            <a href="<%= canOpenSponsorForm ? '/registration/sponsor-confirmation' : '#' %>" class="program-card prog-sponsor <%= canOpenSponsorForm ? '' : 'opacity-75' %>">
              <div class="prog-icon">SC</div>
              <div class="prog-title"><%= t('confirmation_sponsor_form_title') %></div>
              <div class="prog-subtitle"><%= faithFormationSettings && faithFormationSettings.schoolYear ? `${t('school_year')} ${faithFormationSettings.schoolYear}` : t('student_sponsor_subtitle') %></div>
              <p class="prog-desc"><%= canOpenSponsorForm ? t('sponsor_form_desc') : t('sponsor_form_unavailable') %></p>
            </a>
          </div>
          <div class="col-sm-6 col-lg-4">
            <a href="/altar-server-signup" class="program-card" style="--prog-color:rgba(168,85,247,0.12);--prog-text:rgb(109,40,217)">
              <div class="prog-icon" style="background:rgba(168,85,247,0.12);color:rgb(109,40,217)">&#9765;</div>
              <div class="prog-title"><%= t('altar_server_signup_title') %></div>
              <div class="prog-subtitle"><%= t('ministry_subtitle') %></div>
              <p class="prog-desc"><%= t('altar_server_signup_desc') %></p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  </div>

  <div class="tab-pane fade" id="my-registrations-pane" role="tabpanel" aria-labelledby="my-registrations-tab">

  <!-- Children Registrations -->
  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('faith_formation_children') %></h2></div>
    <div class="card-body p-0">
      <% if (!studentRegs || studentRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_children_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('student') %></th>
              <th><%= t('grade') %></th>
              <th><%= t('primary_contact') %></th>
              <th><%= t('total_fees') %></th>
              <th><%= t('certificates') %></th>
              <th><%= t('status') %></th>
              <th><%= t('submitted_col') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% studentRegs.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.student_full_name %></td>
              <td><%= (typeof resolveCcdGrade === 'function' ? resolveCcdGrade(r) : r.ccd_grade_level) || '—' %></td>
              <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
              <td><strong>$<%= (r.registration_fee||0)+(r.sacramental_fee||0)+(r.late_fee||0) %></strong></td>
              <td style="font-size:.85rem">
                <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                <% baptismPaths.forEach((filePath, index) => { %>
                  <% if (index > 0) { %> &middot; <% } %>
                  <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('baptism') %></a>
                <% }) %>
                <% if (baptismPaths.length && communionPaths.length) { %> &middot; <% } %>
                <% communionPaths.forEach((filePath, index) => { %>
                  <% if (index > 0) { %> &middot; <% } %>
                  <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('communion') %></a>
                <% }) %>
                <% if (!baptismPaths.length && !communionPaths.length) { %><span style="color:var(--muted)">&mdash;</span><% } %>
              </td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
              <td>
                <% const canEditChildRow = String(r.user_id) === String(user.id); %>
                <% if (!canEditChildRow) { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } else if (canOpenFaithFormation) { %>
                  <a href="/registration/children/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <% } else { %>
                  <button class="btn btn-sm btn-outline-secondary" type="button" disabled><%= t('closed_status') %></button>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('family_faith_registrations') %></h2></div>
    <div class="card-body p-0">
      <% if (!familyRegs || familyRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_family_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('family_name') %></th>
              <th><%= t('family_primary_contact') %></th>
              <th><%= t('members_col') %></th>
              <th><%= t('family_badges') %></th>
              <th><%= t('visit_window') %></th>
              <th><%= t('status') %></th>
              <th><%= t('submitted_col') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% familyRegs.forEach((r) => { %>
            <tr>
              <td style="font-weight:600"><%= r.family_name %></td>
              <td style="font-size:.85rem">
                <div><%= r.primary_contact_name || '—' %></div>
                <div style="color:var(--muted)"><%= r.primary_contact_email || r.primary_contact_phone || '—' %></div>
              </td>
              <td style="font-size:.85rem">
                <% if (!r.members.length) { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } else { %>
                  <% r.members.forEach((member) => { %>
                    <div>
                      <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %></strong>
                      <% if (member.role) { %><span style="color:var(--muted)">(<%= t(`role_${member.role}_member`) %>)</span><% } %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td style="font-size:.85rem">
                <% const membersWithNeeds = r.members.filter((member) => member.sacramentNeeds && member.sacramentNeeds.length); %>
                <% if (!membersWithNeeds.length) { %>
                  <span style="color:var(--muted)"><%= t('family_badges_none') %></span>
                <% } else { %>
                  <% membersWithNeeds.forEach((member) => { %>
                    <div class="mb-1">
                      <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %>:</strong>
                      <% member.sacramentNeeds.forEach((need) => { %>
                        <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(need) %></span>
                      <% }) %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td style="font-size:.85rem">
                <% if (r.visit_label) { %>
                  <div><strong><%= t('visit') %>:</strong> <%= r.visit_label %></div>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
              <td>
                <% if (String(r.user_id) === String(user.id)) { %>
                  <a href="/registration/family-faith/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Adult Registrations -->
  <div class="page-card">
    <div class="card-header"><h2 class="h5"><%= t('adult_program_regs') %></h2></div>
    <div class="card-body p-0">
      <% if (!adultRegs || adultRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_adult_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('name_col') %></th>
              <th><%= t('program_col') %></th>
              <th><%= t('email') %></th>
              <th><%= t('phone') %></th>
              <th><%= t('date_col') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% adultRegs.forEach(r => { %>
            <% const prog = ADULT_PROGRAMS[r.program_type] || { title: r.program_type }; %>
            <tr>
              <td style="font-weight:600"><%= r.full_name %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= prog.title %>
                </span>
              </td>
              <td style="font-size:.85rem"><%= r.email || '—' %></td>
              <td style="font-size:.85rem"><%= r.phone || '—' %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <% if (String(r.user_id) === String(user.id)) { %>
                  <a href="/registration/adult/edit/<%= r.program_type %>/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <div class="page-card mt-4">
    <div class="card-header"><h2 class="h5"><%= t('sponsor_confirmation_forms_header') %></h2></div>
    <div class="card-body p-0">
      <% if (!sponsorRegs || sponsorRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_sponsor_forms') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('student') %></th>
              <th><%= t('confirmation_name_col') %></th>
              <th><%= t('sponsor_col') %></th>
              <th><%= t('certificate_col') %></th>
              <th><%= t('verification_col') %></th>
              <th><%= t('submitted_col') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% sponsorRegs.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.student_name %></td>
              <td><%= r.confirmation_name || '—' %></td>
              <td><%= r.sponsor_name %></td>
              <td>
                <% if (Number(r.is_st_matthew_parishioner)) { %>
                  <span><%= t('st_matthew_parishioner') %></span>
                <% } else if (r.sponsor_certificate_path) { %>
                  <a href="/<%= r.sponsor_certificate_path %>"><%= t('view_file') %></a>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td>
                <% if (Number(r.is_st_matthew_parishioner)) { %>
                  <% if (Number(r.admin_verified)) { %>
                    <span class="badge text-bg-success"><%= t('admin_verified') %></span>
                  <% } else { %>
                    <span class="badge text-bg-warning"><%= t('pending_admin_review') %></span>
                  <% } %>
                <% } else if (r.sponsor_certificate_path) { %>
                  <span style="color:var(--muted)"><%= t('certificate_provided') %></span>
                <% } else { %>
                  <span class="badge text-bg-danger"><%= t('missing_certificate') %></span>
                <% } %>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <% const canEditSponsorRow = String(r.user_id) === String(user.id); %>
                <% if (!canEditSponsorRow) { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } else if (canOpenSponsorForm) { %>
                  <a href="/registration/sponsor-confirmation/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <% } else { %>
                  <button class="btn btn-sm btn-outline-secondary" type="button" disabled><%= t('closed_status') %></button>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    const jumpBtn = document.getElementById('jump-to-my-registrations');
    const myRegTab = document.getElementById('my-registrations-tab');
    if (jumpBtn && myRegTab) {
      jumpBtn.addEventListener('click', () => {
        bootstrap.Tab.getOrCreateInstance(myRegTab).show();
        myRegTab.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }());
</script>
</body>
</html>
