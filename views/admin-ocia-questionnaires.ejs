<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('ociaq_admin_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('ociaq_admin_header') %></h1>
      <p class="sub mb-0"><%= t('ociaq_admin_subtitle') %></p>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!questionnaires || questionnaires.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('ociaq_none') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('ociaq_inquirer_name') %></th>
              <th><%= t('email') %></th>
              <th><%= t('phone') %></th>
              <th><%= t('submitted_col') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% questionnaires.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.inquirer_name %></td>
              <td style="font-size:.85rem"><%= r.inquirer_email || '—' %></td>
              <td style="font-size:.85rem"><%= r.inquirer_phone || '—' %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-primary" href="/registration/ocia-questionnaire/edit/<%= r.id %>"><%= t('edit') %></a>
                <form method="post" action="/admin/ocia-questionnaires/<%= r.id %>/delete" onsubmit="return confirm('<%= t('confirm_delete_ocia_questionnaire') %>');">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
