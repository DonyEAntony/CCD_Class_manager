<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('year_calendar_title') %> <%= schoolYear %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .year-title-bar {
      background: #dce3fb;
      border-radius: 4px;
      padding: 0.9rem 1.3rem;
      margin-bottom: 1rem;
    }
    .year-title-bar h1 {
      margin: 0;
      font-size: 1.6rem;
      font-weight: 800;
      color: #22228c;
    }
    .year-title-bar p {
      margin: 0;
      font-weight: 700;
      color: #22228c;
    }
    .year-legend {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.2rem;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 1rem;
    }
    .year-legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .year-legend-swatch {
      width: 14px;
      height: 14px;
      border-radius: 2px;
      background: #8fca8f;
      border: 1px solid #4e934e;
    }
    .year-legend-swatch.off-weekday {
      background: #f3dcdc;
      border: 1px solid #d9a8a8;
    }
    .year-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.1rem;
    }
    .year-month-title {
      background: #dce3fb;
      color: #22228c;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.2rem 0.4rem;
      border: 1px solid #22228c;
      border-bottom: none;
    }
    .year-month-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    .year-month-table th {
      background: #4a5fd9;
      color: #fff;
      font-size: 0.62rem;
      font-weight: 700;
      text-align: center;
      padding: 0.2rem 0;
      border: 1px solid #22228c;
    }
    .year-month-table td {
      border: 1px solid #22228c;
      text-align: center;
      font-size: 0.66rem;
      color: #111;
      padding: 0.28rem 0;
      height: 1.4em;
    }
    .year-month-table td.has-class {
      background: #8fca8f;
      font-weight: 700;
    }
    .year-month-table td.off-weekday {
      background: #f3dcdc;
      color: #8a6a6a;
    }

    @media print {
      @page { size: A4 portrait; margin: 10mm; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print { display: none !important; }
      .year-title-bar { padding: 3mm 4mm; margin-bottom: 3mm; }
      .year-title-bar h1 { font-size: 5mm; }
      .year-title-bar p { font-size: 3mm; }
      .year-legend { font-size: 2.6mm; margin-bottom: 3mm; }
      .year-legend-swatch { width: 3mm; height: 3mm; }
      .year-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 4mm;
        page-break-inside: avoid;
      }
      .year-month-title { font-size: 2.6mm; padding: 0.8mm 1mm; }
      .year-month-table th { font-size: 2mm; padding: 0.5mm 0; }
      .year-month-table td { font-size: 2.2mm; padding: 0.8mm 0; height: auto; }
    }
  </style>
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell-wide mx-auto">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-print">
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary" onclick="window.print()"><%= t('print_button') %></button>
      <a class="btn btn-outline-secondary" href="/calendar"><%= t('back_to_calendar') %></a>
    </div>
  </div>

  <div class="year-title-bar">
    <h1><%= t('year_calendar_title') %><% if (className) { %> &mdash; <%= className %><% } %></h1>
    <p><%= schoolYear %></p>
  </div>

  <div class="year-legend">
    <div class="year-legend-item"><span class="year-legend-swatch"></span><span><%= t('year_calendar_legend') %></span></div>
    <div class="year-legend-item"><span class="year-legend-swatch off-weekday"></span><span><%= t('year_calendar_off_weekday_legend') %></span></div>
  </div>

  <div class="year-grid">
    <% months.forEach((month) => { %>
      <div class="year-month">
        <div class="year-month-title"><%= month.label %></div>
        <table class="year-month-table">
          <thead>
            <tr>
              <% weekdayLabels.forEach((wd) => { %><th><%= wd %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% month.weeks.forEach((week) => { %>
              <tr>
                <% week.forEach((day) => { %>
                  <td class="<%= day && day.hasClass ? 'has-class' : (day && day.isOffWeekday ? 'off-weekday' : '') %>"><%= day ? day.day : '' %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </div>

  <p class="footer-note no-print"><%= t('footer_note') %></p>
</main>
</body>
</html>
