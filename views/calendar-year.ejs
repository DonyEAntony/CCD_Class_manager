<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('year_calendar_title') %> <%= schoolYear %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/page-styles/calendar-year.css">
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell-wide mx-auto">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-print">
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary" onclick="window.print()"><%= t('print_button') %></button>
      <a class="btn btn-outline-secondary" href="/calendar"><%= t('back_to_calendar') %></a>
    </div>
  </div>

  <div class="year-title-bar">
    <h1><%= t('year_calendar_title') %><% if (className) { %> &mdash; <%= className %><% } %></h1>
    <p><%= schoolYear %></p>
  </div>

  <div class="year-legend">
    <div class="year-legend-item"><span class="year-legend-swatch"></span><span><%= t('year_calendar_legend') %></span></div>
    <div class="year-legend-item"><span class="year-legend-swatch off-weekday"></span><span><%= t('year_calendar_off_weekday_legend') %></span></div>
  </div>

  <div class="year-grid">
    <% months.forEach((month) => { %>
      <div class="year-month">
        <div class="year-month-title"><%= month.label %></div>
        <table class="year-month-table">
          <thead>
            <tr>
              <% weekdayLabels.forEach((wd) => { %><th><%= wd %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% month.weeks.forEach((week) => { %>
              <tr>
                <% week.forEach((day) => { %>
                  <td class="<%= day && day.hasClass ? 'has-class' : (day && day.isOffWeekday ? 'off-weekday' : '') %>"><%= day ? day.day : '' %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </div>

  <p class="footer-note no-print"><%= t('footer_note') %></p>
</main>
</body>
</html>
