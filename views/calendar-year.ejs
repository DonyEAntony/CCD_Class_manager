<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('year_calendar_title') %> <%= schoolYear %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .year-legend {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 1rem;
    }
    .year-legend-swatch {
      width: 14px;
      height: 14px;
      border-radius: 3px;
      background: var(--gold-pale);
      border: 1px solid #f0d090;
    }
    .year-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .year-month {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.6rem;
    }
    .year-month-label {
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--navy);
      text-align: center;
      margin-bottom: 0.4rem;
    }
    .year-day-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 2px;
    }
    .year-weekday {
      font-size: 0.6rem;
      font-weight: 700;
      text-align: center;
      color: var(--muted);
    }
    .year-day {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      border-radius: 2px;
      color: var(--ink-soft);
    }
    .year-day.has-class {
      background: var(--gold-pale);
      color: #7a5a1a;
      font-weight: 700;
    }

    @media print {
      @page { size: A4 portrait; margin: 10mm; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print { display: none !important; }
      .year-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 4mm;
        page-break-inside: avoid;
      }
      .year-month {
        padding: 2mm;
        page-break-inside: avoid;
      }
      .year-month-label { font-size: 3mm; margin-bottom: 1mm; }
      .year-day-grid { gap: 0.5mm; }
      .year-weekday { font-size: 2mm; }
      .year-day { font-size: 2.2mm; border-radius: 0.5mm; }
      .year-legend { font-size: 2.6mm; margin-bottom: 3mm; }
      .year-legend-swatch { width: 3mm; height: 3mm; }
    }
  </style>
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell-wide mx-auto">

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2 no-print">
    <div>
      <h1><%= t('year_calendar_title') %></h1>
      <p class="sub mb-0"><%= schoolYear %></p>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary" onclick="window.print()"><%= t('print_button') %></button>
      <a class="btn btn-outline-secondary" href="/calendar"><%= t('back_to_calendar') %></a>
    </div>
  </div>

  <h1 class="d-none d-print-block mb-1"><%= t('year_calendar_title') %> &mdash; <%= schoolYear %></h1>

  <div class="year-legend">
    <span class="year-legend-swatch"></span>
    <span><%= t('year_calendar_legend') %></span>
  </div>

  <div class="year-grid">
    <% months.forEach((month) => { %>
      <div class="year-month">
        <div class="year-month-label"><%= month.label %></div>
        <div class="year-day-grid">
          <% weekdayLabels.forEach((wd) => { %><div class="year-weekday"><%= wd %></div><% }) %>
          <% month.weeks.forEach((week) => { %>
            <% week.forEach((day) => { %>
              <div class="year-day <%= day && day.hasClass ? 'has-class' : '' %>"><%= day ? day.day : '' %></div>
            <% }) %>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <p class="footer-note no-print"><%= t('footer_note') %></p>
</main>
</body>
</html>
