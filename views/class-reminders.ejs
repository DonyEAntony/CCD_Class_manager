<!doctype html>
<html lang="<%= lang %>">
<head><%- include('_communication_head', { title: comm('Class reminders', 'Recordatorios de clase') }) %></head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell mx-auto communication-page">
  <div class="page-heading">
    <a href="/admin/classes/<%= group.id %>">← <%= comm('Back to class', 'Volver a la clase') %></a>
    <h1 class="mt-3"><%= comm('Class reminders', 'Recordatorios de clase') %></h1>
    <p class="sub"><%= group.label %></p>
  </div>
  <% if (success.length) { %><div role="status" class="alert alert-success"><%= success[0] %></div><% } %>
  <% if (!mailReady || deliveryPaused) { %><div role="alert" class="alert alert-warning"><%= comm('Email delivery is paused. Ask the parish administrator to enable the email service. You can save reminder settings now.', 'El envío de correos está en pausa. Pida al administrador parroquial que active el servicio de correo. Puede guardar los recordatorios ahora.') %></div><% } %>
  <div class="row g-4">
    <section class="col-lg-6"><div class="page-card p-4">
      <h2 class="h4"><%= comm('Reminder schedule', 'Horario de recordatorios') %></h2>
      <p><%= comm('Send one email per family for each saved class day. Parents can opt out in Messages.', 'Envíe un correo por familia para cada día de clase guardado. Los padres pueden desactivarlos en Mensajes.') %></p>
      <form method="post" action="/messages/classes/<%= group.id %>/reminders">
        <input type="hidden" name="_csrf" value="<%= communicationCsrf %>">
        <div class="form-check form-switch my-3"><input class="form-check-input" type="checkbox" role="switch" id="enabled" name="enabled" value="1" <%= Number(settings.enabled) ? 'checked' : '' %>>
          <label class="form-check-label" for="enabled"><%= comm('Enable class reminders', 'Activar recordatorios de clase') %></label></div>
        <label class="form-label" for="days-before"><%= comm('Send before class', 'Enviar antes de la clase') %></label>
        <select class="form-select mb-3" id="days-before" name="days_before">
          <% [1, 2, 7].forEach((days) => { %><option value="<%= days %>" <%= Number(settings.days_before) === days ? 'selected' : '' %>><%= days %> <%= comm(days === 1 ? 'day before' : 'days before', days === 1 ? 'día antes' : 'días antes') %></option><% }) %>
        </select>
        <label class="form-label" for="send-hour"><%= comm('Delivery time', 'Hora de envío') %> (<%= timeZone %>)</label>
        <select class="form-select mb-3" id="send-hour" name="send_hour">
          <% for (let hour = 0; hour < 24; hour++) { %><option value="<%= hour %>" <%= Number(settings.send_hour) === hour ? 'selected' : '' %>><%= String(hour).padStart(2, '0') %>:00</option><% } %>
        </select>
        <p class="small text-muted"><%= comm('If the app restarts after the delivery time, it catches up that day. It skips missed reminder days. Only saved Class Day dates are included; retreats and other events are excluded.', 'Si la aplicación se reinicia después de la hora de envío, se pone al día ese mismo día. Omite los días de recordatorio que ya pasaron. Solo se incluyen fechas guardadas como Día de Clase; se excluyen retiros y otros eventos.') %></p>
        <button type="submit" class="btn btn-primary"><%= comm('Save reminders', 'Guardar recordatorios') %></button>
      </form>
    </div></section>
    <section class="col-lg-6"><div class="page-card p-4">
      <h2 class="h4"><%= comm('Upcoming saved class days', 'Próximos días de clase guardados') %></h2>
      <% if (!sessions.length) { %><p class="alert alert-info"><%= comm('No upcoming class days are saved. Add class dates to the calendar before enabling reminders.', 'No hay próximos días de clase guardados. Agregue fechas al calendario antes de activar recordatorios.') %></p><% } %>
      <ul class="list-group list-group-flush mb-3"><% sessions.forEach((session) => { %><li class="list-group-item px-0"><strong><%= session.session_date %></strong><% if (session.description) { %> — <%= session.description %><% } %></li><% }) %></ul>
      <a href="/calendar/class/<%= group.id %>" class="btn btn-outline-secondary"><%= comm('Edit class calendar', 'Editar calendario de clase') %></a>
    </div></section>
  </div>
  <section class="page-card p-4 mt-4">
    <h2 class="h4"><%= comm('Recent reminder delivery', 'Envíos recientes de recordatorios') %></h2>
    <p class="small text-muted"><%= comm('Sent means accepted by the email server. Failed deliveries are retried up to five attempts.', 'Enviado significa aceptado por el servidor de correo. Los envíos fallidos se reintentan hasta cinco veces.') %></p>
    <% if (!log.length) { %><p><%= comm('No reminders have been queued yet.', 'Todavía no se han programado recordatorios.') %></p><% } else { %>
      <div class="table-responsive"><table class="table"><thead><tr><th><%= comm('Class day', 'Día de clase') %></th><th><%= comm('Family', 'Familia') %></th><th><%= comm('Status', 'Estado') %></th><th><%= comm('Attempts', 'Intentos') %></th></tr></thead>
        <tbody><% log.forEach((item) => { %><tr><td><%= item.session_date %></td><td><%= item.full_name || '—' %></td><td><%= comm(({sent:'Sent', pending:'Pending', sending:'Sending', skipped:'Skipped', failed:'Failed'})[item.status] || item.status, ({sent:'Enviado', pending:'Pendiente', sending:'Enviando', skipped:'Omitido', failed:'Fallido'})[item.status] || item.status) %><% if (item.last_error) { %><small class="d-block text-muted"><%= item.last_error %></small><% } %></td><td><%= item.attempts %></td></tr><% }) %></tbody>
      </table></div>
    <% } %>
  </section>
</main>
</body>
</html>
