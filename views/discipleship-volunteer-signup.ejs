<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('volunteer_page_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/page-styles/discipleship-volunteer-signup.css">
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %>
    <div class="alert alert-danger mb-3" role="alert">
      <% if (error.length === 1) { %><%= error[0] %><% } else { %>
        <ul class="mb-0 ps-3"><% error.forEach((message) => { %><li><%= message %></li><% }) %></ul>
      <% } %>
    </div>
  <% } %>

  <%
    // Whether a checkbox should be ticked — on first load nothing is, after a failed
    // submit whatever the person had chosen is restored.
    const picked = (field, slug) => [].concat(formData[field] || []).includes(slug);
  %>

  <section class="volunteer-hero mb-4">
    <p class="eyebrow"><%= t('volunteer_eyebrow') %></p>
    <h1><%= t('volunteer_hero_title') %></h1>
    <p><%= t('volunteer_hero_body') %></p>
  </section>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="page-card">
        <div class="card-header"><h2 class="h5 mb-0"><%= t('volunteer_form_header') %></h2></div>
        <div class="card-body">
          <form class="row g-4" method="post" action="/discipleship-volunteer">

            <fieldset class="col-12">
              <legend><%= t('volunteer_section_about') %></legend>
              <div class="row g-3 mt-0">
                <div class="col-12">
                  <label class="form-label required" for="volunteer-full-name"><%= t('name') %></label>
                  <input class="form-control" id="volunteer-full-name" type="text" name="full_name" value="<%= formData.full_name || '' %>" maxlength="255" autocomplete="name" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label required" for="volunteer-email"><%= t('email') %></label>
                  <input class="form-control" id="volunteer-email" type="email" name="email" value="<%= formData.email || '' %>" maxlength="255" autocomplete="email" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label required" for="volunteer-phone"><%= t('phone') %></label>
                  <input class="form-control" id="volunteer-phone" type="tel" name="phone" value="<%= formData.phone || '' %>" autocomplete="tel" pattern="[0-9]{3}[.\- ]?[0-9]{3}[.\- ]?[0-9]{4}" title="123-456-7890, 123.456.7890, 123 456 7890" required>
                </div>
                <div class="col-12">
                  <label class="form-label required" for="volunteer-marital"><%= t('volunteer_label_marital') %></label>
                  <select class="form-select" id="volunteer-marital" name="marital_status" aria-describedby="volunteer-marital-help" required>
                    <option value=""><%= t('volunteer_marital_placeholder') %></option>
                    <% volunteerOptions.maritalStatuses.forEach((slug) => { %>
                      <option value="<%= slug %>" <%= formData.marital_status === slug ? 'selected' : '' %>><%= t('volunteer_marital_' + slug) %></option>
                    <% }) %>
                  </select>
                  <div class="volunteer-hint mt-1 mb-0" id="volunteer-marital-help"><%= t('volunteer_marital_help') %></div>
                </div>
              </div>
            </fieldset>

            <fieldset class="col-12">
              <legend><%= t('volunteer_section_serve') %></legend>
              <div class="volunteer-hint"><%= t('volunteer_serve_help') %></div>
              <% volunteerOptions.roles.forEach((slug) => { %>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="roles" value="<%= slug %>" id="volunteer-role-<%= slug %>" <%= picked('roles', slug) ? 'checked' : '' %>>
                  <label class="form-check-label" for="volunteer-role-<%= slug %>">
                    <strong><%= t('volunteer_role_' + slug) %></strong>
                    <span class="volunteer-option-desc"><%= t('volunteer_role_' + slug + '_desc') %></span>
                  </label>
                </div>
              <% }) %>

              <div class="mt-3">
                <div class="form-label mb-1"><%= t('volunteer_label_availability') %></div>
                <div class="d-flex flex-wrap gap-3">
                  <% volunteerOptions.availability.forEach((slug) => { %>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" name="availability" value="<%= slug %>" id="volunteer-availability-<%= slug %>" <%= picked('availability', slug) ? 'checked' : '' %>>
                      <label class="form-check-label" for="volunteer-availability-<%= slug %>"><%= t('volunteer_availability_' + slug) %></label>
                    </div>
                  <% }) %>
                </div>
              </div>
            </fieldset>

            <fieldset class="col-12">
              <legend><%= t('volunteer_section_experience') %></legend>
              <div class="volunteer-hint"><%= t('volunteer_experience_help') %></div>
              <% volunteerOptions.experienceTypes.forEach((slug) => { %>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="experience_types" value="<%= slug %>" id="volunteer-experience-<%= slug %>" <%= picked('experience_types', slug) ? 'checked' : '' %>>
                  <label class="form-check-label" for="volunteer-experience-<%= slug %>"><%= t('volunteer_experience_' + slug) %></label>
                </div>
              <% }) %>
              <div class="mt-3">
                <label class="form-label" for="volunteer-experience-details"><%= t('volunteer_label_experience_details') %></label>
                <textarea class="form-control" id="volunteer-experience-details" name="experience_details" rows="3" maxlength="2000" placeholder="<%= t('volunteer_experience_details_placeholder') %>"><%= formData.experience_details || '' %></textarea>
              </div>
            </fieldset>

            <fieldset class="col-12">
              <legend><%= t('volunteer_section_growth') %></legend>
              <div class="volunteer-hint"><%= t('volunteer_growth_help') %></div>
              <% volunteerOptions.growthAreas.forEach((slug) => { %>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="growth_areas" value="<%= slug %>" id="volunteer-growth-<%= slug %>" <%= picked('growth_areas', slug) ? 'checked' : '' %>>
                  <label class="form-check-label" for="volunteer-growth-<%= slug %>"><%= t('volunteer_growth_' + slug) %></label>
                </div>
              <% }) %>
              <div class="mt-3">
                <label class="form-label" for="volunteer-notes"><%= t('volunteer_label_notes') %></label>
                <textarea class="form-control" id="volunteer-notes" name="notes" rows="3" maxlength="2000"><%= formData.notes || '' %></textarea>
              </div>
            </fieldset>

            <div class="volunteer-hp" aria-hidden="true">
              <label for="volunteer-website">Website</label>
              <input id="volunteer-website" type="text" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
              <button class="btn btn-primary" type="submit"><%= t('volunteer_submit') %></button>
              <a class="btn btn-outline-secondary" href="/"><%= t('volunteer_back_home') %></a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="page-card mb-3">
        <div class="card-header"><h2 class="h5 mb-0"><%= t('volunteer_next_header') %></h2></div>
        <div class="card-body">
          <p class="mb-0" style="font-size:.92rem"><%= t('volunteer_next_body') %></p>
        </div>
      </div>
      <div class="volunteer-note"><%= t('volunteer_safe_env_note') %></div>
    </div>
  </div>
</main>
</body>
</html>
