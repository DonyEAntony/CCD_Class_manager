<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('user_administration') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% const availableCcdClasses = Array.isArray(typeof ccdClasses === 'undefined' ? null : ccdClasses) ? ccdClasses : []; %>
  <% const availableCatechists = Array.isArray(typeof catechists === 'undefined' ? null : catechists) ? catechists : []; %>
  <% const availableEventDefinitions = Array.isArray(typeof eventDefinitions === 'undefined' ? null : eventDefinitions) ? eventDefinitions : []; %>
  <% const availableManagedEvents = Array.isArray(typeof managedEvents === 'undefined' ? null : managedEvents) ? managedEvents : []; %>
  <% const selectableRegistrationYears = Array.isArray(typeof registrationYearOptions === 'undefined' ? null : registrationYearOptions) ? registrationYearOptions : []; %>
  <% const registrationYearStatusRows = Array.isArray(typeof registrationYearStatuses === 'undefined' ? null : registrationYearStatuses) ? registrationYearStatuses : []; %>
  <% const availableClassrooms = ['Room 1', 'Room 2', 'Room 3', 'Room 4', 'Conference Room', 'Parish Center']; %>
  <% const availableWeekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('user_administration') %></h1>
      <p class="sub mb-0"><%= t('manage_roles_desc') %></p>
    </div>
  </div>

  <ul class="nav nav-tabs mb-4" id="adminUsersTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-pane" type="button" role="tab" aria-controls="users-pane" aria-selected="true"><%= t('tab_users') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-pane" type="button" role="tab" aria-controls="settings-pane" aria-selected="false"><%= t('tab_settings') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="event-scheduler-tab" data-bs-toggle="tab" data-bs-target="#event-scheduler-pane" type="button" role="tab" aria-controls="event-scheduler-pane" aria-selected="false"><%= t('tab_event_scheduler') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="eucharistic-adoration-tab" data-bs-toggle="tab" data-bs-target="#eucharistic-adoration-pane" type="button" role="tab" aria-controls="eucharistic-adoration-pane" aria-selected="false"><%= t('tab_eucharistic_adoration') %></button>
    </li>
  </ul>

  <div class="tab-content" id="adminUsersTabsContent">
  <div class="tab-pane fade show active" id="users-pane" role="tabpanel" aria-labelledby="users-tab">

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('create_user_header') %></h2></div>
    <div class="card-body">
      <p class="text-muted" style="font-size:.85rem"><%= t('create_user_desc') %></p>
      <form method="post" action="/admin/users/create" class="row gy-2 gx-2 align-items-end">
        <div class="col-12 col-md-3">
          <label class="form-label" for="create-user-full-name"><%= t('invite_full_name_label') %></label>
          <input class="form-control" type="text" id="create-user-full-name" name="full_name" required>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="create-user-email"><%= t('invite_email_label') %></label>
          <input class="form-control" type="email" id="create-user-email" name="email" required>
        </div>
        <div class="col-12 col-md-2">
          <label class="form-label" for="create-user-phone"><%= t('invite_phone_label') %></label>
          <input class="form-control" type="text" id="create-user-phone" name="phone" placeholder="555-123-4567">
        </div>
        <div class="col-12 col-md-2">
          <label class="form-label" for="create-user-role"><%= t('create_user_role_label') %></label>
          <select class="form-select" id="create-user-role" name="role">
            <option value="user"><%= t('role_user') %></option>
            <option value="catechist"><%= t('role_catechist') %></option>
            <option value="family_faith_leader"><%= t('family_faith_leader') %></option>
            <option value="admin"><%= t('role_admin') %></option>
          </select>
        </div>
        <div class="col-12 col-md-2">
          <button class="btn btn-primary w-100" type="submit"><%= t('create_user_submit') %></button>
        </div>
      </form>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('invite_catechist_header') %></h2></div>
    <div class="card-body">
      <p class="text-muted" style="font-size:.85rem"><%= t('invite_catechist_desc') %></p>
      <form method="post" action="/admin/users/catechists" class="row gy-2 gx-2 align-items-end">
        <div class="col-12 col-md-3">
          <label class="form-label" for="invite-full-name"><%= t('invite_full_name_label') %></label>
          <input class="form-control" type="text" id="invite-full-name" name="full_name" required>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="invite-email"><%= t('invite_email_label') %></label>
          <input class="form-control" type="email" id="invite-email" name="email" required>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="invite-phone"><%= t('invite_phone_label') %></label>
          <input class="form-control" type="text" id="invite-phone" name="phone" placeholder="555-123-4567">
        </div>
        <div class="col-12 col-md-3">
          <button class="btn btn-primary w-100" type="submit"><%= t('invite_catechist_submit') %></button>
        </div>
      </form>
    </div>
  </div>

  <% const providerBadgeColors = { local: 'var(--muted)', google: '#4285F4', github: '#24292f' }; %>
  <div class="page-card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <label class="form-label mb-0" for="role-filter"><%= t('filter_by_user_type') %></label>
      <select class="form-select" id="role-filter" name="role" style="max-width:200px" onchange="window.location.href = this.value ? '/admin/users?role=' + this.value : '/admin/users';">
        <option value="" <%= !roleFilter ? 'selected' : '' %>><%= t('all_users') %></option>
        <option value="user" <%= roleFilter === 'user' ? 'selected' : '' %>><%= t('role_user') %></option>
        <option value="catechist" <%= roleFilter === 'catechist' ? 'selected' : '' %>><%= t('role_catechist') %></option>
        <option value="family_faith_leader" <%= roleFilter === 'family_faith_leader' ? 'selected' : '' %>><%= t('family_faith_leader') %></option>
        <option value="admin" <%= roleFilter === 'admin' ? 'selected' : '' %>><%= t('role_admin') %></option>
      </select>
      <input type="text" class="form-control" id="user-search-input" placeholder="<%= t('search_users_placeholder') %>" style="flex:1;min-width:180px">
      <select class="form-select" id="status-filter" style="max-width:180px">
        <option value="All"><%= t('all_statuses') %></option>
        <option value="verified"><%= t('verified_status') %></option>
        <option value="pending"><%= t('pending_status') %></option>
        <option value="deleted"><%= t('deleted_status') %></option>
      </select>
      <span class="text-muted" style="font-size:.85rem;white-space:nowrap" id="user-count-label" data-singular="<%= t('user_singular') %>" data-plural="<%= t('user_plural') %>"><%= users.length %> <%= users.length === 1 ? t('user_singular') : t('user_plural') %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0" id="user-table">
          <thead>
            <tr>
              <th><%= t('email') %></th>
              <th><%= t('name') %></th>
              <th><%= t('phone') %></th>
              <th><%= t('role') %></th>
              <th><%= t('status') %></th>
              <th style="text-align:right;min-width:200px"><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr class="user-row" data-search="<%= `${u.full_name || ''} ${u.email}`.toLowerCase() %>" data-status="<%= isDeletedAccount(u) ? 'deleted' : (u.is_active ? 'verified' : 'pending') %>">
                <td>
                  <div class="d-flex align-items-center">
                    <span class="provider-badge" title="Signed in via <%= u.provider %>" style="color:<%= providerBadgeColors[u.provider] || 'var(--muted)' %>"><%= (u.provider || '?').charAt(0).toUpperCase() %></span>
                    <%= u.email %>
                  </div>
                </td>
                <td><%= u.full_name || '—' %></td>
                <td><%= u.phone || '—' %></td>
                <td><span class="badge badge-role badge-<%= u.role %>"><%= u.role %></span></td>
                <td>
                  <% if (isDeletedAccount(u)) { %>
                    <span class="badge text-bg-secondary"><%= t('deleted_status') %></span>
                  <% } else if (u.is_active) { %>
                    <span class="badge text-bg-success"><%= t('verified_status') %></span>
                  <% } else { %>
                    <span class="badge text-bg-warning"><%= t('pending_status') %></span>
                  <% } %>
                </td>
                <td style="text-align:right;position:relative">
                  <div class="d-inline-flex gap-2 align-items-center">
                    <a class="btn btn-outline-primary" href="/admin/users/<%= u.id %>/registrations"><%= t('view_registrations') %></a>
                    <button type="button" class="icon-btn user-menu-toggle" aria-label="<%= t('more_actions') %>" data-target="user-menu-<%= u.id %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                    </button>
                  </div>
                  <div class="user-menu d-none" id="user-menu-<%= u.id %>">
                    <a class="user-menu-item" href="/admin/users/<%= u.id %>/uploads"><%= t('user_uploads') %></a>
                    <button type="button" class="user-menu-item user-role-toggle" data-target="user-role-form-<%= u.id %>"><%= t('change_role') %></button>
                    <div class="d-none user-role-form" id="user-role-form-<%= u.id %>">
                      <form class="d-flex gap-2" method="post" action="/admin/users/<%= u.id %>/role">
                        <select class="form-select form-select-sm" name="role">
                          <option value="user"      <%= u.role==='user'      ?'selected':'' %>><%= t('role_user') %></option>
                          <option value="catechist" <%= u.role==='catechist' ?'selected':'' %>><%= t('role_catechist') %></option>
                          <option value="family_faith_leader" <%= u.role==='family_faith_leader' ?'selected':'' %>><%= t('family_faith_leader') %></option>
                          <option value="admin"     <%= u.role==='admin'     ?'selected':'' %>><%= t('role_admin') %></option>
                        </select>
                        <button class="btn btn-primary btn-sm" type="submit"><%= t('save') %></button>
                      </form>
                    </div>
                    <% if (u.provider === 'local' && !u.is_active && !isDeletedAccount(u)) { %>
                      <a class="user-menu-item" href="/admin/users/<%= u.id %>/verification-email" target="_blank" rel="noreferrer"><%= t('preview_email') %></a>
                      <form method="post" action="/admin/users/<%= u.id %>/resend-verification">
                        <button class="user-menu-item" type="submit"><%= t('resend') %></button>
                      </form>
                    <% } %>
                    <% if (u.provider === 'local' && !isDeletedAccount(u)) { %>
                      <form method="post" action="/admin/users/<%= u.id %>/reset-password">
                        <button class="user-menu-item" type="submit"><%= t('reset_password_btn') %></button>
                      </form>
                    <% } %>
                    <% if (isDeletedAccount(u)) { %>
                      <div class="user-menu-divider"></div>
                      <form method="post" action="/admin/users/<%= u.id %>/restore">
                        <button class="user-menu-item" type="submit"><%= t('restore_user') %></button>
                      </form>
                    <% } else if (!user || user.id !== u.id) { %>
                      <div class="user-menu-divider"></div>
                      <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_user') %>');">
                        <button class="user-menu-item user-menu-item-danger" type="submit"><%= t('mark_deleted_user') %></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3" id="user-pagination" style="border-top:1px solid var(--border)">
        <span class="text-muted" style="font-size:.85rem" id="user-page-label" data-template="<%= t('page_x_of_y') %>"></span>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="user-page-prev"><%= t('previous_page') %></button>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="user-page-next"><%= t('next_page') %></button>
        </div>
      </div>
    </div>
  </div>

  </div>

  <div class="tab-pane fade" id="settings-pane" role="tabpanel" aria-labelledby="settings-tab">

  <div class="page-card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <h2 class="h5 mb-1"><%= t('scan_legacy_form') %></h2>
        <p class="mb-0 text-muted"><%= t('scan_legacy_desc') %></p>
      </div>
      <a class="btn btn-outline-primary" href="/admin/scan-registration"><%= t('open_scanner') %></a>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('faith_formation_registration_header') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end" method="post" action="/admin/settings/faith-formation">
        <div class="col-md-6">
          <label class="form-label"><%= t('current_registration_year') %></label>
          <select class="form-select" name="current_registration_year" required>
            <% selectableRegistrationYears.forEach((schoolYearOption) => { %>
              <option value="<%= schoolYearOption %>" <%= faithFormationSettings && faithFormationSettings.currentRegistrationYear === schoolYearOption ? 'selected' : '' %>>
                <%= schoolYearOption %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <button class="btn btn-primary" type="submit"><%= t('set_current_registration_year') %></button>
        </div>
      </form>
      <div class="alert alert-secondary mt-3 mb-0">
        <%= t('current_registration_year_label') %>
        <strong><%= faithFormationSettings && faithFormationSettings.currentRegistrationYear ? faithFormationSettings.currentRegistrationYear : '2025-2026' %></strong>.
        <%= t('registration_year_toggle_notice') %>
      </div>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('registration_availability_by_year') %></h2></div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('school_year_col') %></th>
              <th><%= t('faith_formation_col') %></th>
              <th><%= t('sponsor_form_col') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% registrationYearStatusRows.forEach((yearRow) => { %>
              <tr>
                <td style="font-weight:600">
                  <%= yearRow.schoolYear %>
                  <% if (faithFormationSettings && faithFormationSettings.currentRegistrationYear === yearRow.schoolYear) { %>
                    <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border);margin-left:.4rem"><%= t('current_badge') %></span>
                  <% } %>
                </td>
                <td colspan="3">
                  <form class="row g-2 align-items-end" method="post" action="/admin/settings/faith-formation/year">
                    <input type="hidden" name="school_year" value="<%= yearRow.schoolYear %>">
                    <div class="col-md-4">
                      <label class="form-label"><%= t('faith_formation_col') %></label>
                      <select class="form-select" name="faith_formation_registration_open">
                        <option value="1" <%= yearRow.faithFormationOpen ? 'selected' : '' %>><%= t('open_status') %></option>
                        <option value="0" <%= !yearRow.faithFormationOpen ? 'selected' : '' %>><%= t('closed_status') %></option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label"><%= t('sponsor_form_col') %></label>
                      <select class="form-select" name="sponsor_form_registration_open">
                        <option value="1" <%= yearRow.sponsorFormOpen ? 'selected' : '' %>><%= t('open_status') %></option>
                        <option value="0" <%= !yearRow.sponsorFormOpen ? 'selected' : '' %>><%= t('closed_status') %></option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <button class="btn btn-primary" type="submit"><%= t('save') %> <%= yearRow.schoolYear %></button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="page-card mt-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('catechist_assignments_header') %></h2></div>
    <div class="card-body">
      <% const availableCcdGradeMeanings = (typeof ccdGradeMeanings !== 'undefined' && ccdGradeMeanings) ? ccdGradeMeanings : {}; %>
      <p class="text-muted mb-3" style="font-size:.85rem">
        <%= t('preferred_class_time_notice') %>
      </p>
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/ccd-classes">
        <div class="col-md-4">
          <label class="form-label"><%= t('grade') %></label>
          <select class="form-select" name="grade_level" required>
            <option value="" disabled selected><%= t('select_placeholder') %></option>
            <% Object.keys(availableCcdGradeMeanings).forEach((gradeKey) => { %>
              <option value="<%= gradeKey %>"><%= gradeKey %> &mdash; <%= availableCcdGradeMeanings[gradeKey] %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('class_time_label') %></label>
          <input class="form-control" type="text" name="class_time" placeholder="<%= t('class_time_placeholder') %>">
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('room') %></label>
          <input class="form-control" type="text" name="classroom" placeholder="<%= t('room_placeholder') %>">
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('add_class') %></button>
        </div>
      </form>
    </div>
    <div class="card-body p-0">
      <% if (!availableCcdClasses.length) { %>
        <div class="p-4 text-muted"><%= t('no_ccd_classes') %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('class_col') %></th>
                <th><%= t('time') %></th>
                <th><%= t('room') %></th>
                <th><%= t('assigned_catechist_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableCcdClasses.forEach((ccdClass) => { %>
                <tr id="ccd-class-row-<%= ccdClass.id %>">
                  <td>
                    <strong><%= ccdClass.grade_level %><%= ccdClass.sectionLabel || '' %></strong>
                    <% if (availableCcdGradeMeanings[ccdClass.grade_level]) { %>
                      <div style="font-size:.78rem;color:var(--muted)"><%= availableCcdGradeMeanings[ccdClass.grade_level] %></div>
                    <% } %>
                  </td>
                  <td><%= ccdClass.class_time || '—' %></td>
                  <td><%= ccdClass.classroom || '—' %></td>
                  <td>
                    <% const rowCatechists = ccdClass.catechists || []; %>
                    <% if (!rowCatechists.length) { %>
                      <span style="color:var(--muted)"><%= t('unassigned') %></span>
                    <% } else { %>
                      <% rowCatechists.slice(0, 2).forEach((catechist) => { %>
                        <div><%= catechist.name || '—' %></div>
                        <div style="font-size:.82rem;color:var(--muted)"><%= catechist.email || '' %></div>
                      <% }) %>
                      <% if (rowCatechists.length > 2) { %>
                        <div class="d-none" id="catechists-more-<%= ccdClass.id %>">
                          <% rowCatechists.slice(2).forEach((catechist) => { %>
                            <div><%= catechist.name || '—' %></div>
                            <div style="font-size:.82rem;color:var(--muted)"><%= catechist.email || '' %></div>
                          <% }) %>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0 catechists-show-toggle" data-target="catechists-more-<%= ccdClass.id %>" data-show-label="<%= t('show_all_label') %> (+<%= rowCatechists.length - 2 %>)" data-hide-label="<%= t('show_less_label') %>" style="font-size:.78rem"><%= t('show_all_label') %> (+<%= rowCatechists.length - 2 %>)</button>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm ccd-class-edit-toggle" data-target="ccd-class-edit-<%= ccdClass.id %>"><%= t('edit') %></button>
                    <form method="post" action="/admin/ccd-classes/<%= ccdClass.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_class') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
                <tr class="d-none" id="ccd-class-edit-<%= ccdClass.id %>">
                  <td colspan="5" style="background:var(--surface)">
                    <form class="row g-2 align-items-end" method="post" action="/admin/ccd-classes/<%= ccdClass.id %>/update">
                      <div class="col-md-2">
                        <label class="form-label mb-1" style="font-size:.7rem"><%= t('section_col') %></label>
                        <input class="form-control form-control-sm" type="text" name="section_label" maxlength="10" value="<%= ccdClass.sectionLabel || '' %>" placeholder="<%= t('section_label_placeholder') %>">
                      </div>
                      <div class="col-md-3">
                        <label class="form-label mb-1" style="font-size:.7rem"><%= t('class_time_label') %></label>
