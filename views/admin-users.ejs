</main>
<script>
  (function () {
    const scheduleType = document.querySelector('select[name="schedule_type"]');
    const eventDateField = document.getElementById('event-date-field');
    const weekdayField = document.getElementById('event-weekday-field');
    const eventDateInput = document.querySelector('input[name="event_date"]');
    const weekdaySelect = document.querySelector('select[name="recurrence_pattern"]');

    if (!scheduleType || !eventDateField || !weekdayField || !eventDateInput || !weekdaySelect) return;

    const updateScheduleFields = () => {
      const isRecurring = scheduleType.value === 'recurring';
      eventDateField.classList.toggle('d-none', isRecurring);
      weekdayField.classList.toggle('d-none', !isRecurring);
      eventDateInput.required = !isRecurring;
      weekdaySelect.required = isRecurring;

      if (isRecurring) {
        eventDateInput.value = '';
      } else {
        weekdaySelect.value = '';
      }
    };

    scheduleType.addEventListener('change', updateScheduleFields);
    updateScheduleFields();
  }());

  (function () {
    document.querySelectorAll('.ccd-class-edit-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.getAttribute('data-target'));
        if (target) target.classList.toggle('d-none');
      });
    });
  }());

  (function () {
    document.querySelectorAll('.catechists-show-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.getAttribute('data-target'));
        if (!target) return;
        const nowHidden = target.classList.toggle('d-none');
        btn.textContent = nowHidden ? btn.getAttribute('data-show-label') : btn.getAttribute('data-hide-label');
      });
    });
  }());

  (function () {
    const closeAllMenus = (except) => {
      document.querySelectorAll('.user-menu').forEach((menu) => {
        if (menu !== except) menu.classList.add('d-none');
      });
    };

    // Menus are position:fixed so they can escape the table's horizontal-scroll
    // container instead of being clipped by it; position them against the
    // viewport here, flipping above the toggle button when there isn't room below.
    const positionMenu = (btn, menu) => {
      const btnRect = btn.getBoundingClientRect();
      const menuRect = menu.getBoundingClientRect();
      const margin = 4;
      const left = Math.max(8, Math.min(btnRect.right - menuRect.width, window.innerWidth - menuRect.width - 8));
      let top = btnRect.bottom + margin;
      if (top + menuRect.height > window.innerHeight - 8) {
        top = btnRect.top - menuRect.height - margin;
      }
      menu.style.left = `${left}px`;
      menu.style.top = `${Math.max(8, top)}px`;
    };

    document.querySelectorAll('.user-menu-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = document.getElementById(btn.getAttribute('data-target'));
        if (!menu) return;
        const willOpen = menu.classList.contains('d-none');
        closeAllMenus();
        if (willOpen) {
          menu.classList.remove('d-none');
          positionMenu(btn, menu);
        }
      });
    });

    document.querySelectorAll('.user-role-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const form = document.getElementById(btn.getAttribute('data-target'));
        if (form) form.classList.toggle('d-none');
      });
    });

    document.querySelectorAll('.user-menu').forEach((menu) => {
      menu.addEventListener('click', (e) => e.stopPropagation());
    });

    document.addEventListener('click', () => closeAllMenus());
    // A fixed-position menu doesn't move with page or table scroll, so just close it
    // rather than let it drift away from the button that opened it.
    window.addEventListener('scroll', () => closeAllMenus(), true);
    window.addEventListener('resize', () => closeAllMenus());
  }());

  (function () {
    const searchInput = document.getElementById('user-search-input');
    const statusFilter = document.getElementById('status-filter');
    const countLabel = document.getElementById('user-count-label');
    const pageLabel = document.getElementById('user-page-label');
    const prevBtn = document.getElementById('user-page-prev');
    const nextBtn = document.getElementById('user-page-next');
    const pagination = document.getElementById('user-pagination');
    const rows = Array.from(document.querySelectorAll('#user-table .user-row'));
    if (!searchInput || !statusFilter || !rows.length) return;

    const PAGE_SIZE = 10;
    let currentPage = 1;

    const getMatches = () => {
      const query = searchInput.value.trim().toLowerCase();
      const status = statusFilter.value;
      return rows.filter((row) => {
        const matchesQuery = !query || row.getAttribute('data-search').includes(query);
        const matchesStatus = status === 'All' || row.getAttribute('data-status') === status;
        return matchesQuery && matchesStatus;
      });
    };

    const render = () => {
      const matches = getMatches();
      const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * PAGE_SIZE;
      const pageRows = new Set(matches.slice(start, start + PAGE_SIZE));
      rows.forEach((row) => row.classList.toggle('d-none', !pageRows.has(row)));

      if (countLabel) {
        const label = matches.length === 1 ? countLabel.getAttribute('data-singular') : countLabel.getAttribute('data-plural');
        countLabel.textContent = `${matches.length} ${label}`;
      }
      if (pageLabel) {
        pageLabel.textContent = pageLabel.getAttribute('data-template')
          .replace('{page}', currentPage)
          .replace('{total}', totalPages);
      }
      if (pagination) pagination.classList.toggle('d-none', matches.length <= PAGE_SIZE);
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    };

    searchInput.addEventListener('input', () => { currentPage = 1; render(); });
    statusFilter.addEventListener('change', () => { currentPage = 1; render(); });
    if (prevBtn) prevBtn.addEventListener('click', () => { currentPage -= 1; render(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { currentPage += 1; render(); });

    render();
  }());
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
