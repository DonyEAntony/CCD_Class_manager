<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('user_administration') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% const availableCcdClasses = Array.isArray(typeof ccdClasses === 'undefined' ? null : ccdClasses) ? ccdClasses : []; %>
  <% const availableCatechists = Array.isArray(typeof catechists === 'undefined' ? null : catechists) ? catechists : []; %>
  <% const availableEventDefinitions = Array.isArray(typeof eventDefinitions === 'undefined' ? null : eventDefinitions) ? eventDefinitions : []; %>
  <% const availableManagedEvents = Array.isArray(typeof managedEvents === 'undefined' ? null : managedEvents) ? managedEvents : []; %>
  <% const selectableRegistrationYears = Array.isArray(typeof registrationYearOptions === 'undefined' ? null : registrationYearOptions) ? registrationYearOptions : []; %>
  <% const registrationYearStatusRows = Array.isArray(typeof registrationYearStatuses === 'undefined' ? null : registrationYearStatuses) ? registrationYearStatuses : []; %>
  <% const availableClassrooms = ['Room 1', 'Room 2', 'Room 3', 'Room 4', 'Conference Room', 'Parish Center']; %>
  <% const availableWeekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('user_administration') %></h1>
      <p class="sub mb-0"><%= t('manage_roles_desc') %></p>
    </div>
  </div>

  <ul class="nav nav-tabs mb-4" id="adminUsersTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-pane" type="button" role="tab" aria-controls="users-pane" aria-selected="true"><%= t('tab_users') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-pane" type="button" role="tab" aria-controls="settings-pane" aria-selected="false"><%= t('tab_settings') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="event-scheduler-tab" data-bs-toggle="tab" data-bs-target="#event-scheduler-pane" type="button" role="tab" aria-controls="event-scheduler-pane" aria-selected="false"><%= t('tab_event_scheduler') %></button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="eucharistic-adoration-tab" data-bs-toggle="tab" data-bs-target="#eucharistic-adoration-pane" type="button" role="tab" aria-controls="eucharistic-adoration-pane" aria-selected="false"><%= t('tab_eucharistic_adoration') %></button>
    </li>
  </ul>

  <div class="tab-content" id="adminUsersTabsContent">
  <div class="tab-pane fade show active" id="users-pane" role="tabpanel" aria-labelledby="users-tab">

  <div class="page-card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <label class="form-label mb-0" for="role-filter"><%= t('filter_by_user_type') %></label>
      <select class="form-select" id="role-filter" name="role" style="max-width:220px" onchange="window.location.href = this.value ? '/admin/users?role=' + this.value : '/admin/users';">
        <option value="" <%= !roleFilter ? 'selected' : '' %>><%= t('all_users') %></option>
        <option value="user" <%= roleFilter === 'user' ? 'selected' : '' %>><%= t('role_user') %></option>
        <option value="catechist" <%= roleFilter === 'catechist' ? 'selected' : '' %>><%= t('role_catechist') %></option>
        <option value="family_faith_leader" <%= roleFilter === 'family_faith_leader' ? 'selected' : '' %>><%= t('family_faith_leader') %></option>
        <option value="admin" <%= roleFilter === 'admin' ? 'selected' : '' %>><%= t('role_admin') %></option>
      </select>
      <span class="text-muted" style="font-size:.85rem"><%= users.length %> <%= users.length === 1 ? t('user_singular') : t('user_plural') %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('email') %></th>
              <th><%= t('name') %></th>
              <th><%= t('phone') %></th>
              <th><%= t('role') %></th>
              <th><%= t('status') %></th>
              <th><%= t('provider') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.email %></td>
                <td><%= u.full_name || '—' %></td>
                <td><%= u.phone || '—' %></td>
                <td><span class="badge badge-role badge-<%= u.role %>"><%= u.role %></span></td>
                <td>
                  <% if (u.is_active) { %>
                    <span class="badge text-bg-success"><%= t('verified_status') %></span>
                  <% } else { %>
                    <span class="badge text-bg-warning"><%= t('pending_status') %></span>
                  <% } %>
                </td>
                <td style="font-size:.85rem;color:var(--muted)"><%= u.provider %></td>
                <td>
                  <div class="d-flex gap-2 flex-wrap">
                    <form class="d-flex gap-2" method="post" action="/admin/users/<%= u.id %>/role">
                      <select class="form-select" name="role" style="max-width:150px">
                        <option value="user"      <%= u.role==='user'      ?'selected':'' %>><%= t('role_user') %></option>
                        <option value="catechist" <%= u.role==='catechist' ?'selected':'' %>><%= t('role_catechist') %></option>
                        <option value="family_faith_leader" <%= u.role==='family_faith_leader' ?'selected':'' %>><%= t('family_faith_leader') %></option>
                        <option value="admin"     <%= u.role==='admin'     ?'selected':'' %>><%= t('role_admin') %></option>
                      </select>
                      <button class="btn btn-primary" type="submit"><%= t('save') %></button>
                    </form>
                    <% if (u.provider === 'local' && !u.is_active) { %>
                      <a class="btn btn-outline-secondary" href="/admin/users/<%= u.id %>/verification-email" target="_blank" rel="noreferrer"><%= t('preview_email') %></a>
                      <form method="post" action="/admin/users/<%= u.id %>/resend-verification">
                        <button class="btn btn-outline-primary" type="submit"><%= t('resend') %></button>
                      </form>
                    <% } %>
                    <% if (u.provider === 'local') { %>
                      <form method="post" action="/admin/users/<%= u.id %>/reset-password">
                        <button class="btn btn-outline-secondary" type="submit"><%= t('reset_password_btn') %></button>
                      </form>
                    <% } %>
                    <% if (!user || user.id !== u.id) { %>
                      <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_user') %>');">
                        <button class="btn btn-outline-danger" type="submit"><%= t('remove') %></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  </div>

  <div class="tab-pane fade" id="settings-pane" role="tabpanel" aria-labelledby="settings-tab">

  <div class="page-card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <h2 class="h5 mb-1"><%= t('scan_legacy_form') %></h2>
        <p class="mb-0 text-muted"><%= t('scan_legacy_desc') %></p>
      </div>
      <a class="btn btn-outline-primary" href="/admin/scan-registration"><%= t('open_scanner') %></a>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('faith_formation_registration_header') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end" method="post" action="/admin/settings/faith-formation">
        <div class="col-md-6">
          <label class="form-label"><%= t('current_registration_year') %></label>
          <select class="form-select" name="current_registration_year" required>
            <% selectableRegistrationYears.forEach((schoolYearOption) => { %>
              <option value="<%= schoolYearOption %>" <%= faithFormationSettings && faithFormationSettings.currentRegistrationYear === schoolYearOption ? 'selected' : '' %>>
                <%= schoolYearOption %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <button class="btn btn-primary" type="submit"><%= t('set_current_registration_year') %></button>
        </div>
      </form>
      <div class="alert alert-secondary mt-3 mb-0">
        <%= t('current_registration_year_label') %>
        <strong><%= faithFormationSettings && faithFormationSettings.currentRegistrationYear ? faithFormationSettings.currentRegistrationYear : '2025-2026' %></strong>.
        <%= t('registration_year_toggle_notice') %>
      </div>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('registration_availability_by_year') %></h2></div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('school_year_col') %></th>
              <th><%= t('faith_formation_col') %></th>
              <th><%= t('sponsor_form_col') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% registrationYearStatusRows.forEach((yearRow) => { %>
              <tr>
                <td style="font-weight:600">
                  <%= yearRow.schoolYear %>
                  <% if (faithFormationSettings && faithFormationSettings.currentRegistrationYear === yearRow.schoolYear) { %>
                    <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border);margin-left:.4rem"><%= t('current_badge') %></span>
                  <% } %>
                </td>
                <td colspan="3">
                  <form class="row g-2 align-items-end" method="post" action="/admin/settings/faith-formation/year">
                    <input type="hidden" name="school_year" value="<%= yearRow.schoolYear %>">
                    <div class="col-md-4">
                      <label class="form-label"><%= t('faith_formation_col') %></label>
                      <select class="form-select" name="faith_formation_registration_open">
                        <option value="1" <%= yearRow.faithFormationOpen ? 'selected' : '' %>><%= t('open_status') %></option>
                        <option value="0" <%= !yearRow.faithFormationOpen ? 'selected' : '' %>><%= t('closed_status') %></option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label"><%= t('sponsor_form_col') %></label>
                      <select class="form-select" name="sponsor_form_registration_open">
                        <option value="1" <%= yearRow.sponsorFormOpen ? 'selected' : '' %>><%= t('open_status') %></option>
                        <option value="0" <%= !yearRow.sponsorFormOpen ? 'selected' : '' %>><%= t('closed_status') %></option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <button class="btn btn-primary" type="submit"><%= t('save') %> <%= yearRow.schoolYear %></button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="page-card mt-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('catechist_assignments_header') %></h2></div>
    <div class="card-body">
      <% const availableCcdGradeMeanings = (typeof ccdGradeMeanings !== 'undefined' && ccdGradeMeanings) ? ccdGradeMeanings : {}; %>
      <p class="text-muted mb-3" style="font-size:.85rem">
        <%= t('preferred_class_time_notice') %>
      </p>
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/ccd-classes">
        <div class="col-md-4">
          <label class="form-label"><%= t('grade') %></label>
          <select class="form-select" name="grade_level" required>
            <option value="" disabled selected><%= t('select_placeholder') %></option>
            <% Object.keys(availableCcdGradeMeanings).forEach((gradeKey) => { %>
              <option value="<%= gradeKey %>"><%= gradeKey %> &mdash; <%= availableCcdGradeMeanings[gradeKey] %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('class_time_label') %></label>
          <input class="form-control" type="text" name="class_time" placeholder="<%= t('class_time_placeholder') %>">
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('room') %></label>
          <input class="form-control" type="text" name="classroom" placeholder="<%= t('room_placeholder') %>">
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('add_class') %></button>
        </div>
      </form>
    </div>
    <div class="card-body p-0">
      <% if (!availableCcdClasses.length) { %>
        <div class="p-4 text-muted"><%= t('no_ccd_classes') %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('class_col') %></th>
                <th><%= t('time') %></th>
                <th><%= t('room') %></th>
                <th><%= t('assigned_catechist_col') %></th>
                <th><%= t('update') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableCcdClasses.forEach((ccdClass) => { %>
                <tr>
                  <td>
                    <strong><%= ccdClass.grade_level %><%= ccdClass.sectionLabel || '' %></strong>
                    <% if (availableCcdGradeMeanings[ccdClass.grade_level]) { %>
                      <div style="font-size:.78rem;color:var(--muted)"><%= availableCcdGradeMeanings[ccdClass.grade_level] %></div>
                    <% } %>
                  </td>
                  <td><%= ccdClass.class_time || '—' %></td>
                  <td><%= ccdClass.classroom || '—' %></td>
                  <td>
                    <% if (ccdClass.catechist_name || ccdClass.catechist_email) { %>
                      <div><%= ccdClass.catechist_name || '—' %></div>
                      <div style="font-size:.82rem;color:var(--muted)"><%= ccdClass.catechist_email || '' %></div>
                    <% } else { %>
                      <span style="color:var(--muted)"><%= t('unassigned') %></span>
                    <% } %>
                  </td>
                  <td>
                    <form class="d-flex gap-2 flex-wrap" method="post" action="/admin/ccd-classes/<%= ccdClass.id %>/catechist">
                      <select class="form-select" name="catechist_user_id" style="min-width:240px">
                        <option value=""><%= t('unassigned') %></option>
                        <% availableCatechists.forEach((catechist) => { %>
                          <option value="<%= catechist.id %>" <%= Number(ccdClass.catechist_user_id) === Number(catechist.id) ? 'selected' : '' %>>
                            <%= catechist.full_name || catechist.email %> (<%= catechist.email %>)
                          </option>
                        <% }) %>
                      </select>
                      <button class="btn btn-outline-primary" type="submit"><%= t('assign') %></button>
                    </form>
                  </td>
                  <td>
                    <form method="post" action="/admin/ccd-classes/<%= ccdClass.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_class') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Altar Server Training Dates -->
  <div class="page-card mt-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('altar_training_dates_header') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/altar-server/training-dates">
        <div class="col-md-3">
          <label class="form-label"><%= t('training_date_label') %></label>
          <input class="form-control" type="date" name="training_date" required>
        </div>
        <div class="col-md-2">
          <label class="form-label"><%= t('time') %></label>
          <input class="form-control" type="time" name="training_time" value="09:00" required>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('location') %></label>
          <input class="form-control" type="text" name="location" placeholder="<%= t('location_placeholder_parish_center') %>">
        </div>
        <div class="col-md-2">
          <label class="form-label"><%= t('notes') %></label>
          <input class="form-control" type="text" name="notes" placeholder="<%= t('notes_placeholder_optional') %>">
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('add_training_date') %></button>
        </div>
      </form>

      <% const availableAltarTrainingDates = Array.isArray(typeof altarServerTrainingDates === 'undefined' ? null : altarServerTrainingDates) ? altarServerTrainingDates : []; %>
      <% if (!availableAltarTrainingDates.length) { %>
        <p class="mb-0 text-muted"><%= t('no_altar_training_dates') %></p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('date_time_col') %></th>
                <th><%= t('location') %></th>
                <th><%= t('notes') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableAltarTrainingDates.forEach((dateItem) => { %>
                <tr>
                  <td><strong><%= dateItem.label %></strong></td>
                  <td><%= dateItem.location || '<span style="color:var(--muted)">—</span>' %></td>
                  <td><%= dateItem.notes || '<span style="color:var(--muted)">—</span>' %></td>
                  <td>
                    <form method="post" action="/admin/altar-server/training-dates/<%= dateItem.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_training_date') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Altar Server Signups -->
  <div class="page-card mt-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('altar_signups_header') %></h2></div>
    <div class="card-body p-0">
      <% const availableAltarSignups = Array.isArray(typeof altarServerSignups === 'undefined' ? null : altarServerSignups) ? altarServerSignups : []; %>
      <% if (!availableAltarSignups.length) { %>
        <div class="p-4 text-muted"><%= t('no_altar_signups') %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('child_col') %></th>
                <th><%= t('grade') %></th>
                <th><%= t('parent_guardian_col') %></th>
                <th><%= t('preferred_training_col') %></th>
                <th><%= t('notes') %></th>
                <th><%= t('status') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableAltarSignups.forEach((signup) => { %>
                <tr>
                  <td><strong><%= signup.child_first_name %> <%= signup.child_last_name %></strong>
                    <% if (signup.child_dob) { %><div style="font-size:.82rem;color:var(--muted)"><%= t('dob_prefix') %> <%= signup.child_dob %></div><% } %>
                  </td>
                  <td><%= signup.child_grade || '<span style="color:var(--muted)">—</span>' %></td>
                  <td>
                    <div><strong><%= signup.parent_name %></strong></div>
                    <div><a href="mailto:<%= signup.parent_email %>"><%= signup.parent_email %></a></div>
                    <div style="font-size:.82rem;color:var(--muted)"><%= signup.parent_phone %></div>
                  </td>
                  <td style="font-size:.85rem">
                    <% if (signup.training_date) { %>
                      <%= formatAdorationDateLabel(`${signup.training_date}`.slice(0, 10)) %><br>
                      <% if (signup.training_time) { %><span style="color:var(--muted)"><%= formatTimeLabel(signup.training_time) %></span><% } %>
                      <% if (signup.training_location) { %><br><span style="color:var(--muted)"><%= signup.training_location %></span><% } %>
                    <% } else { %>
                      <span style="color:var(--muted)"><%= t('no_preference') %></span>
                    <% } %>
                  </td>
                  <td style="max-width:240px;font-size:.85rem"><%= signup.notes || '<span style="color:var(--muted)">—</span>' %></td>
                  <td>
                    <form class="d-flex gap-1 align-items-center" method="post" action="/admin/altar-server/signups/<%= signup.id %>/status">
                      <select class="form-select form-select-sm" name="status" style="max-width:130px">
                        <option value="pending"   <%= signup.status === 'pending'   ? 'selected' : '' %>><%= t('pending_status') %></option>
                        <option value="confirmed" <%= signup.status === 'confirmed' ? 'selected' : '' %>><%= t('confirmed_status') %></option>
                        <option value="completed" <%= signup.status === 'completed' ? 'selected' : '' %>><%= t('completed') %></option>
                        <option value="cancelled" <%= signup.status === 'cancelled' ? 'selected' : '' %>><%= t('cancelled') %></option>
                      </select>
                      <button class="btn btn-outline-primary btn-sm" type="submit"><%= t('save') %></button>
                    </form>
                  </td>
                  <td style="font-size:.82rem;color:var(--muted)">
                    <%= signup.created_at ? (typeof signup.created_at === 'string' ? signup.created_at.slice(0, 16).replace('T', ' ') : signup.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %>
                  </td>
                  <td>
                    <form method="post" action="/admin/altar-server/signups/<%= signup.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_altar_signup') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  </div>

  <div class="tab-pane fade" id="event-scheduler-pane" role="tabpanel" aria-labelledby="event-scheduler-tab">

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('event_definitions') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/events">
        <div class="col-md-4">
          <label class="form-label"><%= t('event_title') %></label>
          <input class="form-control" type="text" name="title" required>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('audience') %></label>
          <select class="form-select" name="audience" required>
            <option value="children"><%= t('children_faith_formation') %></option>
            <option value="family_faith"><%= t('prog_family_title') %></option>
            <option value="baptism_prep"><%= t('prog_baptism_title') %></option>
            <option value="ocia"><%= t('prog_ocia_title') %></option>
            <option value="general"><%= t('general_events') %></option>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('add_event') %></button>
        </div>
      </form>

      <% if (!availableEventDefinitions.length) { %>
        <p class="mb-0 text-muted"><%= t('no_event_definitions') %></p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('event_title') %></th>
                <th><%= t('audience') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableEventDefinitions.forEach((eventDefinition) => { %>
                <tr>
                  <td><%= eventDefinition.title %></td>
                  <td><%= t(eventDefinition.audience === 'children' ? 'children_faith_formation' : eventDefinition.audience === 'family_faith' ? 'prog_family_title' : eventDefinition.audience === 'general' ? 'general_events' : eventDefinition.audience === 'baptism_prep' ? 'prog_baptism_title' : 'prog_ocia_title') %></td>
                  <td>
                    <form method="post" action="/admin/events/<%= eventDefinition.id %>/delete">
                      <button class="btn btn-outline-secondary btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="page-card">
    <div class="card-header"><h2 class="h5"><%= t('event_schedule') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/event-schedules">
        <div class="col-md-4">
          <label class="form-label"><%= t('event_title') %></label>
          <select class="form-select" name="event_definition_id" required>
            <option value=""><%= t('select_event') %></option>
            <% availableEventDefinitions.forEach((eventDefinition) => { %>
              <option value="<%= eventDefinition.id %>"><%= eventDefinition.title %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label"><%= t('schedule_type') %></label>
          <select class="form-select" name="schedule_type" required>
            <option value="one_time"><%= t('one_time_event') %></option>
            <option value="recurring"><%= t('recurring_event') %></option>
          </select>
        </div>
        <div class="col-md-2" id="event-date-field">
          <label class="form-label"><%= t('event_date') %></label>
          <input class="form-control" type="date" name="event_date">
        </div>
        <div class="col-md-1">
          <label class="form-label"><%= t('event_time') %></label>
          <input class="form-control" type="time" name="event_time">
        </div>
        <div class="col-md-1">
          <label class="form-label"><%= t('event_end_time') %></label>
          <input class="form-control" type="time" name="event_end_time">
        </div>
        <div class="col-md-3 d-none" id="event-weekday-field">
          <label class="form-label"><%= t('weekday') %></label>
          <select class="form-select" name="recurrence_pattern">
            <option value=""><%= t('select_weekday') %></option>
            <% availableWeekdays.forEach((day) => { %>
              <option value="<%= day %>"><%= day %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label"><%= t('event_location') %></label>
          <select class="form-select" name="location">
            <option value=""><%= t('select_classroom') %></option>
            <% availableClassrooms.forEach((room) => { %>
              <option value="<%= room %>"><%= room %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('schedule_event') %></button>
        </div>
      </form>

      <% if (!availableManagedEvents.length) { %>
        <p class="mb-0 text-muted"><%= t('no_events_configured') %></p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('event_title') %></th>
                <th><%= t('audience') %></th>
                <th><%= t('schedule_type') %></th>
                <th><%= t('weekday') %></th>
                <th><%= t('event_date') %></th>
                <th><%= t('event_time') %></th>
                <th><%= t('event_end_time') %></th>
                <th><%= t('event_location') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% availableManagedEvents.forEach((eventItem) => { %>
                <tr>
                  <td><%= eventItem.title %></td>
                  <td><%= t(eventItem.audience === 'children' ? 'children_faith_formation' : eventItem.audience === 'family_faith' ? 'prog_family_title' : eventItem.audience === 'general' ? 'general_events' : eventItem.audience === 'baptism_prep' ? 'prog_baptism_title' : 'prog_ocia_title') %></td>
                  <td><%= t(eventItem.schedule_type === 'recurring' ? 'recurring_event' : 'one_time_event') %></td>
                  <td><%= eventItem.recurrence_pattern || '' %><% if (!eventItem.recurrence_pattern) { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                  <td><%= eventItem.event_date || '' %><% if (!eventItem.event_date) { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                  <td><%= eventItem.event_time || '' %><% if (!eventItem.event_time) { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                  <td><%= eventItem.event_end_time || '' %><% if (!eventItem.event_end_time) { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                  <td><%= eventItem.location || '' %><% if (!eventItem.location) { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                  <td>
                    <form method="post" action="/admin/event-schedules/<%= eventItem.id %>/delete">
                      <button class="btn btn-outline-secondary btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  </div>

  <div class="tab-pane fade" id="eucharistic-adoration-pane" role="tabpanel" aria-labelledby="eucharistic-adoration-tab">

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('adoration_calendar_header') %></h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end mb-4" method="post" action="/admin/eucharistic-adoration/dates">
        <div class="col-md-4">
          <label class="form-label"><%= t('available_date_label') %></label>
          <input class="form-control" type="date" name="adoration_date" required>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('start_time_label') %></label>
          <input class="form-control" type="time" name="start_time" value="08:30" required>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('end_time_label') %></label>
          <input class="form-control" type="time" name="end_time" value="16:00" required>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary" type="submit"><%= t('add_available_date') %></button>
        </div>
      </form>

      <% if (!adorationAvailableDates || adorationAvailableDates.length === 0) { %>
        <p class="mb-0 text-muted"><%= t('no_adoration_dates') %></p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('date_col') %></th>
                <th><%= t('time_window_col') %></th>
                <th><%= t('signups_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% adorationAvailableDates.forEach((dateItem) => { %>
                <% const signupCount = (adorationSignups || []).filter((signup) => {
                  const signupDateValue = signup.adoration_date instanceof Date
                    ? `${signup.adoration_date.getFullYear()}-${String(signup.adoration_date.getMonth() + 1).padStart(2, '0')}-${String(signup.adoration_date.getDate()).padStart(2, '0')}`
                    : `${signup.adoration_date}`.slice(0, 10);
                  return signupDateValue === dateItem.value;
                }).length; %>
                <tr>
                  <td><strong><%= dateItem.label %></strong></td>
                  <td><%= dateItem.timeWindowLabel %></td>
                  <td><%= signupCount %></td>
                  <td>
                    <form method="post" action="/admin/eucharistic-adoration/dates/<%= dateItem.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_adoration_date') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('adoration_signups_header') %></h2></div>
    <div class="card-body p-0">
      <% if (!adorationSignups || adorationSignups.length === 0) { %>
        <div class="p-4 text-muted"><%= t('no_adoration_signups') %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('name') %></th>
                <th><%= t('contact_col') %></th>
                <th><%= t('date_col') %></th>
                <th><%= t('time_slot_col') %></th>
                <th><%= t('notes') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% adorationSignups.forEach((signup) => { %>
                <tr>
                  <td><strong><%= signup.full_name %></strong></td>
                  <td>
                    <div><a href="mailto:<%= signup.email %>"><%= signup.email %></a></div>
                    <div style="font-size:.82rem;color:var(--muted)"><%= signup.phone %></div>
                  </td>
                  <td><%= formatAdorationDateLabel(signup.adoration_date) %></td>
                  <td><%= formatTimeLabel(signup.slot_start_time) %> - <%= formatTimeLabel(signup.slot_end_time) %></td>
                  <td style="max-width:280px"><%= signup.notes || '—' %></td>
                  <td style="font-size:.82rem;color:var(--muted)">
                    <%= signup.created_at ? (typeof signup.created_at === 'string' ? signup.created_at.slice(0, 16).replace('T', ' ') : signup.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %>
                  </td>
                  <td>
                    <form method="post" action="/admin/eucharistic-adoration/<%= signup.id %>/delete" onsubmit="return confirm('<%= t('confirm_remove_adoration_signup') %>');">
                      <button class="btn btn-outline-danger btn-sm" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script>
  (function () {
    const scheduleType = document.querySelector('select[name="schedule_type"]');
    const eventDateField = document.getElementById('event-date-field');
    const weekdayField = document.getElementById('event-weekday-field');
    const eventDateInput = document.querySelector('input[name="event_date"]');
    const weekdaySelect = document.querySelector('select[name="recurrence_pattern"]');

    if (!scheduleType || !eventDateField || !weekdayField || !eventDateInput || !weekdaySelect) return;

    const updateScheduleFields = () => {
      const isRecurring = scheduleType.value === 'recurring';
      eventDateField.classList.toggle('d-none', isRecurring);
      weekdayField.classList.toggle('d-none', !isRecurring);
      eventDateInput.required = !isRecurring;
      weekdaySelect.required = isRecurring;

      if (isRecurring) {
        eventDateInput.value = '';
      } else {
        weekdaySelect.value = '';
      }
    };

    scheduleType.addEventListener('change', updateScheduleFields);
    updateScheduleFields();
  }());
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
