<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('resources_page_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>

<main class="container py-4 app-shell mx-auto">
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('resources_page_title') %></h1>
      <p class="sub mb-0"><%= t('resources_page_subtitle') %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (user.role === 'admin') { %>
        <a class="btn btn-outline-primary" href="/admin/resources"><%= t('manage_resources_nav') %></a>
      <% } %>
      <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!resources.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_resources') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('resource_title_label') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% resources.forEach((resource) => { %>
                <tr>
                  <td>
                    <div style="font-weight:600"><%= resource.title %></div>
                    <% if (resource.description) { %><div style="font-size:.82rem;color:var(--muted)"><%= resource.description %></div><% } %>
                  </td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(resource.created_at) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/resources/<%= resource.id %>/download"><%= t('download_button') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
