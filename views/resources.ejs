<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= isAdmin ? t('admin_resources_title') : t('resources_page_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<% if (isAdmin) { %><%- include('_admin_nav') %><% } %>

<main class="container py-4 app-shell mx-auto">
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= isAdmin ? t('admin_resources_title') : t('resources_page_title') %></h1>
      <p class="sub mb-0"><%= isAdmin ? t('admin_resources_subtitle') : t('resources_page_subtitle') %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (isAdmin) { %>
        <a class="btn btn-outline-secondary" href="/admin/notifications"><%= t('manage_notifications_nav') %></a>
      <% } %>
      <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
    </div>
  </div>

  <% if (isAdmin) { %>
    <div class="page-card mb-4">
      <div class="card-header"><h2 class="h5 mb-0"><%= t('add_resource_button') %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/resources" enctype="multipart/form-data" class="row gy-3 gx-3">
          <div class="col-12 col-md-6">
            <label class="form-label" for="resource-title"><%= t('resource_title_label') %></label>
            <input class="form-control" type="text" id="resource-title" name="title" maxlength="255" required>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" for="resource-file"><%= t('resource_file_label') %></label>
            <input class="form-control" type="file" id="resource-file" name="file" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="resource-description"><%= t('resource_description_label') %></label>
            <textarea class="form-control" id="resource-description" name="description" rows="2" maxlength="2000"></textarea>
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label"><%= t('resource_visible_to_roles_label') %></label>
            <% assignableRoles.forEach((role) => { %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="roles" value="<%= role %>" id="resource-role-<%= role %>">
                <label class="form-check-label" for="resource-role-<%= role %>"><%= roleLabels[role] || role %></label>
              </div>
            <% }) %>
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label" for="resource-class-teachers"><%= t('resource_visible_to_class_teachers_label') %></label>
            <select class="form-select" id="resource-class-teachers" name="class_teacher_ids" multiple size="5">
              <% ccdClasses.forEach((c) => { %>
                <option value="<%= c.id %>"><%= ccdGradeMeanings[c.grade_level] || c.grade_level %><%= c.sectionLabel || '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label" for="resource-class-parents"><%= t('resource_visible_to_class_parents_label') %></label>
            <select class="form-select" id="resource-class-parents" name="class_parent_ids" multiple size="5">
              <% ccdClasses.forEach((c) => { %>
                <option value="<%= c.id %>"><%= ccdGradeMeanings[c.grade_level] || c.grade_level %><%= c.sectionLabel || '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label" for="resource-individuals"><%= t('resource_visible_to_individuals_label') %></label>
            <select class="form-select" id="resource-individuals" name="target_user_ids" multiple size="5">
              <% assignableUsers.forEach((u) => { %>
                <option value="<%= u.id %>" <%= preselectTargetUserId === u.id ? 'selected' : '' %>><%= u.full_name || u.email %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 form-check">
            <input class="form-check-input" type="checkbox" name="notify" value="on" id="resource-notify" checked>
            <label class="form-check-label" for="resource-notify"><%= t('notify_resource_checkbox_label') %></label>
          </div>
          <div class="col-12">
            <button class="btn btn-primary" type="submit"><%= t('add_resource_button') %></button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <% if (resources.length > 5) { %>
    <div class="mb-3">
      <input type="search" class="form-control" id="resource-search" placeholder="<%= t('resource_search_placeholder') %>" aria-label="<%= t('resource_search_placeholder') %>">
    </div>
  <% } %>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!resources.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= isAdmin ? t('no_resources_yet') : t('no_resources') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0" id="resource-table">
            <thead>
              <tr>
                <th><%= t('resource_title_label') %></th>
                <% if (isAdmin) { %><th><%= t('resource_visibility_label') %></th><% } %>
                <th><%= t('submitted_col') %></th>
                <th style="<%= isAdmin ? 'text-align:right' : '' %>"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% resources.forEach((resource) => { %>
                <% const searchText = [resource.title, resource.description, isAdmin ? (resource.assignmentLabels || []).join(' ') : ''].filter(Boolean).join(' ').toLowerCase(); %>
                <tr data-search-text="<%= searchText %>">
                  <td>
                    <div style="font-weight:600"><%= resource.title %></div>
                    <% if (resource.description) { %><div style="font-size:.82rem;color:var(--muted)"><%= resource.description %></div><% } %>
                  </td>
                  <% if (isAdmin) { %>
                    <td style="font-size:.85rem"><%= resource.assignmentLabels.join(', ') || '—' %></td>
                  <% } %>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(resource.created_at) %></td>
                  <td style="<%= isAdmin ? 'text-align:right' : '' %>">
                    <div class="d-inline-flex gap-2">
                      <a class="btn btn-sm btn-outline-primary" href="/resources/<%= resource.id %>/download"><%= t('download_button') %></a>
                      <% if (isAdmin) { %>
                        <form method="post" action="/admin/resources/<%= resource.id %>/notify">
                          <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t('notify_button_label') %></button>
                        </form>
                        <form method="post" action="/admin/resources/<%= resource.id %>/delete" onsubmit="return confirm('<%= t('remove_resource_confirm') %>');">
                          <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="p-4 text-center d-none" id="resource-search-empty" style="color:var(--muted);font-size:.9rem"><em><%= t('no_resources_match_search') %></em></div>
        </div>
      <% } %>
    </div>
  </div>
</main>
<script>
  (function () {
    var searchInput = document.getElementById('resource-search');
    var table = document.getElementById('resource-table');
    if (!searchInput || !table) return;
    var rows = Array.from(table.querySelectorAll('tbody tr'));
    var emptyState = document.getElementById('resource-search-empty');

    searchInput.addEventListener('input', function () {
      var needle = searchInput.value.trim().toLowerCase();
      var visibleCount = 0;
      rows.forEach(function (row) {
        var matches = !needle || row.getAttribute('data-search-text').indexOf(needle) !== -1;
        row.classList.toggle('d-none', !matches);
        if (matches) visibleCount += 1;
      });
      if (emptyState) emptyState.classList.toggle('d-none', visibleCount !== 0);
      table.classList.toggle('d-none', visibleCount === 0);
    });
  }());
</script>
</body>
</html>
