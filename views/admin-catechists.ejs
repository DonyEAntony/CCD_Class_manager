<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('admin_catechists_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('admin_catechists_title') %></h1>
      <p class="sub mb-0"><%= t('admin_catechists_subtitle') %></p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/resources"><%= t('manage_resources_nav') %></a>
      <a class="btn btn-outline-secondary" href="/admin/notifications"><%= t('manage_notifications_nav') %></a>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('staff_broadcast_header') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/catechists/broadcast" class="row gy-3 gx-3" id="staff-broadcast-form">
        <div class="col-12 d-none" id="broadcast-draft-banner">
          <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 mb-0">
            <span id="broadcast-draft-banner-text"></span>
            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-primary" id="broadcast-draft-restore"><%= t('staff_broadcast_draft_restore_button') %></button>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="broadcast-draft-discard"><%= t('staff_broadcast_draft_discard_button') %></button>
            </div>
          </div>
        </div>

        <div class="col-12">
          <label class="form-label"><%= t('staff_broadcast_roles_label') %></label>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="catechist" id="staff-role-catechist" checked>
              <label class="form-check-label" for="staff-role-catechist"><%= t('role_catechist') %></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="admin" id="staff-role-admin">
              <label class="form-check-label" for="staff-role-admin"><%= t('role_admin') %></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="family_faith_leader" id="staff-role-fff">
              <label class="form-check-label" for="staff-role-fff"><%= t('family_faith_leader') %></label>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <label class="form-label" for="broadcast-template"><%= t('staff_broadcast_template_label') %></label>
          <select class="form-select" id="broadcast-template" name="template">
            <option value=""><%= t('staff_broadcast_template_blank_option') %></option>
            <% templates.forEach((tpl) => { %>
              <option value="<%= tpl.id %>"><%= tpl.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-8">
          <label class="form-label"><%= t('catechist_message_subject_label') %></label>
          <input class="form-control" type="text" name="subject" maxlength="255">
        </div>

        <div class="col-12" id="broadcast-plain-fields">
          <label class="form-label"><%= t('catechist_message_body_label') %></label>
          <textarea class="form-control" name="message" rows="2" required></textarea>
        </div>

        <% templates.forEach((tpl) => { %>
          <div class="col-12 broadcast-template-fields" data-template="<%= tpl.id %>" hidden>
            <% if (tpl.fields.length) { %>
              <div class="form-text mb-2"><%= t('staff_broadcast_template_fields_hint') %></div>
              <div class="row gy-2 gx-2">
                <% tpl.fields.forEach((field) => { %>
                  <div class="col-12 col-md-6">
                    <label class="form-label" for="broadcast-field-<%= field.id %>"><%= field.label %></label>
                    <% if (field.label.length > 50) { %>
                      <textarea class="form-control" id="broadcast-field-<%= field.id %>" name="field_<%= field.id %>" rows="2"></textarea>
                    <% } else { %>
                      <input class="form-control" type="text" id="broadcast-field-<%= field.id %>" name="field_<%= field.id %>">
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (tpl.id === 'staff-notice') { %>
              <div class="mt-3">
                <label class="form-label d-block"><%= t('staff_broadcast_paragraphs_label') %></label>
                <div id="staff-notice-paragraphs"></div>
                <template id="staff-notice-paragraph-template">
                  <div class="mb-2 staff-notice-paragraph-row">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <label class="form-label staff-notice-paragraph-label mb-0"></label>
                      <button type="button" class="btn btn-sm btn-outline-danger staff-notice-paragraph-remove" aria-label="<%= t('staff_broadcast_remove_paragraph_button') %>">&times;</button>
                    </div>
                    <div class="btn-group btn-group-sm mb-1 staff-notice-paragraph-toolbar" role="group">
                      <button type="button" class="btn btn-outline-secondary" data-cmd="bold" title="<%= t('staff_broadcast_paragraph_bold_button') %>"><strong>B</strong></button>
                      <button type="button" class="btn btn-outline-secondary fst-italic" data-cmd="italic" title="<%= t('staff_broadcast_paragraph_italic_button') %>">I</button>
                      <button type="button" class="btn btn-outline-secondary text-decoration-underline" data-cmd="underline" title="<%= t('staff_broadcast_paragraph_underline_button') %>">U</button>
                      <button type="button" class="btn btn-outline-secondary" data-cmd="insertUnorderedList" title="<%= t('staff_broadcast_paragraph_list_button') %>">&#8226;&#8212;</button>
                      <button type="button" class="btn btn-outline-secondary" data-cmd="createLink" title="<%= t('staff_broadcast_paragraph_link_button') %>">&#128279;</button>
                    </div>
                    <div class="form-control form-control-sm staff-notice-paragraph-editor" contenteditable="true" style="min-height:64px"></div>
                    <input type="hidden" name="paragraph_text[]" class="staff-notice-paragraph-value">
                  </div>
                </template>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="staff-notice-add-paragraph"><%= t('staff_broadcast_add_paragraph_button') %></button>
              </div>
              <div class="mt-3" style="max-width:280px">
                <label class="form-label" for="staff-notice-read-time"><%= t('staff_broadcast_read_time_label') %></label>
                <input class="form-control" type="text" id="staff-notice-read-time" name="read_time" placeholder="<%= t('staff_broadcast_read_time_placeholder') %>">
              </div>
              <div class="mt-3">
                <label class="form-label d-block"><%= t('staff_broadcast_action_items_label') %></label>
                <div class="form-text mb-2"><%= t('staff_broadcast_action_items_hint') %></div>
                <div id="staff-notice-action-items"></div>
                <template id="staff-notice-action-item-template">
                  <div class="row gy-2 gx-2 align-items-end mb-2 staff-notice-action-item-row">
                    <div class="col-4 col-md-3">
                      <input class="form-control form-control-sm" type="text" name="action_item_date[]" placeholder="<%= t('staff_broadcast_action_item_date_placeholder') %>">
                    </div>
                    <div class="col-6 col-md-7">
                      <input class="form-control form-control-sm" type="text" name="action_item_text[]" placeholder="<%= t('staff_broadcast_action_item_text_placeholder') %>">
                    </div>
                    <div class="col-2 col-md-2">
                      <button type="button" class="btn btn-sm btn-outline-danger w-100 staff-notice-action-item-remove" aria-label="<%= t('staff_broadcast_remove_action_item_button') %>">&times;</button>
                    </div>
                  </div>
                </template>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="staff-notice-add-action-item"><%= t('staff_broadcast_add_action_item_button') %></button>
              </div>
            <% } %>
          </div>
        <% }) %>

        <div class="col-12 d-none" id="broadcast-preview-panel">
          <div class="border rounded-3 p-2" style="background:var(--surface)">
            <div class="fw-semibold mb-2" style="font-size:.85rem"><%= t('staff_broadcast_preview_heading') %></div>
            <iframe id="broadcast-preview-frame" title="<%= t('staff_broadcast_preview_heading') %>" style="width:100%;min-height:420px;border:1px solid var(--border);border-radius:6px;background:#fff"></iframe>
          </div>
        </div>

        <div class="col-12 d-flex justify-content-end gap-2">
          <button class="btn btn-outline-secondary" type="button" hidden id="broadcast-preview-toggle"><%= t('staff_broadcast_preview_button') %></button>
          <button class="btn btn-primary" type="submit"><%= t('staff_broadcast_send_button') %></button>
        </div>
      </form>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!catechists.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_catechists_yet') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('name_col') %></th>
                <th><%= t('catechist_classes_label') %></th>
                <th style="text-align:right"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% catechists.forEach((catechist) => { %>
                <tr>
                  <td>
                    <div style="font-weight:600"><%= catechist.full_name || catechist.email %></div>
                    <div style="font-size:.82rem;color:var(--muted)">
                      <%= catechist.email %><% if (catechist.phone) { %> &middot; <%= catechist.phone %><% } %>
                    </div>
                  </td>
                  <td style="font-size:.85rem">
                    <% if (catechist.classLabels.length) { %>
                      <%= catechist.classLabels.join(', ') %>
                    <% } else { %>
                      <span style="color:var(--muted)"><%= t('no_classes_assigned_label') %></span>
                    <% } %>
                  </td>
                  <td style="text-align:right">
                    <div class="d-inline-flex gap-2">
                      <button class="btn btn-sm btn-outline-secondary catechist-message-toggle" type="button" data-target="catechist-message-<%= catechist.id %>"><%= t('catechist_message_button') %></button>
                      <a class="btn btn-sm btn-outline-secondary" href="/resources?target_user_id=<%= catechist.id %>"><%= t('catechist_assign_resource_button') %></a>
                      <a class="btn btn-sm btn-outline-secondary" href="/admin/notifications?target_user_id=<%= catechist.id %>"><%= t('catechist_send_notification_button') %></a>
                    </div>
                  </td>
                </tr>
                <tr class="d-none" id="catechist-message-<%= catechist.id %>">
                  <td colspan="3">
                    <form method="post" action="/admin/catechists/<%= catechist.id %>/message" class="row gy-2 gx-2 align-items-end py-2">
                      <div class="col-12 col-md-4">
                        <label class="form-label"><%= t('catechist_message_subject_label') %></label>
                        <input class="form-control" type="text" name="subject" maxlength="255">
                      </div>
                      <div class="col-12 col-md-6">
                        <label class="form-label"><%= t('catechist_message_body_label') %></label>
                        <textarea class="form-control" name="message" rows="2" required></textarea>
                      </div>
                      <div class="col-12 col-md-2">
                        <button class="btn btn-primary w-100" type="submit"><%= t('catechist_message_send_button') %></button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
<script>
  (function () {
    document.querySelectorAll('.catechist-message-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var row = document.getElementById(btn.getAttribute('data-target'));
        if (row) row.classList.toggle('d-none');
      });
    });
  }());

  (function () {
    var templateSelect = document.getElementById('broadcast-template');
    if (!templateSelect) return;
    var plainFields = document.getElementById('broadcast-plain-fields');
    var messageInput = plainFields ? plainFields.querySelector('textarea[name="message"]') : null;
    var templateFieldSets = document.querySelectorAll('.broadcast-template-fields');

    function syncBroadcastTemplateFields() {
      var selected = templateSelect.value;
      if (plainFields) plainFields.hidden = !!selected;
      if (messageInput) messageInput.required = !selected;
      templateFieldSets.forEach(function (fieldset) {
        fieldset.hidden = fieldset.getAttribute('data-template') !== selected;
      });
    }

    templateSelect.addEventListener('change', syncBroadcastTemplateFields);
    syncBroadcastTemplateFields();
  }());

  (function () {
    var addBtn = document.getElementById('staff-notice-add-paragraph');
    if (!addBtn) return;
    var container = document.getElementById('staff-notice-paragraphs');
    var rowTemplate = document.getElementById('staff-notice-paragraph-template');
    var labelTemplate = <%- JSON.stringify(t('staff_broadcast_paragraph_label')) %>;
    var linkPrompt = <%- JSON.stringify(t('staff_broadcast_paragraph_link_prompt')) %>;

    function renumberParagraphs() {
      container.querySelectorAll('.staff-notice-paragraph-row').forEach(function (row, index) {
        row.querySelector('.staff-notice-paragraph-label').textContent = labelTemplate.replace('%s', index + 1);
      });
    }

    // Only bold/italic/underline/link/bulleted-list are offered, so the editor never
    // needs to be a full rich-text library — but execCommand still needs the browser's
    // native selection to survive the toolbar button click, which a plain click would
    // lose (the button steals focus before the click fires). Preventing default on
    // mousedown keeps the editor focused and the selection intact.
    function wireToolbar(row, editor, syncValue) {
      row.querySelectorAll('.staff-notice-paragraph-toolbar button').forEach(function (btn) {
        btn.addEventListener('mousedown', function (e) { e.preventDefault(); });
        btn.addEventListener('click', function () {
          var cmd = btn.getAttribute('data-cmd');
          editor.focus();
          if (cmd === 'createLink') {
            var url = window.prompt(linkPrompt, 'https://');
            if (!url) return;
            document.execCommand('createLink', false, url);
          } else {
            document.execCommand(cmd, false, null);
          }
          syncValue();
        });
      });
    }

    function addParagraphRow(initialHtml) {
      var fragment = rowTemplate.content.cloneNode(true);
      var row = fragment.querySelector('.staff-notice-paragraph-row');
      var editor = row.querySelector('.staff-notice-paragraph-editor');
      var hiddenInput = row.querySelector('.staff-notice-paragraph-value');
      if (initialHtml) {
        editor.innerHTML = initialHtml;
        hiddenInput.value = initialHtml;
      }

      function syncValue() { hiddenInput.value = editor.innerHTML; }

      wireToolbar(row, editor, syncValue);
      editor.addEventListener('input', syncValue);

      // Keep line breaks as plain <br> instead of the <div>-per-line markup most
      // browsers insert on Enter inside a contenteditable — simpler output, and the
      // only line-break form the server's paragraph sanitizer allows through.
      editor.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          document.execCommand('insertLineBreak');
          syncValue();
        }
      });

      // Pasted content (e.g. copied from Word or a webpage) is flattened to plain text
      // rather than kept as rich HTML — the toolbar is the only way to apply markup,
      // which keeps the editor's output predictable and small.
      editor.addEventListener('paste', function (e) {
        e.preventDefault();
        var text = (e.clipboardData || window.clipboardData).getData('text/plain');
        document.execCommand('insertText', false, text);
        syncValue();
      });

      row.querySelector('.staff-notice-paragraph-remove').addEventListener('click', function () {
        row.remove();
        renumberParagraphs();
      });
      container.appendChild(fragment);
      renumberParagraphs();
    }

    addBtn.addEventListener('click', function () { addParagraphRow(); });
    addParagraphRow();

    // Belt-and-suspenders: re-sync every editor's hidden input right before submit, in
    // case some edit (e.g. an IME composition) didn't trigger the 'input' listener above.
    var form = document.getElementById('staff-broadcast-form');
    if (form) {
      form.addEventListener('submit', function () {
        container.querySelectorAll('.staff-notice-paragraph-row').forEach(function (row) {
          var editor = row.querySelector('.staff-notice-paragraph-editor');
          var hiddenInput = row.querySelector('.staff-notice-paragraph-value');
          hiddenInput.value = editor.innerHTML;
        });
      });
    }

    // Exposed so the draft-restore code below can rebuild these rows from a saved
    // draft without duplicating the editor-wiring logic above.
    window.__broadcastComposer = window.__broadcastComposer || {};
    window.__broadcastComposer.addParagraphRow = addParagraphRow;
    window.__broadcastComposer.clearParagraphRows = function () { container.innerHTML = ''; };
  }());

  (function () {
    var addBtn = document.getElementById('staff-notice-add-action-item');
    if (!addBtn) return;
    var container = document.getElementById('staff-notice-action-items');
    var rowTemplate = document.getElementById('staff-notice-action-item-template');

    function addActionItemRow(initialDate, initialText) {
      var fragment = rowTemplate.content.cloneNode(true);
      var row = fragment.querySelector('.staff-notice-action-item-row');
      if (initialDate) row.querySelector('input[name="action_item_date[]"]').value = initialDate;
      if (initialText) row.querySelector('input[name="action_item_text[]"]').value = initialText;
      row.querySelector('.staff-notice-action-item-remove').addEventListener('click', function () {
        row.remove();
      });
      container.appendChild(fragment);
    }

    addBtn.addEventListener('click', function () { addActionItemRow(); });
    addActionItemRow();

    // Exposed so the draft-restore code below can rebuild these rows from a saved draft.
    window.__broadcastComposer = window.__broadcastComposer || {};
    window.__broadcastComposer.addActionItemRow = addActionItemRow;
    window.__broadcastComposer.clearActionItemRows = function () { container.innerHTML = ''; };
  }());

  (function () {
    var form = document.getElementById('staff-broadcast-form');
    var templateSelect = document.getElementById('broadcast-template');
    if (!form || !templateSelect) return;

    function debounce(fn, wait) {
      var timer;
      return function () {
        var args = arguments;
        clearTimeout(timer);
        timer = setTimeout(function () { fn.apply(null, args); }, wait);
      };
    }

    // ── Inline live preview (replaces the old "opens a new tab" Preview button) ──
    var previewToggleBtn = document.getElementById('broadcast-preview-toggle');
    var previewPanel = document.getElementById('broadcast-preview-panel');
    var previewFrame = document.getElementById('broadcast-preview-frame');

    function isPreviewOpen() {
      return !!(previewPanel && !previewPanel.classList.contains('d-none'));
    }

    // The preview endpoint only understands templated messages (it 400s with no
    // `template`), so there's nothing useful to show — and no button to show — for the
    // plain "no template" fallback message.
    function syncPreviewAvailability() {
      var hasTemplate = !!templateSelect.value;
      if (previewToggleBtn) previewToggleBtn.hidden = !hasTemplate;
      if (!hasTemplate && previewPanel) previewPanel.classList.add('d-none');
    }

    function refreshPreview() {
      if (!previewFrame || !templateSelect.value || !isPreviewOpen()) return;
      var params = new URLSearchParams(new FormData(form));
      fetch('/admin/catechists/email-preview', { method: 'POST', body: params })
        .then(function (res) { return res.ok ? res.text() : Promise.reject(new Error('preview request failed')); })
        .then(function (html) { previewFrame.srcdoc = html; })
        .catch(function () { /* a transient preview miss isn't worth surfacing to the sender */ });
    }

    if (previewToggleBtn) {
      previewToggleBtn.addEventListener('click', function () {
        if (previewPanel) previewPanel.classList.toggle('d-none');
        if (isPreviewOpen()) refreshPreview();
      });
    }
    templateSelect.addEventListener('change', function () {
      syncPreviewAvailability();
      refreshPreview();
    });
    syncPreviewAvailability();

    var debouncedRefreshPreview = debounce(refreshPreview, 500);
    form.addEventListener('input', debouncedRefreshPreview);
    form.addEventListener('change', debouncedRefreshPreview);

    // ── Draft protection ──────────────────────────────────────────────────────
    // A long staff notice (several paragraphs, action items) is real typing effort;
    // an accidental refresh or back-navigation shouldn't lose it. Snapshotted to
    // localStorage (not the server) since it's purely a per-browser safety net, not
    // a real save — it's cleared the moment the message actually sends.
    var DRAFT_KEY = 'staffBroadcastDraft';
    var draftBanner = document.getElementById('broadcast-draft-banner');
    var draftBannerText = document.getElementById('broadcast-draft-banner-text');
    var draftRestoreBtn = document.getElementById('broadcast-draft-restore');
    var draftDiscardBtn = document.getElementById('broadcast-draft-discard');
    var draftBannerTemplate = <%- JSON.stringify(t('staff_broadcast_draft_banner_text')) %>;
    var pendingDraft = null;

    function buildDraftSnapshot() {
      var roles = Array.from(form.querySelectorAll('input[name="roles"]:checked')).map(function (cb) { return cb.value; });
      var fields = {};
      form.querySelectorAll('[name^="field_"]').forEach(function (el) { fields[el.name] = el.value; });
      var paragraphs = Array.from(document.querySelectorAll('.staff-notice-paragraph-value')).map(function (el) { return el.value; });
      var actionDates = Array.from(document.querySelectorAll('input[name="action_item_date[]"]')).map(function (el) { return el.value; });
      var actionTexts = Array.from(document.querySelectorAll('input[name="action_item_text[]"]')).map(function (el) { return el.value; });
      var actionItems = actionTexts.map(function (text, i) { return { date: actionDates[i] || '', text: text }; });
      var readTimeInput = document.getElementById('staff-notice-read-time');
      var subjectInput = form.querySelector('[name="subject"]');
      var messageInput = form.querySelector('[name="message"]');
      return {
        savedAt: Date.now(),
        roles: roles,
        template: templateSelect.value,
        subject: subjectInput ? subjectInput.value : '',
        message: messageInput ? messageInput.value : '',
        fields: fields,
        readTime: readTimeInput ? readTimeInput.value : '',
        paragraphs: paragraphs,
        actionItems: actionItems,
      };
    }

    function isDraftMeaningful(draft) {
      if (!draft) return false;
      if ((draft.subject || '').trim() || (draft.message || '').trim() || (draft.readTime || '').trim()) return true;
      if (Object.keys(draft.fields || {}).some(function (k) { return (draft.fields[k] || '').trim(); })) return true;
      if ((draft.paragraphs || []).some(function (p) { return (p || '').replace(/<[^>]*>/g, '').trim(); })) return true;
      if ((draft.actionItems || []).some(function (item) { return (item.text || '').trim(); })) return true;
      return false;
    }

    function saveDraft() {
      var snapshot = buildDraftSnapshot();
      try {
        if (isDraftMeaningful(snapshot)) {
          window.localStorage.setItem(DRAFT_KEY, JSON.stringify(snapshot));
        } else {
          window.localStorage.removeItem(DRAFT_KEY);
        }
      } catch (e) { /* private browsing, storage full, etc. — the draft just won't persist */ }
    }

    function restoreDraft(draft) {
      form.querySelectorAll('input[name="roles"]').forEach(function (cb) {
        cb.checked = draft.roles.indexOf(cb.value) !== -1;
      });
      templateSelect.value = draft.template || '';
      templateSelect.dispatchEvent(new Event('change'));

      var subjectInput = form.querySelector('[name="subject"]');
      if (subjectInput) subjectInput.value = draft.subject || '';
      var messageInput = form.querySelector('[name="message"]');
      if (messageInput) messageInput.value = draft.message || '';
      Object.keys(draft.fields || {}).forEach(function (name) {
        var el = form.querySelector('[name="' + name + '"]');
        if (el) el.value = draft.fields[name];
      });
      var readTimeInput = document.getElementById('staff-notice-read-time');
      if (readTimeInput) readTimeInput.value = draft.readTime || '';

      var composer = window.__broadcastComposer || {};
      if (composer.clearParagraphRows && composer.addParagraphRow) {
        composer.clearParagraphRows();
        if (draft.paragraphs && draft.paragraphs.length) {
          draft.paragraphs.forEach(function (html) { composer.addParagraphRow(html); });
        } else {
          composer.addParagraphRow();
        }
      }
      if (composer.clearActionItemRows && composer.addActionItemRow) {
        composer.clearActionItemRows();
        if (draft.actionItems && draft.actionItems.length) {
          draft.actionItems.forEach(function (item) { composer.addActionItemRow(item.date, item.text); });
        } else {
          composer.addActionItemRow();
        }
      }

      syncPreviewAvailability();
      if (isPreviewOpen()) refreshPreview();
    }

    function hideDraftBanner() {
      if (draftBanner) draftBanner.classList.add('d-none');
    }

    function showDraftBanner(draft) {
      pendingDraft = draft;
      if (!draftBanner) return;
      if (draftBannerText) {
        var savedAtLabel = '';
        try { savedAtLabel = new Date(draft.savedAt).toLocaleString(); } catch (e) { /* ignore */ }
        draftBannerText.textContent = draftBannerTemplate.replace('%s', savedAtLabel);
      }
      draftBanner.classList.remove('d-none');
    }

    if (draftRestoreBtn) {
      draftRestoreBtn.addEventListener('click', function () {
        if (pendingDraft) restoreDraft(pendingDraft);
        hideDraftBanner();
      });
    }
    if (draftDiscardBtn) {
      draftDiscardBtn.addEventListener('click', function () {
        try { window.localStorage.removeItem(DRAFT_KEY); } catch (e) { /* ignore */ }
        hideDraftBanner();
      });
    }

    var debouncedSaveDraft = debounce(saveDraft, 800);
    form.addEventListener('input', debouncedSaveDraft);
    form.addEventListener('change', debouncedSaveDraft);
    form.addEventListener('submit', function () {
      try { window.localStorage.removeItem(DRAFT_KEY); } catch (e) { /* ignore */ }
    });

    try {
      var raw = window.localStorage.getItem(DRAFT_KEY);
      if (raw) {
        var saved = JSON.parse(raw);
        if (isDraftMeaningful(saved)) showDraftBanner(saved);
      }
    } catch (e) { /* corrupt/inaccessible storage — just skip the restore prompt */ }
  }());
</script>
</body>
</html>
