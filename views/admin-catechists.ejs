<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('admin_catechists_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('admin_catechists_title') %></h1>
      <p class="sub mb-0"><%= t('admin_catechists_subtitle') %></p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/admin/resources"><%= t('manage_resources_nav') %></a>
      <a class="btn btn-outline-secondary" href="/admin/notifications"><%= t('manage_notifications_nav') %></a>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('staff_broadcast_header') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/catechists/broadcast" class="row gy-3 gx-3">
        <div class="col-12">
          <label class="form-label"><%= t('staff_broadcast_roles_label') %></label>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="catechist" id="staff-role-catechist" checked>
              <label class="form-check-label" for="staff-role-catechist"><%= t('role_catechist') %></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="admin" id="staff-role-admin">
              <label class="form-check-label" for="staff-role-admin"><%= t('role_admin') %></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="family_faith_leader" id="staff-role-fff">
              <label class="form-check-label" for="staff-role-fff"><%= t('family_faith_leader') %></label>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <label class="form-label" for="broadcast-template"><%= t('staff_broadcast_template_label') %></label>
          <select class="form-select" id="broadcast-template" name="template">
            <option value=""><%= t('staff_broadcast_template_blank_option') %></option>
            <% templates.forEach((tpl) => { %>
              <option value="<%= tpl.id %>"><%= tpl.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-8">
          <label class="form-label"><%= t('catechist_message_subject_label') %></label>
          <input class="form-control" type="text" name="subject" maxlength="255">
        </div>

        <div class="col-12" id="broadcast-plain-fields">
          <label class="form-label"><%= t('catechist_message_body_label') %></label>
          <textarea class="form-control" name="message" rows="2" required></textarea>
        </div>

        <% templates.forEach((tpl) => { %>
          <div class="col-12 broadcast-template-fields" data-template="<%= tpl.id %>" hidden>
            <% if (tpl.fields.length) { %>
              <div class="form-text mb-2"><%= t('staff_broadcast_template_fields_hint') %></div>
              <div class="row gy-2 gx-2">
                <% tpl.fields.forEach((field) => { %>
                  <div class="col-12 col-md-6">
                    <label class="form-label" for="broadcast-field-<%= field.id %>"><%= field.label %></label>
                    <% if (field.label.length > 50) { %>
                      <textarea class="form-control" id="broadcast-field-<%= field.id %>" name="field_<%= field.id %>" rows="2"></textarea>
                    <% } else { %>
                      <input class="form-control" type="text" id="broadcast-field-<%= field.id %>" name="field_<%= field.id %>">
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (tpl.id === 'staff-notice') { %>
              <div class="mt-3">
                <label class="form-label d-block"><%= t('staff_broadcast_action_items_label') %></label>
                <div class="form-text mb-2"><%= t('staff_broadcast_action_items_hint') %></div>
                <div id="staff-notice-action-items"></div>
                <template id="staff-notice-action-item-template">
                  <div class="row gy-2 gx-2 align-items-end mb-2 staff-notice-action-item-row">
                    <div class="col-4 col-md-3">
                      <input class="form-control form-control-sm" type="text" name="action_item_date[]" placeholder="<%= t('staff_broadcast_action_item_date_placeholder') %>">
                    </div>
                    <div class="col-6 col-md-7">
                      <input class="form-control form-control-sm" type="text" name="action_item_text[]" placeholder="<%= t('staff_broadcast_action_item_text_placeholder') %>">
                    </div>
                    <div class="col-2 col-md-2">
                      <button type="button" class="btn btn-sm btn-outline-danger w-100 staff-notice-action-item-remove" aria-label="<%= t('staff_broadcast_remove_action_item_button') %>">&times;</button>
                    </div>
                  </div>
                </template>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="staff-notice-add-action-item"><%= t('staff_broadcast_add_action_item_button') %></button>
              </div>
            <% } %>
          </div>
        <% }) %>

        <div class="col-12 d-flex justify-content-end gap-2">
          <button class="btn btn-outline-secondary" type="submit" formaction="/admin/catechists/email-preview" formtarget="_blank" formnovalidate><%= t('staff_broadcast_preview_button') %></button>
          <button class="btn btn-primary" type="submit"><%= t('staff_broadcast_send_button') %></button>
        </div>
      </form>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!catechists.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_catechists_yet') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('name_col') %></th>
                <th><%= t('catechist_classes_label') %></th>
                <th style="text-align:right"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% catechists.forEach((catechist) => { %>
                <tr>
                  <td>
                    <div style="font-weight:600"><%= catechist.full_name || catechist.email %></div>
                    <div style="font-size:.82rem;color:var(--muted)">
                      <%= catechist.email %><% if (catechist.phone) { %> &middot; <%= catechist.phone %><% } %>
                    </div>
                  </td>
                  <td style="font-size:.85rem">
                    <% if (catechist.classLabels.length) { %>
                      <%= catechist.classLabels.join(', ') %>
                    <% } else { %>
                      <span style="color:var(--muted)"><%= t('no_classes_assigned_label') %></span>
                    <% } %>
                  </td>
                  <td style="text-align:right">
                    <div class="d-inline-flex gap-2">
                      <button class="btn btn-sm btn-outline-secondary catechist-message-toggle" type="button" data-target="catechist-message-<%= catechist.id %>"><%= t('catechist_message_button') %></button>
                      <a class="btn btn-sm btn-outline-secondary" href="/admin/resources?target_user_id=<%= catechist.id %>"><%= t('catechist_assign_resource_button') %></a>
                      <a class="btn btn-sm btn-outline-secondary" href="/admin/notifications?target_user_id=<%= catechist.id %>"><%= t('catechist_send_notification_button') %></a>
                    </div>
                  </td>
                </tr>
                <tr class="d-none" id="catechist-message-<%= catechist.id %>">
                  <td colspan="3">
                    <form method="post" action="/admin/catechists/<%= catechist.id %>/message" class="row gy-2 gx-2 align-items-end py-2">
                      <div class="col-12 col-md-4">
                        <label class="form-label"><%= t('catechist_message_subject_label') %></label>
                        <input class="form-control" type="text" name="subject" maxlength="255">
                      </div>
                      <div class="col-12 col-md-6">
                        <label class="form-label"><%= t('catechist_message_body_label') %></label>
                        <textarea class="form-control" name="message" rows="2" required></textarea>
                      </div>
                      <div class="col-12 col-md-2">
                        <button class="btn btn-primary w-100" type="submit"><%= t('catechist_message_send_button') %></button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
<script>
  (function () {
    document.querySelectorAll('.catechist-message-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var row = document.getElementById(btn.getAttribute('data-target'));
        if (row) row.classList.toggle('d-none');
      });
    });
  }());

  (function () {
    var templateSelect = document.getElementById('broadcast-template');
    if (!templateSelect) return;
    var plainFields = document.getElementById('broadcast-plain-fields');
    var messageInput = plainFields ? plainFields.querySelector('textarea[name="message"]') : null;
    var templateFieldSets = document.querySelectorAll('.broadcast-template-fields');

    function syncBroadcastTemplateFields() {
      var selected = templateSelect.value;
      if (plainFields) plainFields.hidden = !!selected;
      if (messageInput) messageInput.required = !selected;
      templateFieldSets.forEach(function (fieldset) {
        fieldset.hidden = fieldset.getAttribute('data-template') !== selected;
      });
    }

    templateSelect.addEventListener('change', syncBroadcastTemplateFields);
    syncBroadcastTemplateFields();
  }());

  (function () {
    var addBtn = document.getElementById('staff-notice-add-action-item');
    if (!addBtn) return;
    var container = document.getElementById('staff-notice-action-items');
    var rowTemplate = document.getElementById('staff-notice-action-item-template');

    function addActionItemRow() {
      var fragment = rowTemplate.content.cloneNode(true);
      var row = fragment.querySelector('.staff-notice-action-item-row');
      row.querySelector('.staff-notice-action-item-remove').addEventListener('click', function () {
        row.remove();
      });
      container.appendChild(fragment);
    }

    addBtn.addEventListener('click', addActionItemRow);
    addActionItemRow();
  }());
</script>
</body>
</html>
