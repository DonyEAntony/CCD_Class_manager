<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('late_sacrament_page_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/page-styles/discipleship-volunteer-signup.css">
  <link rel="stylesheet" href="/page-styles/late-sacrament-interest.css">
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %>
    <div class="alert alert-danger mb-3" role="alert">
      <% if (error.length === 1) { %><%= error[0] %><% } else { %>
        <ul class="mb-0 ps-3"><% error.forEach((message) => { %><li><%= message %></li><% }) %></ul>
      <% } %>
    </div>
  <% } %>
  <% if (fromRegistration && !success.length) { %><div class="alert alert-info mb-3"><%= t('late_sacrament_from_registration') %></div><% } %>

  <section class="volunteer-hero mb-4">
    <p class="eyebrow"><%= t('late_sacrament_eyebrow') %></p>
    <h1><%= t('late_sacrament_hero_title') %></h1>
    <p><%= t('late_sacrament_hero_body') %></p>
  </section>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="page-card">
        <div class="card-header"><h2 class="h5 mb-0"><%= t('late_sacrament_form_header') %></h2></div>
        <div class="card-body">
          <form class="row g-4" method="post" action="/sacrament-interest">

            <fieldset class="col-12">
              <legend><%= t('late_sacrament_section_parent') %></legend>
              <div class="row g-3 mt-0">
                <div class="col-12">
                  <label class="form-label required" for="late-parent-name"><%= t('late_sacrament_label_parent_name') %></label>
                  <input class="form-control" id="late-parent-name" type="text" name="parent_name" value="<%= formData.parent_name || '' %>" maxlength="255" autocomplete="name" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label required" for="late-email"><%= t('email') %></label>
                  <input class="form-control" id="late-email" type="email" name="email" value="<%= formData.email || '' %>" maxlength="255" autocomplete="email" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label required" for="late-phone"><%= t('phone') %></label>
                  <div class="input-group">
                    <span class="input-group-text">1-</span>
                    <input class="form-control" id="late-phone" type="tel" name="phone" value="<%= formData.phone || '' %>" autocomplete="tel-national" pattern="[0-9]{3}[.\- ]?[0-9]{3}[.\- ]?[0-9]{4}" title="123-456-7890, 123.456.7890, 123 456 7890" required>
                  </div>
                </div>
                <div class="col-12">
                  <div class="form-label required mb-1"><%= t('late_sacrament_label_parishioner') %></div>
                  <div class="d-flex flex-wrap gap-3">
                    <% ['yes', 'no'].forEach((slug) => { %>
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="parishioner" value="<%= slug %>" id="late-parishioner-<%= slug %>" <%= formData.parishioner === slug ? 'checked' : '' %> required>
                        <label class="form-check-label" for="late-parishioner-<%= slug %>"><%= t('late_sacrament_parishioner_' + slug) %></label>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset class="col-12">
              <legend><%= t('late_sacrament_section_children') %></legend>
              <div class="volunteer-hint"><%= t('late_sacrament_children_help').replace('%s', lateSacramentOptions.maxChildren) %></div>
              <div data-late-children data-max="<%= lateSacramentOptions.maxChildren %>">
                <% formData.children.forEach((child, index) => { %>
                  <%- include('_late_sacrament_child', { child, index, number: index + 1 }) %>
                <% }) %>
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-late-child-add><%= t('late_sacrament_add_child') %></button>
              <template data-late-child-template>
                <%- include('_late_sacrament_child', { child: {}, index: '__INDEX__', number: null }) %>
              </template>
            </fieldset>

            <fieldset class="col-12">
              <legend><%= t('late_sacrament_section_schedule') %></legend>
              <div class="form-label mb-1"><%= t('late_sacrament_label_availability') %></div>
              <div class="d-flex flex-wrap gap-3">
                <% lateSacramentOptions.availability.forEach((slug) => { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="availability" value="<%= slug %>" id="late-availability-<%= slug %>" <%= [].concat(formData.availability || []).includes(slug) ? 'checked' : '' %>>
                    <label class="form-check-label" for="late-availability-<%= slug %>"><%= t('late_sacrament_availability_' + slug) %></label>
                  </div>
                <% }) %>
              </div>
              <div class="mt-3">
                <label class="form-label" for="late-notes"><%= t('late_sacrament_label_notes') %></label>
                <textarea class="form-control" id="late-notes" name="notes" rows="3" maxlength="2000" placeholder="<%= t('late_sacrament_notes_placeholder') %>"><%= formData.notes || '' %></textarea>
              </div>
            </fieldset>

            <div class="volunteer-hp" aria-hidden="true">
              <label for="late-website">Website</label>
              <input id="late-website" type="text" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
              <button class="btn btn-primary" type="submit"><%= t('late_sacrament_submit') %></button>
              <a class="btn btn-outline-secondary" href="/"><%= t('volunteer_back_home') %></a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="page-card mb-3">
        <div class="card-header"><h2 class="h5 mb-0"><%= t('late_sacrament_next_header') %></h2></div>
        <div class="card-body">
          <p class="mb-0" style="font-size:.92rem"><%= t('late_sacrament_next_body') %></p>
        </div>
      </div>
      <div class="volunteer-note"><%= t('late_sacrament_records_note') %></div>
    </div>
  </div>
</main>
<script>
  (function () {
    var list = document.querySelector('[data-late-children]');
    var addButton = document.querySelector('[data-late-child-add]');
    var template = document.querySelector('[data-late-child-template]');
    var max = Number(list.getAttribute('data-max')) || 6;
    // Indices only need to be unique, not contiguous — the server reads the children in
    // order — so a removed child's number is never reused.
    var nextIndex = list.querySelectorAll('[data-late-child]').length;

    function refresh() {
      var blocks = list.querySelectorAll('[data-late-child]');
      blocks.forEach(function (block, i) {
        block.querySelector('[data-late-child-number]').textContent = i + 1;
        block.querySelector('[data-late-child-remove]').hidden = blocks.length === 1;
      });
      addButton.hidden = blocks.length >= max;
    }

    addButton.addEventListener('click', function () {
      var html = template.innerHTML.replace(/__INDEX__/g, String(nextIndex));
      nextIndex += 1;
      list.insertAdjacentHTML('beforeend', html);
      refresh();
      var added = list.lastElementChild;
      var first = added && added.querySelector('input');
      if (first) first.focus();
    });

    list.addEventListener('click', function (event) {
      var remove = event.target.closest('[data-late-child-remove]');
      if (!remove) return;
      remove.closest('[data-late-child]').remove();
      refresh();
    });

    refresh();
  })();
</script>
</body>
</html>
