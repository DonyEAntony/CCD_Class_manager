<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('calendar') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell mx-auto">

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('monthly_calendar') %></h1>
      <p class="sub mb-0"><%= calendarMonthLabel %></p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/calendar/year"><%= t('year_view_label') %></a>
      <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
    </div>
  </div>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/calendar?month=<%= previousMonthParam %>"><%= t('previous_month') %></a>
    <a class="btn btn-outline-secondary" href="/calendar?month=<%= nextMonthParam %>"><%= t('next_month') %></a>
  </div>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="calendar-legend mb-0">
      <div class="calendar-legend-item"><span class="calendar-legend-swatch calendar-legend-swatch-class"></span><%= t('calendar_class_day_title') %></div>
      <div class="calendar-legend-item"><span class="calendar-legend-swatch"></span><%= t('calendar_events_legend_label') %></div>
      <div class="calendar-legend-item"><span class="calendar-legend-swatch calendar-legend-swatch-liturgical"></span><%= t('calendar_liturgical_legend_label') %></div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <label class="form-label mb-0" for="calendar-class-filter" style="font-size:.85rem"><%= t('calendar_filter_by_class_label') %></label>
      <select class="form-select form-select-sm d-none" id="calendar-class-filter" style="width:auto">
        <option value=""><%= t('calendar_filter_all_classes_option') %></option>
      </select>
    </div>
  </div>
  <div class="calendar-legend calendar-legend-codes">
    <% ccdClassCodeLegend.forEach((entry) => { %>
      <div class="calendar-legend-item"><strong><%= entry.code %></strong> = <%= entry.label %></div>
    <% }) %>
  </div>

  <div class="page-card">
    <div class="card-body">
      <% if (!monthEvents.length) { %>
        <div class="alert alert-secondary mb-0"><%= t('no_events_this_month') %></div>
      <% } else { %>
        <div class="calendar-grid">
          <% weekdayLabels.forEach((weekday) => { %>
            <div class="calendar-weekday"><%= weekday %></div>
          <% }) %>
          <% weeks.forEach((week) => { %>
            <% week.forEach((day) => { %>
              <div class="calendar-cell <%= day.dayNumber ? '' : 'calendar-cell-empty' %>">
                <% if (day.dayNumber) { %>
                  <div class="calendar-day-number"><%= day.dayNumber %></div>
                  <div class="calendar-events">
                    <% day.events.forEach((eventItem) => { %>
                      <% if (eventItem.isLiturgical) { %>
                        <div class="calendar-event-pill calendar-liturgical-day">
                          <strong><%= eventItem.title %></strong>
                          <% if (eventItem.seasonKey) { %>
                            <span class="calendar-liturgical-season-tag calendar-liturgical-season-tag-<%= eventItem.seasonKey %>"><%= t('liturgical_season_' + eventItem.seasonKey) %></span>
                          <% } %>
                        </div>
                      <% } else { %>
                        <div class="calendar-event-pill <%= eventItem.isClassDay ? 'calendar-class-day' : '' %> <%= eventItem.audience === 'sacrament_day' ? 'calendar-event-important' : '' %>" <% if (eventItem.isClassDay) { %>data-class-code="<%= eventItem.title %>"<% } %>>
                          <% if (eventItem.audience === 'sacrament_day') { %>
                            <span class="calendar-important-tag">&#9733; <%= t('important_event_tag') %></span>
                          <% } %>
                          <strong <% if (eventItem.fullTitle) { %>title="<%= eventItem.fullTitle %>"<% } %>><%= eventItem.title %></strong>
                          <% if (eventItem.isClassDay && eventItem.eventType && eventItem.eventType !== 'class_day') { %>
                            <span class="calendar-event-type-tag calendar-event-type-tag-<%= eventItem.eventType %>"><%= t('event_type_' + eventItem.eventType) %></span>
                          <% } %>
                          <span>
                            <% if (eventItem.isClassDay) { %>
                              <% if (eventItem.event_time) { %><%= eventItem.event_time %><% } %>
                              <% if (eventItem.description) { %><%= eventItem.event_time ? ' · ' : '' %><%= eventItem.description %><% } %>
                            <% } else { %>
                              <% if (eventItem.schedule_type === 'recurring' && eventItem.recurrence_pattern) { %><%= eventItem.recurrence_pattern %><% } %>
                              <% if (eventItem.event_time) { %><%= eventItem.schedule_type === 'recurring' && eventItem.recurrence_pattern ? ' · ' : '' %><%= eventItem.event_time %><% } %>
                              <% if (eventItem.event_end_time) { %> - <%= eventItem.event_end_time %><% } %>
                              <% if (eventItem.location) { %> · <%= eventItem.location %><% } %>
                            <% } %>
                          </span>
                        </div>
                      <% } %>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script>
  (function () {
    var select = document.getElementById('calendar-class-filter');
    if (!select) return;
    var pills = Array.from(document.querySelectorAll('.calendar-event-pill.calendar-class-day'));
    if (!pills.length) return;

    // Built from whatever class codes actually appear this month, rather than a fixed
    // server-side list — stays correct as classes/sections change without needing to
    // track every grade's code here.
    var codes = Array.from(new Set(pills.map(function (pill) { return pill.getAttribute('data-class-code'); }).filter(Boolean))).sort();
    codes.forEach(function (code) {
      var opt = document.createElement('option');
      opt.value = code;
      opt.textContent = code;
      select.appendChild(opt);
    });
    select.classList.remove('d-none');

    var STORAGE_KEY = 'calendarClassFilter';
    var applyFilter = function (code) {
      pills.forEach(function (pill) {
        pill.classList.toggle('d-none', !!code && pill.getAttribute('data-class-code') !== code);
      });
    };

    // Persisted client-side (not a URL param) because Previous/Next Month are full page
    // loads to a different URL — without this, picking a class would reset every time a
    // parent flips the month.
    var saved = '';
    try { saved = window.localStorage.getItem(STORAGE_KEY) || ''; } catch (e) { /* private browsing, etc. */ }
    if (saved && codes.indexOf(saved) !== -1) {
      select.value = saved;
      applyFilter(saved);
    }

    select.addEventListener('change', function () {
      applyFilter(select.value);
      try { window.localStorage.setItem(STORAGE_KEY, select.value); } catch (e) { /* private browsing, etc. */ }
    });
  }());
</script>
</body>
</html>
