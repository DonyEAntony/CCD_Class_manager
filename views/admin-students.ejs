<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('all_students_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell-wide mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <% const tabBadgeStyle = "background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"; %>
  <% const availableStudentStatusOptions = Array.isArray(typeof studentStatusOptions === 'undefined' ? null : studentStatusOptions) ? studentStatusOptions : []; %>
  <% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
  <% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
  <% const uploadPathsForView = typeof certificateUploadPaths === 'function' ? certificateUploadPaths : ((value) => value ? [value] : []); %>
  <% const formatDateOnly = (value) => {
       if (!value) return '';
       return typeof value === 'string' ? value.slice(0, 10) : value.toISOString().slice(0, 10);
     }; %>
  <% const formatDateTime = (value) => {
       if (!value) return '';
       return typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ');
     }; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('all_students_header') %></h1>
      <p class="sub mb-0"><%= t('all_students_subtitle') %></p>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-body p-0">
      <% if (!students || students.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_accepted_students') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th style="width:2.2rem"></th>
              <th><%= t('student') %></th>
              <th><%= t('grade') %></th>
              <th><%= t('primary_contact') %></th>
              <th><%= t('student_status') %></th>
              <th><%= t('certificates') %></th>
              <th><%= t('comments_col') %></th>
              <th><%= t('child_verification_col_header') %></th>
              <th><%= t('submitted_col') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% students.forEach(r => { %>
            <tr>
              <td>
                <button type="button" class="btn btn-sm btn-outline-secondary student-details-toggle" data-target="student-detail-<%= r.id %>" aria-label="<%= t('student_details_toggle') %>">&#9656;</button>
              </td>
              <td style="font-weight:600"><%= r.student_full_name %></td>
              <td><%= r.grade_level || '—' %></td>
              <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
              <td>
                <form method="post" action="/admin/students/<%= r.id %>/status" class="d-flex align-items-center gap-2">
                  <select class="form-select form-select-sm" name="status" style="max-width:180px" onchange="this.form.submit()">
                    <% availableStudentStatusOptions.forEach((statusOption) => { %>
                      <option value="<%= statusOption %>" <%= r.student_status === statusOption ? 'selected' : '' %>><%= t(statusOption) %></option>
                    <% }) %>
                  </select>
                  <noscript><button type="submit" class="btn btn-sm btn-outline-primary"><%= t('save') %></button></noscript>
                </form>
              </td>
              <td style="font-size:.85rem">
                <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                <%
                  const certFiles = [];
                  baptismPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('baptism'), sub: t('baptism'), href: uploadHrefForView(filePath) }));
                  communionPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('communion'), sub: t('communion'), href: uploadHrefForView(filePath) }));
                %>
                <% if (certFiles.length) { %>
                  <button type="button" class="btn btn-sm btn-outline-secondary cert-files-btn" data-files="<%= JSON.stringify(certFiles) %>" data-name="<%= r.student_full_name || '' %>">
                    &#128206; <%= t('view_files_count').replace('%s', certFiles.length) %>
                  </button>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td style="font-size:.82rem;max-width:220px">
                <% if (r.disabilities_comments) { %>
                  <span title="<%= r.disabilities_comments %>"><%= r.disabilities_comments %></span>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td style="font-size:.78rem;min-width:180px">
                <% if (r.registration_id) { %>
                  <% ['certificates_verified', 'tuition_paid', 'parent_contacted'].forEach((field) => { %>
                    <div class="form-check verification-check-row" style="margin-bottom:2px">
                      <input
                        type="checkbox"
                        class="form-check-input verification-checkbox"
                        data-registration-id="<%= r.registration_id %>"
                        data-field="<%= field %>"
                        id="verify-<%= field %>-<%= r.registration_id %>"
                        <%= r[field] ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="verify-<%= field %>-<%= r.registration_id %>"><%= t(field + '_label') %></label>
                      <div class="verification-meta" style="color:var(--muted)">
                        <% if (r[field] && r[field + '_by'] && verifierLookup && verifierLookup[r[field + '_by']]) { %>
                          <%= t('verified_by_on').replace('%s', verifierLookup[r[field + '_by']]).replace('%s', (typeof r[field + '_at'] === 'string' ? r[field + '_at'].slice(0, 16).replace('T', ' ') : (r[field + '_at'] ? r[field + '_at'].toISOString().slice(0, 16).replace('T', ' ') : ''))) %>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <%
                    // No active registration left to toggle these against (e.g. it was
                    // deleted or archived) — show the student's own last-known status
                    // read-only rather than discarding that history.
                    const readOnlyFlags = ['certificates_verified', 'tuition_paid', 'parent_contacted'].filter((field) => r[field]);
                  %>
                  <% if (readOnlyFlags.length) { %>
                    <% readOnlyFlags.forEach((field) => { %>
                      <div style="margin-bottom:2px">&#10003; <%= t(field + '_label') %></div>
                    <% }) %>
                  <% } else { %>
                    <span style="color:var(--muted)"><%= t('no_active_registration') %></span>
                  <% } %>
                <% } %>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
              <td>
                <% if (r.registration_id) { %>
                  <a href="/registration/children/edit/<%= r.registration_id %>" class="btn btn-sm btn-outline-primary"><%= t('edit_registration') %></a>
                <% } %>
              </td>
            </tr>
            <tr class="d-none" id="student-detail-<%= r.id %>">
              <td colspan="10" style="background:var(--surface)">
                <div class="row g-4 p-2">
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('registered_years_label') %></div>
                    <% const registrationHistoryRows = Array.isArray(r.registrationHistory) ? r.registrationHistory : []; %>
                    <% if (!registrationHistoryRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_registered_years') %></div>
                    <% } else { %>
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th><%= t('school_year_col') %></th>
                            <th><%= t('grade') %></th>
                            <th><%= t('status') %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% registrationHistoryRows.forEach((reg) => { %>
                            <tr>
                              <td><%= reg.school_year %></td>
                              <td><%= reg.resolvedGrade || '—' %></td>
                              <td><span class="badge" style="<%= tabBadgeStyle %>"><%= t(reg.status) %></span></td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    <% } %>
                  </div>
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('classes_attended_label') %></div>
                    <% const classHistoryRows = Array.isArray(r.classHistory) ? r.classHistory : []; %>
                    <% if (!classHistoryRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_classes_attended') %></div>
                    <% } else { %>
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th><%= t('school_year_col') %></th>
                            <th><%= t('grade') %></th>
                            <th><%= t('status') %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% classHistoryRows.forEach((cls) => { %>
                            <tr>
                              <td><%= cls.school_year %></td>
                              <td><%= cls.grade_level || '—' %></td>
                              <td>
                                <% if (cls.inProgress) { %>
                                  <span class="badge" style="<%= tabBadgeStyle %>"><%= t('in_progress_label') %></span>
                                <% } else { %>
                                  <span style="font-size:.8rem;color:var(--muted)"><%= formatDateOnly(cls.completed_at) %></span>
                                <% } %>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    <% } %>
                  </div>
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('sacraments_label') %></div>
                    <div style="font-size:.85rem;margin-bottom:.5rem">
                      <strong><%= t('baptism') %>:</strong>
                      <% if (r.sacraments && r.sacraments.baptism) { %>
                        <%= formatDateOnly(r.sacraments.baptism.date) %><% if (r.sacraments.baptism.church) { %> &mdash; <%= r.sacraments.baptism.church %><% } %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('baptism_not_recorded') %></span>
                      <% } %>
                    </div>
                    <div style="font-size:.85rem;margin-bottom:.5rem">
                      <strong><%= t('communion') %>:</strong>
                      <% if (r.sacraments && r.sacraments.firstCommunion) { %>
                        <%= formatDateOnly(r.sacraments.firstCommunion.date) %><% if (r.sacraments.firstCommunion.church) { %> &mdash; <%= r.sacraments.firstCommunion.church %><% } %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('first_communion_not_recorded') %></span>
                      <% } %>
                    </div>
                    <div style="font-size:.85rem">
                      <strong><%= t('confirmation') %>:</strong>
                      <% if (r.sacraments && r.sacraments.confirmationDate) { %>
                        <%= t('confirmation_received_on').replace('%s', formatDateOnly(r.sacraments.confirmationDate)) %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('confirmation_not_recorded') %></span>
                      <% } %>
                      <form method="post" action="/admin/students/<%= r.id %>/confirmation" class="d-flex align-items-center gap-2 mt-2">
                        <input type="date" class="form-control form-control-sm" style="max-width:170px" name="confirmation_received_date" value="<%= formatDateOnly(r.sacraments && r.sacraments.confirmationDate) %>">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><%= t('save') %></button>
                        <% if (r.sacraments && r.sacraments.confirmationDate) { %>
                          <button type="submit" name="clear_confirmation" value="1" class="btn btn-sm btn-outline-secondary"><%= t('clear_confirmation_date_label') %></button>
                        <% } %>
                      </form>
                    </div>
                  </div>
                </div>
                <div class="row g-4 p-2 pt-0">
                  <div class="col-12">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('family_payments_label') %></div>
                    <% const familyPaymentsRows = Array.isArray(r.familyPayments) ? r.familyPayments : []; %>
                    <% if (!familyPaymentsRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_family_payments') %></div>
                    <% } else { %>
                      <div class="table-responsive">
                        <table class="table table-sm mb-2">
                          <thead>
                            <tr>
                              <th><%= t('student') %></th>
                              <th><%= t('payment_amount_col') %></th>
                              <th><%= t('payment_method_col') %></th>
                              <th><%= t('payment_date_col') %></th>
                              <th></th>
                            </tr>
                          </thead>
                          <tbody>
                            <% familyPaymentsRows.forEach((payment) => { %>
                              <tr<% if (payment.isSelf) { %> style="font-weight:600"<% } %>>
                                <td><%= payment.studentFullName %></td>
                                <td><% if (payment.tuitionPaid && payment.amount != null) { %>$<%= payment.amount %><% } else { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                                <td>
                                  <% if (payment.method) { %>
                                    <%= t('payment_method_' + payment.method) %>
                                  <% } else { %>
                                    <span style="color:var(--muted)">&mdash;</span>
                                  <% } %>
                                </td>
                                <td style="color:var(--muted)"><%= payment.paidAt ? formatDateOnly(payment.paidAt) : '—' %></td>
                                <td>
                                  <% if (payment.tuitionPaid && (payment.method === 'cash' || payment.method === 'credit_card')) { %>
                                    <a href="/admin/students/<%= payment.id %>/receipt" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><%= t('view_receipt_label') %></a>
                                  <% } %>
                                </td>
                              </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    <% } %>
                    <form method="post" action="/admin/students/<%= r.id %>/payment" class="d-flex flex-wrap align-items-end gap-2">
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_amount_col') %></label>
                        <input type="number" min="0" step="1" class="form-control form-control-sm" style="max-width:130px" name="amount" placeholder="<%= t('payment_amount_placeholder') %>" required>
                      </div>
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_method_col') %></label>
                        <select class="form-select form-select-sm" style="max-width:150px" name="method" required>
                          <option value="" disabled selected><%= t('select_payment_method') %></option>
                          <option value="cash"><%= t('payment_method_cash') %></option>
                          <option value="credit_card"><%= t('payment_method_credit_card') %></option>
                        </select>
                      </div>
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_date_col') %></label>
                        <input type="date" class="form-control form-control-sm" style="max-width:150px" name="payment_date" value="<%= new Date().toISOString().slice(0, 10) %>">
                      </div>
                      <button type="submit" class="btn btn-sm btn-outline-primary"><%= t('record_payment_label') %></button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>

<div class="modal fade" id="certFilesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="certFilesModalTitle"><%= t('certificate_files') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled mb-0" id="certFilesModalList"></ul>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    document.querySelectorAll('.student-details-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.getElementById(btn.getAttribute('data-target'));
        if (!target) return;
        var nowHidden = target.classList.toggle('d-none');
        btn.innerHTML = nowHidden ? '&#9656;' : '&#9662;';
      });
    });
  }());
</script>
<script>
  (function () {
    var verifiedByOnTemplate = <%- JSON.stringify(t('verified_by_on')) %>;
    document.querySelectorAll('.verification-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        var registrationId = checkbox.dataset.registrationId;
        var field = checkbox.dataset.field;
        var checked = checkbox.checked;
        checkbox.disabled = true;
        fetch('/admin/registrations/children/' + registrationId + '/verification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ field: field, checked: checked }),
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            checkbox.disabled = false;
            if (!data.ok) {
              checkbox.checked = !checked;
              return;
            }
            var metaEl = checkbox.closest('.verification-check-row').querySelector('.verification-meta');
            if (data.checked && data.verifierName && data.at) {
              metaEl.textContent = verifiedByOnTemplate.replace('%s', data.verifierName).replace('%s', String(data.at).slice(0, 16).replace('T', ' '));
            } else {
              metaEl.textContent = '';
            }
          })
          .catch(function () {
            checkbox.disabled = false;
            checkbox.checked = !checked;
          });
      });
    });
  }());
</script>
<script>
  (function () {
    var modalEl = document.getElementById('certFilesModal');
    var modalTitleEl = document.getElementById('certFilesModalTitle');
    var modalListEl = document.getElementById('certFilesModalList');
    var certFilesModalTitleTemplate = <%- JSON.stringify(t('certificate_files')) %>;
    if (!modalEl) return;
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    document.querySelectorAll('.cert-files-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var files = [];
        try {
          files = JSON.parse(btn.dataset.files || '[]');
        } catch (e) {
          files = [];
        }
        modalTitleEl.textContent = btn.dataset.name ? (btn.dataset.name + ' — ' + certFilesModalTitleTemplate) : certFilesModalTitleTemplate;
        modalListEl.innerHTML = '';
        files.forEach(function (file) {
          var li = document.createElement('li');
          li.className = 'mb-2';
          var link = document.createElement('a');
          link.href = file.href;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = file.label;
          li.appendChild(link);
          if (file.sub) {
            var sub = document.createElement('span');
            sub.style.color = 'var(--muted)';
            sub.style.fontSize = '.8rem';
            sub.textContent = ' (' + file.sub + ')';
            li.appendChild(sub);
          }
          modalListEl.appendChild(li);
        });
        modal.show();
      });
    });
  }());
</script>
</body>
</html>
