<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('all_students_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell-wide mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <% const tabBadgeStyle = "background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"; %>
  <% const availableStudentStatusOptions = Array.isArray(typeof studentStatusOptions === 'undefined' ? null : studentStatusOptions) ? studentStatusOptions : []; %>
  <% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
  <% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
  <% const uploadPathsForView = typeof certificateUploadPaths === 'function' ? certificateUploadPaths : ((value) => value ? [value] : []); %>
  <% const formatDateOnly = (value) => {
       if (!value) return '';
       return typeof value === 'string' ? value.slice(0, 10) : value.toISOString().slice(0, 10);
     }; %>
  <% const formatDateTime = (value) => {
       if (!value) return '';
       return typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ');
     }; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('all_students_header') %></h1>
      <p class="sub mb-0"><%= t('all_students_subtitle') %></p>
    </div>
  </div>

  <% const activeStatusFilter = typeof statusFilter !== 'undefined' ? statusFilter : 'all'; %>
  <% const availableStatusOptions = (typeof statusOptionsForStudents !== 'undefined' && statusOptionsForStudents) ? statusOptionsForStudents : ['all']; %>
  <% const activeStudentStatusCounts = (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts : {}; %>
  <% const activeGradeFilter = typeof gradeFilter !== 'undefined' ? gradeFilter : ''; %>
  <% const activeParentFilter = typeof parentFilter !== 'undefined' ? parentFilter : ''; %>
  <% const availableCcdGradeMeanings = (typeof ccdGradeMeanings !== 'undefined' && ccdGradeMeanings) ? ccdGradeMeanings : {}; %>
  <% const activeSortBy = typeof sortBy !== 'undefined' ? sortBy : ''; %>
  <% const activeSortDir = typeof sortDir !== 'undefined' ? sortDir : 'desc'; %>
  <% const activeTotalCount = typeof totalCount !== 'undefined' ? totalCount : 0; %>
  <% const activeFilteredCount = typeof filteredCount !== 'undefined' ? filteredCount : 0; %>
  <% const studentsFiltersActive = activeStatusFilter !== 'all' || activeGradeFilter || activeParentFilter; %>
  <% const statusOptionLabel = (opt) => opt === 'all' ? t('all_statuses') : t(opt); %>
  <% const studentsChipQuery = (overrides) => {
       const params = new URLSearchParams();
       const status = overrides.status !== undefined ? overrides.status : activeStatusFilter;
       if (status && status !== 'all') params.set('status', status);
       const grade = overrides.grade !== undefined ? overrides.grade : activeGradeFilter;
       if (grade) params.set('grade', grade);
       const parent = overrides.parent !== undefined ? overrides.parent : activeParentFilter;
       if (parent) params.set('parent', parent);
       return '/admin/students?' + params.toString();
     }; %>
  <% const studentsSortLink = (column) => {
       const params = new URLSearchParams(studentsChipQuery({}).split('?')[1] || '');
       const nextDir = (activeSortBy === column && activeSortDir === 'asc') ? 'desc' : 'asc';
       params.set('sort', column);
       params.set('dir', nextDir);
       return '/admin/students?' + params.toString();
     }; %>
  <% const studentsSortIndicator = (column) => activeSortBy === column ? (activeSortDir === 'asc' ? ' ▲' : ' ▼') : ''; %>

  <style>
    .rf-shell{display:flex;align-items:stretch;background:#fffdf8;border:1px solid rgba(32,30,29,.08);border-radius:20px;box-shadow:0 1px 3px rgba(32,30,29,.06);overflow:hidden;margin-bottom:1.5rem}
    .rf-sidebar{width:280px;flex:none;background:#ebddc5;border-radius:0 20px 20px 0;padding:1.6rem 1.4rem;display:flex;flex-direction:column;transition:width .18s ease,padding .18s ease}
    .rf-sidebar-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:2px}
    .rf-sidebar-head h4{margin:0;font-size:1.1rem;color:#201e1d}
    .rf-collapse-btn{width:26px;height:26px;flex:none;border-radius:50%;border:1px solid rgba(32,30,29,.2);background:transparent;color:#201e1d;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;line-height:1;padding:0}
    .rf-collapse-btn:hover{border-color:#c67139;color:#8c491a}
    .rf-sidebar-rail{display:none;flex-direction:column;align-items:center;gap:.7rem;margin-top:.6rem}
    .rf-rail-label{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(32,30,29,.6);font-weight:600}
    .rf-rail-badge{background:#c67139;color:#f5ead8;border-radius:999px;font-size:.68rem;font-weight:700;min-width:18px;height:18px;display:flex;align-items:center;justify-content:center;padding:0 4px}
    .rf-sidebar.rf-collapsed{width:60px;padding:1.4rem .6rem}
    .rf-sidebar.rf-collapsed .rf-sidebar-head{justify-content:center}
    .rf-sidebar.rf-collapsed .rf-sidebar-head h4{display:none}
    .rf-sidebar.rf-collapsed .rf-sidebar-body{display:none}
    .rf-sidebar.rf-collapsed .rf-sidebar-rail{display:flex}
    .rf-sidebar-sub{font-size:.78rem;color:rgba(32,30,29,.55);margin-bottom:1.2rem}
    .rf-lbl{font:600 .68rem/1 inherit;letter-spacing:.09em;text-transform:uppercase;color:rgba(32,30,29,.6);display:block;margin-bottom:.45rem}
    .rf-facet-list{display:flex;flex-direction:column;gap:2px;margin-bottom:1.2rem}
    .rf-facet{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.45rem .75rem;border-radius:999px;font-size:.85rem;cursor:pointer;color:#201e1d}
    .rf-facet:hover{background:rgba(32,30,29,.06)}
    .rf-facet.on{background:#e1eecc;color:#3d472b}
    .rf-facet .rf-n{font-size:.7rem;opacity:.55}
    .rf-facet input{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
    .rf-input{width:100%;min-height:36px;padding:.4rem .75rem;font-size:.85rem;color:#201e1d;background:#fffdf8;border:1px solid rgba(32,30,29,.18);border-radius:999px;margin-bottom:1.2rem}
    .rf-sidebar-actions{margin-top:auto;padding-top:1.2rem;display:flex;flex-direction:column;gap:.5rem}
    .rf-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;text-decoration:none;font-size:.85rem;font-weight:600;border-radius:999px;border:1px solid transparent;padding:.55rem 1rem}
    .rf-btn-primary{background:#c67139;color:#f5ead8}
    .rf-btn-primary:hover{background:#b2622d;color:#f5ead8}
    .rf-btn-ghost{color:#8c491a;background:transparent}
    .rf-btn-ghost:hover{background:rgba(198,113,57,.12)}
    .rf-main{flex:1;padding:0;min-width:0}
    .rf-main-header{display:flex;align-items:baseline;gap:.7rem;padding:1.6rem 1.6rem 0}
    .rf-main-header h3{margin:0}
    .rf-result-count{font-size:.78rem;color:rgba(32,30,29,.5)}
    .rf-sort-link{color:inherit;text-decoration:none;white-space:nowrap}
    .rf-sort-link:hover{text-decoration:underline}
    @media (max-width:900px){.rf-shell{flex-direction:column}.rf-sidebar{width:auto;border-radius:20px 20px 0 0}.rf-sidebar.rf-collapsed{width:auto}}
  </style>

  <div class="rf-shell">
    <aside class="rf-sidebar" id="students-rf-sidebar">
      <div class="rf-sidebar-head">
        <h4><%= t('filters_panel_title') %></h4>
        <button type="button" class="rf-collapse-btn" id="students-rf-collapse-toggle" aria-expanded="true" aria-controls="students-filter-form" title="<%= t('collapse_filters') %>">&#8249;</button>
      </div>
      <div class="rf-sidebar-rail">
        <button type="button" class="rf-collapse-btn" id="students-rf-expand-toggle" aria-label="<%= t('expand_filters') %>" title="<%= t('expand_filters') %>">&#8250;</button>
        <span class="rf-rail-label"><%= t('filters_panel_title') %></span>
        <% if (studentsFiltersActive) { %><span class="rf-rail-badge"><%= (activeStatusFilter !== 'all' ? 1 : 0) + (activeGradeFilter ? 1 : 0) + (activeParentFilter ? 1 : 0) %></span><% } %>
      </div>
      <form method="get" action="/admin/students" id="students-filter-form" class="rf-sidebar-body">
        <div class="rf-sidebar-sub"><%= t('students_filter_summary').replace('%s', activeFilteredCount).replace('%s', activeTotalCount) %></div>

        <span class="rf-lbl"><%= t('filter_by_status') %></span>
        <div class="rf-facet-list">
          <% availableStatusOptions.forEach((opt) => { %>
            <label class="rf-facet <%= activeStatusFilter === opt ? 'on' : '' %>">
              <input type="radio" name="status" value="<%= opt %>" <%= activeStatusFilter === opt ? 'checked' : '' %> onchange="this.form.submit()">
              <span><%= statusOptionLabel(opt) %></span>
              <span class="rf-n"><%= activeStudentStatusCounts[opt] ?? 0 %></span>
            </label>
          <% }) %>
        </div>

        <span class="rf-lbl"><%= t('filter_by_grade') %></span>
        <select class="rf-input" name="grade" onchange="this.form.submit()">
          <option value="" <%= !activeGradeFilter ? 'selected' : '' %>><%= t('all_grades') %></option>
          <% Object.keys(availableCcdGradeMeanings).forEach((g) => { %>
            <option value="<%= g %>" <%= activeGradeFilter === g ? 'selected' : '' %>><%= g %> &mdash; <%= availableCcdGradeMeanings[g] %></option>
          <% }) %>
        </select>

        <span class="rf-lbl"><%= t('filter_by_parent') %></span>
        <input type="text" class="rf-input" name="parent" placeholder="<%= t('parent_filter_placeholder') %>" value="<%= activeParentFilter %>">

        <div class="rf-sidebar-actions">
          <button type="submit" class="rf-btn rf-btn-primary"><%= t('apply_filters') %></button>
          <% if (studentsFiltersActive) { %>
            <a href="/admin/students" class="rf-btn rf-btn-ghost"><%= t('clear_filters') %></a>
          <% } %>
        </div>
      </form>
    </aside>
    <div class="rf-main">
      <div class="rf-main-header">
        <h3><%= t('all_students_header') %></h3>
        <span class="rf-result-count"><%= t('results_count_label').replace('%s', activeFilteredCount) %></span>
      </div>
      <% if (!students || students.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= studentsFiltersActive ? t('no_students_match_filters') : t('no_accepted_students') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th style="width:2.2rem"></th>
              <th><%= t('student') %></th>
              <th><a class="rf-sort-link" href="<%= studentsSortLink('grade') %>"><%= t('grade') %><%= studentsSortIndicator('grade') %></a></th>
              <th><%= t('primary_contact') %></th>
              <th><%= t('student_status') %></th>
              <th><%= t('certificates') %></th>
              <th><%= t('comments_col') %></th>
              <th><%= t('child_verification_col_header') %></th>
              <th><a class="rf-sort-link" href="<%= studentsSortLink('submitted') %>"><%= t('submitted_col') %><%= studentsSortIndicator('submitted') %></a></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% students.forEach(r => { %>
            <tr>
              <td>
                <button type="button" class="btn btn-sm btn-outline-secondary student-details-toggle" data-target="student-detail-<%= r.id %>" aria-label="<%= t('student_details_toggle') %>">&#9656;</button>
              </td>
              <td style="font-weight:600"><%= r.student_full_name %></td>
              <td><%= r.grade_level || '—' %></td>
              <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
              <td>
                <form method="post" action="/admin/students/<%= r.id %>/status" class="d-flex align-items-center gap-2">
                  <select class="form-select form-select-sm" name="status" style="max-width:180px" onchange="this.form.submit()">
                    <% availableStudentStatusOptions.forEach((statusOption) => { %>
                      <option value="<%= statusOption %>" <%= r.student_status === statusOption ? 'selected' : '' %>><%= t(statusOption) %></option>
                    <% }) %>
                  </select>
                  <noscript><button type="submit" class="btn btn-sm btn-outline-primary"><%= t('save') %></button></noscript>
                </form>
              </td>
              <td style="font-size:.85rem">
                <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                <%
                  const certFiles = [];
                  baptismPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('baptism'), sub: t('baptism'), href: uploadHrefForView(filePath) }));
                  communionPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('communion'), sub: t('communion'), href: uploadHrefForView(filePath) }));
                %>
                <% if (certFiles.length) { %>
                  <button type="button" class="btn btn-sm btn-outline-secondary cert-files-btn" data-files="<%= JSON.stringify(certFiles) %>" data-name="<%= r.student_full_name || '' %>">
                    &#128206; <%= t('view_files_count').replace('%s', certFiles.length) %>
                  </button>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td style="font-size:.82rem;max-width:220px">
                <% if (r.disabilities_comments) { %>
                  <span title="<%= r.disabilities_comments %>"><%= r.disabilities_comments %></span>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td style="font-size:.78rem;min-width:180px">
                <% if (r.registration_id) { %>
                  <% ['certificates_verified', 'tuition_paid', 'parent_contacted'].forEach((field) => { %>
                    <div class="form-check verification-check-row" style="margin-bottom:2px">
                      <input
                        type="checkbox"
                        class="form-check-input verification-checkbox"
                        data-registration-id="<%= r.registration_id %>"
                        data-field="<%= field %>"
                        id="verify-<%= field %>-<%= r.registration_id %>"
                        <%= r[field] ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="verify-<%= field %>-<%= r.registration_id %>"><%= t(field + '_label') %></label>
                      <div class="verification-meta" style="color:var(--muted)">
                        <% if (r[field] && r[field + '_by'] && verifierLookup && verifierLookup[r[field + '_by']]) { %>
                          <%= t('verified_by_on').replace('%s', verifierLookup[r[field + '_by']]).replace('%s', (typeof r[field + '_at'] === 'string' ? r[field + '_at'].slice(0, 16).replace('T', ' ') : (r[field + '_at'] ? r[field + '_at'].toISOString().slice(0, 16).replace('T', ' ') : ''))) %>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <%
                    // No active registration left to toggle these against (e.g. it was
                    // deleted or archived) — show the student's own last-known status
                    // read-only rather than discarding that history.
                    const readOnlyFlags = ['certificates_verified', 'tuition_paid', 'parent_contacted'].filter((field) => r[field]);
                  %>
                  <% if (readOnlyFlags.length) { %>
                    <% readOnlyFlags.forEach((field) => { %>
                      <div style="margin-bottom:2px">&#10003; <%= t(field + '_label') %></div>
                    <% }) %>
                  <% } else { %>
                    <span style="color:var(--muted)"><%= t('no_active_registration') %></span>
                  <% } %>
                <% } %>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
              <td class="text-end">
                <div class="dropdown">
                  <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false" aria-label="<%= t('more_actions') %>">&#8942;</button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <% if (r.registration_id) { %>
                      <li><a class="dropdown-item" href="/registration/children/edit/<%= r.registration_id %>"><%= t('edit_registration') %></a></li>
                    <% } %>
                    <li>
                      <form method="post" action="/admin/students/<%= r.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm_delete_student_prefix')) %> + ' ' + <%= JSON.stringify(r.student_full_name || 'this student') %> + '. ' + <%= JSON.stringify(t('confirm_delete_student_suffix')) %>);">
                        <button class="dropdown-item text-danger" type="submit"><%= t('remove') %></button>
                      </form>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>
            <tr class="d-none" id="student-detail-<%= r.id %>">
              <td colspan="10" style="background:var(--surface)">
                <div class="row g-4 p-2">
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('registered_years_label') %></div>
                    <% const registrationHistoryRows = Array.isArray(r.registrationHistory) ? r.registrationHistory : []; %>
                    <% if (!registrationHistoryRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_registered_years') %></div>
                    <% } else { %>
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th><%= t('school_year_col') %></th>
                            <th><%= t('grade') %></th>
                            <th><%= t('status') %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% registrationHistoryRows.forEach((reg) => { %>
                            <tr>
                              <td><%= reg.school_year %></td>
                              <td><%= reg.resolvedGrade || '—' %></td>
                              <td><span class="badge" style="<%= tabBadgeStyle %>"><%= t(reg.status) %></span></td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    <% } %>
                  </div>
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('classes_attended_label') %></div>
                    <% const classHistoryRows = Array.isArray(r.classHistory) ? r.classHistory : []; %>
                    <% if (!classHistoryRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_classes_attended') %></div>
                    <% } else { %>
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th><%= t('school_year_col') %></th>
                            <th><%= t('grade') %></th>
                            <th><%= t('status') %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% classHistoryRows.forEach((cls) => { %>
                            <tr>
                              <td><%= cls.school_year %></td>
                              <td><%= cls.grade_level || '—' %></td>
                              <td>
                                <% if (cls.inProgress) { %>
                                  <span class="badge" style="<%= tabBadgeStyle %>"><%= t('in_progress_label') %></span>
                                <% } else { %>
                                  <span style="font-size:.8rem;color:var(--muted)"><%= formatDateOnly(cls.completed_at) %></span>
                                <% } %>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    <% } %>
                  </div>
                  <div class="col-md-4">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('sacraments_label') %></div>
                    <div style="font-size:.85rem;margin-bottom:.5rem">
                      <strong><%= t('baptism') %>:</strong>
                      <% if (r.sacraments && r.sacraments.baptism) { %>
                        <%= formatDateOnly(r.sacraments.baptism.date) %><% if (r.sacraments.baptism.church) { %> &mdash; <%= r.sacraments.baptism.church %><% } %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('baptism_not_recorded') %></span>
                      <% } %>
                    </div>
                    <div style="font-size:.85rem;margin-bottom:.5rem">
                      <strong><%= t('communion') %>:</strong>
                      <% if (r.sacraments && r.sacraments.firstCommunion) { %>
                        <%= formatDateOnly(r.sacraments.firstCommunion.date) %><% if (r.sacraments.firstCommunion.church) { %> &mdash; <%= r.sacraments.firstCommunion.church %><% } %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('first_communion_not_recorded') %></span>
                      <% } %>
                    </div>
                    <div style="font-size:.85rem">
                      <strong><%= t('confirmation') %>:</strong>
                      <% if (r.sacraments && r.sacraments.confirmationDate) { %>
                        <%= t('confirmation_received_on').replace('%s', formatDateOnly(r.sacraments.confirmationDate)) %>
                      <% } else { %>
                        <span style="color:var(--muted)"><%= t('confirmation_not_recorded') %></span>
                      <% } %>
                      <form method="post" action="/admin/students/<%= r.id %>/confirmation" class="d-flex align-items-center gap-2 mt-2">
                        <input type="date" class="form-control form-control-sm" style="max-width:170px" name="confirmation_received_date" value="<%= formatDateOnly(r.sacraments && r.sacraments.confirmationDate) %>">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><%= t('save') %></button>
                        <% if (r.sacraments && r.sacraments.confirmationDate) { %>
                          <button type="submit" name="clear_confirmation" value="1" class="btn btn-sm btn-outline-secondary"><%= t('clear_confirmation_date_label') %></button>
                        <% } %>
                      </form>
                    </div>
                  </div>
                </div>
                <div class="row g-4 p-2 pt-0">
                  <div class="col-12">
                    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.5rem"><%= t('family_payments_label') %></div>
                    <% const familyPaymentsRows = Array.isArray(r.familyPayments) ? r.familyPayments : []; %>
                    <% if (!familyPaymentsRows.length) { %>
                      <div style="font-size:.85rem;color:var(--muted)"><%= t('no_family_payments') %></div>
                    <% } else { %>
                      <div class="table-responsive">
                        <table class="table table-sm mb-2">
                          <thead>
                            <tr>
                              <th><%= t('student') %></th>
                              <th><%= t('payment_amount_col') %></th>
                              <th><%= t('payment_method_col') %></th>
                              <th><%= t('payment_date_col') %></th>
                              <th></th>
                            </tr>
                          </thead>
                          <tbody>
                            <% familyPaymentsRows.forEach((payment) => { %>
                              <tr<% if (payment.isSelf) { %> style="font-weight:600"<% } %>>
                                <td><%= payment.studentFullName %></td>
                                <td><% if (payment.tuitionPaid && payment.amount != null) { %>$<%= payment.amount %><% } else { %><span style="color:var(--muted)">&mdash;</span><% } %></td>
                                <td>
                                  <% if (payment.method) { %>
                                    <%= t('payment_method_' + payment.method) %>
                                  <% } else { %>
                                    <span style="color:var(--muted)">&mdash;</span>
                                  <% } %>
                                </td>
                                <td style="color:var(--muted)"><%= payment.paidAt ? formatDateOnly(payment.paidAt) : '—' %></td>
                                <td>
                                  <% if (payment.tuitionPaid && (payment.method === 'cash' || payment.method === 'credit_card')) { %>
                                    <a href="/admin/students/<%= payment.id %>/receipt" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><%= t('view_receipt_label') %></a>
                                  <% } %>
                                </td>
                              </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    <% } %>
                    <form method="post" action="/admin/students/<%= r.id %>/payment" class="d-flex flex-wrap align-items-end gap-2">
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_amount_col') %></label>
                        <input type="number" min="0" step="1" class="form-control form-control-sm" style="max-width:130px" name="amount" placeholder="<%= t('payment_amount_placeholder') %>" required>
                      </div>
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_method_col') %></label>
                        <select class="form-select form-select-sm" style="max-width:150px" name="method" required>
                          <option value="" disabled selected><%= t('select_payment_method') %></option>
                          <option value="cash"><%= t('payment_method_cash') %></option>
                          <option value="credit_card"><%= t('payment_method_credit_card') %></option>
                        </select>
                      </div>
                      <div>
                        <label class="form-label mb-1" style="font-size:.75rem"><%= t('payment_date_col') %></label>
                        <input type="date" class="form-control form-control-sm" style="max-width:150px" name="payment_date" value="<%= new Date().toISOString().slice(0, 10) %>">
                      </div>
                      <button type="submit" class="btn btn-sm btn-outline-primary"><%= t('record_payment_label') %></button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>

<div class="modal fade" id="certFilesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="certFilesModalTitle"><%= t('certificate_files') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled mb-0" id="certFilesModalList"></ul>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    var sidebar = document.getElementById('students-rf-sidebar');
    var collapseBtn = document.getElementById('students-rf-collapse-toggle');
    var expandBtn = document.getElementById('students-rf-expand-toggle');
    if (!sidebar || !collapseBtn) return;
    var STORAGE_KEY = 'ccd-students-filters-collapsed';
    function setCollapsed(collapsed) {
      sidebar.classList.toggle('rf-collapsed', collapsed);
      collapseBtn.setAttribute('aria-expanded', String(!collapsed));
      try { window.localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch (e) {}
    }
    collapseBtn.addEventListener('click', function () { setCollapsed(true); });
    if (expandBtn) expandBtn.addEventListener('click', function () { setCollapsed(false); });
    try {
      if (window.localStorage.getItem(STORAGE_KEY) === '1') setCollapsed(true);
    } catch (e) {}
  }());
</script>
<script>
  (function () {
    document.querySelectorAll('.student-details-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.getElementById(btn.getAttribute('data-target'));
        if (!target) return;
        var nowHidden = target.classList.toggle('d-none');
        btn.innerHTML = nowHidden ? '&#9656;' : '&#9662;';
      });
    });
  }());
</script>
<script>
  (function () {
    var verifiedByOnTemplate = <%- JSON.stringify(t('verified_by_on')) %>;
    document.querySelectorAll('.verification-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        var registrationId = checkbox.dataset.registrationId;
        var field = checkbox.dataset.field;
        var checked = checkbox.checked;
        checkbox.disabled = true;
        fetch('/admin/registrations/children/' + registrationId + '/verification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ field: field, checked: checked }),
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            checkbox.disabled = false;
            if (!data.ok) {
              checkbox.checked = !checked;
              return;
            }
            var metaEl = checkbox.closest('.verification-check-row').querySelector('.verification-meta');
            if (data.checked && data.verifierName && data.at) {
              metaEl.textContent = verifiedByOnTemplate.replace('%s', data.verifierName).replace('%s', String(data.at).slice(0, 16).replace('T', ' '));
            } else {
              metaEl.textContent = '';
            }
          })
          .catch(function () {
            checkbox.disabled = false;
            checkbox.checked = !checked;
          });
      });
    });
  }());
</script>
<script>
  (function () {
    var modalEl = document.getElementById('certFilesModal');
    var modalTitleEl = document.getElementById('certFilesModalTitle');
    var modalListEl = document.getElementById('certFilesModalList');
    var certFilesModalTitleTemplate = <%- JSON.stringify(t('certificate_files')) %>;
    if (!modalEl) return;
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    document.querySelectorAll('.cert-files-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var files = [];
        try {
          files = JSON.parse(btn.dataset.files || '[]');
        } catch (e) {
          files = [];
        }
        modalTitleEl.textContent = btn.dataset.name ? (btn.dataset.name + ' — ' + certFilesModalTitleTemplate) : certFilesModalTitleTemplate;
        modalListEl.innerHTML = '';
        files.forEach(function (file) {
          var li = document.createElement('li');
          li.className = 'mb-2';
          var link = document.createElement('a');
          link.href = file.href;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = file.label;
          li.appendChild(link);
          if (file.sub) {
            var sub = document.createElement('span');
            sub.style.color = 'var(--muted)';
            sub.style.fontSize = '.8rem';
            sub.textContent = ' (' + file.sub + ')';
            li.appendChild(sub);
          }
          modalListEl.appendChild(li);
        });
        modal.show();
      });
    });
  }());
</script>
</body>
</html>
