<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= isAdmin ? t('admin_resource_pages_title') : t('resource_pages_page_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<% if (isAdmin) { %><%- include('_admin_nav') %><% } %>

<main class="container py-4 app-shell mx-auto">
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= isAdmin ? t('admin_resource_pages_title') : t('resource_pages_page_title') %></h1>
      <p class="sub mb-0"><%= isAdmin ? t('admin_resource_pages_subtitle') : t('resource_pages_page_subtitle') %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="/resources"><%= t('resources_nav') %></a>
      <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
    </div>
  </div>

  <% if (isAdmin) { %>
    <div class="page-card mb-4">
      <div class="card-header"><h2 class="h5 mb-0"><%= t('add_resource_page_button') %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/resource-pages" class="row gy-3 gx-3">
          <div class="col-12 col-md-6">
            <label class="form-label" for="resource-page-title"><%= t('resource_page_title_label') %></label>
            <input class="form-control" type="text" id="resource-page-title" name="title" maxlength="255" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="resource-page-description"><%= t('resource_page_description_label') %></label>
            <textarea class="form-control" id="resource-page-description" name="description" rows="2" maxlength="2000"></textarea>
          </div>
          <div class="col-12">
            <button class="btn btn-primary" type="submit"><%= t('add_resource_page_button') %></button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!pages.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= isAdmin ? t('no_resource_pages_yet') : t('no_resource_pages') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('resource_page_title_label') %></th>
                <% if (isAdmin) { %><th><%= t('resource_visibility_label') %></th><th><%= t('resource_page_items_col') %></th><% } %>
                <th><%= t('submitted_col') %></th>
                <th style="<%= isAdmin ? 'text-align:right' : '' %>"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% pages.forEach((page) => { %>
                <tr>
                  <td>
                    <div style="font-weight:600"><%= page.title %></div>
                    <% if (page.description) { %><div style="font-size:.82rem;color:var(--muted)"><%= page.description %></div><% } %>
                  </td>
                  <% if (isAdmin) { %>
                    <td style="font-size:.85rem">
                      <% if (page.assignmentLabels.length) { %>
                        <%= page.assignmentLabels.join(', ') %>
                      <% } else { %>
                        <span style="color:var(--muted);font-style:italic"><%= t('resource_not_shared_label') %></span>
                      <% } %>
                    </td>
                    <td style="font-size:.85rem"><%= page.itemCount %></td>
                  <% } %>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(page.created_at) %></td>
                  <td style="<%= isAdmin ? 'text-align:right' : '' %>">
                    <div class="d-inline-flex gap-2">
                      <a class="btn btn-sm btn-outline-primary" href="/resource-pages/<%= page.id %>"><%= isAdmin ? t('manage_page_button') : t('view_page_button') %></a>
                      <% if (isAdmin) { %>
                        <form method="post" action="/admin/resource-pages/<%= page.id %>/delete" onsubmit="return confirm('<%= t('remove_resource_page_confirm') %>');">
                          <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
