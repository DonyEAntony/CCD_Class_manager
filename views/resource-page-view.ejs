<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.title %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<% if (isAdmin) { %><%- include('_admin_nav') %><% } %>

<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= page.title %></h1>
      <% if (page.description) { %><p class="sub mb-0"><%= page.description %></p><% } %>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="/resource-pages"><%= t('back_to_resource_pages') %></a>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-body p-0">
      <% if (!items.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('resource_page_no_items') %></em></div>
      <% } else { %>
        <ul class="list-group list-group-flush">
          <% items.forEach((item, index) => { %>
            <li class="list-group-item">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                  <% if (item.item_type === 'link') { %>
                    <a href="<%= item.link_url %>" target="_blank" rel="noopener noreferrer" style="font-weight:600"><%= item.link_label %></a>
                  <% } else { %>
                    <div style="font-weight:600"><%= item.resource_title || item.resource_original_filename %></div>
                  <% } %>
                  <% if (item.explanation) { %><div style="font-size:.85rem;color:var(--muted);margin-top:2px"><%= item.explanation %></div><% } %>
                </div>
                <div class="d-inline-flex align-items-center gap-2">
                  <% if (item.item_type === 'link') { %>
                    <a class="btn btn-sm btn-outline-primary" href="<%= item.link_url %>" target="_blank" rel="noopener noreferrer"><%= t('open_link_button') %></a>
                  <% } else { %>
                    <a class="btn btn-sm btn-outline-primary" href="/resources/<%= item.resource_id %>/download"><%= t('download_button') %></a>
                  <% } %>
                  <% if (isAdmin) { %>
                    <form method="post" action="/admin/resource-pages/<%= page.id %>/items/<%= item.id %>/move" style="display:inline">
                      <input type="hidden" name="direction" value="up">
                      <button class="btn btn-sm btn-outline-secondary" type="submit" <%= index === 0 ? 'disabled' : '' %> aria-label="<%= t('move_up') %>" title="<%= t('move_up') %>">&#8593;</button>
                    </form>
                    <form method="post" action="/admin/resource-pages/<%= page.id %>/items/<%= item.id %>/move" style="display:inline">
                      <input type="hidden" name="direction" value="down">
                      <button class="btn btn-sm btn-outline-secondary" type="submit" <%= index === items.length - 1 ? 'disabled' : '' %> aria-label="<%= t('move_down') %>" title="<%= t('move_down') %>">&#8595;</button>
                    </form>
                    <form method="post" action="/admin/resource-pages/<%= page.id %>/items/<%= item.id %>/delete" style="display:inline">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                    </form>
                  <% } %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <% if (isAdmin) { %>
    <div class="page-card mb-4">
      <div class="card-header"><h2 class="h5 mb-0"><%= t('resource_page_add_item_heading') %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/resource-pages/<%= page.id %>/items" class="row gy-3 gx-3" id="add-item-form">
          <div class="col-12 col-md-3">
            <label class="form-label" for="item-type"><%= t('resource_page_item_type_label') %></label>
            <select class="form-select" id="item-type" name="item_type">
              <option value="resource"><%= t('resource_page_item_type_resource') %></option>
              <option value="link"><%= t('resource_page_item_type_link') %></option>
            </select>
          </div>
          <div class="col-12 col-md-4" id="resource-select-field">
            <label class="form-label" for="item-resource-id"><%= t('resource_page_select_resource_label') %></label>
            <select class="form-select" id="item-resource-id" name="resource_id">
              <option value=""><%= t('resource_page_select_resource_placeholder') %></option>
              <% resourcesAll.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-2 d-none" id="link-url-field">
            <label class="form-label" for="item-link-url"><%= t('resource_page_link_url_label') %></label>
            <input class="form-control" type="url" id="item-link-url" name="link_url" placeholder="https://…">
          </div>
          <div class="col-12 col-md-2 d-none" id="link-label-field">
            <label class="form-label" for="item-link-label"><%= t('resource_page_link_label_label') %></label>
            <input class="form-control" type="text" id="item-link-label" name="link_label" maxlength="255">
          </div>
          <div class="col-12">
            <label class="form-label" for="item-explanation"><%= t('resource_page_explanation_label') %></label>
            <textarea class="form-control" id="item-explanation" name="explanation" rows="2" maxlength="2000"></textarea>
          </div>
          <div class="col-12">
            <button class="btn btn-primary" type="submit"><%= t('resource_page_add_item_button') %></button>
          </div>
        </form>
      </div>
    </div>

    <div class="page-card mb-4">
      <div class="card-header"><h2 class="h5 mb-0"><%= t('resource_visibility_label') %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/resource-pages/<%= page.id %>/share" class="row gy-2 gx-2">
          <%- include('_resource_audience_fields', {
            t, assignableRoles, roleLabels, ccdClasses, ccdGradeMeanings, assignableUsers,
            fieldIdPrefix: 'resource-page-share',
            audiencePrefill: assignmentFields,
          }) %>
          <div class="col-12">
            <button class="btn btn-primary btn-sm" type="submit"><%= t('save_sharing_button') %></button>
          </div>
        </form>
      </div>
    </div>

    <form method="post" action="/admin/resource-pages/<%= page.id %>/delete" onsubmit="return confirm('<%= t('remove_resource_page_confirm') %>');">
      <button class="btn btn-outline-danger" type="submit"><%= t('remove') %></button>
    </form>
  <% } %>
</main>
<% if (isAdmin) { %>
<script>
  (function () {
    var itemType = document.getElementById('item-type');
    var resourceField = document.getElementById('resource-select-field');
    var linkUrlField = document.getElementById('link-url-field');
    var linkLabelField = document.getElementById('link-label-field');
    if (!itemType || !resourceField || !linkUrlField || !linkLabelField) return;

    var update = () => {
      var isLink = itemType.value === 'link';
      resourceField.classList.toggle('d-none', isLink);
      linkUrlField.classList.toggle('d-none', !isLink);
      linkLabelField.classList.toggle('d-none', !isLink);
    };
    itemType.addEventListener('change', update);
    update();
  }());
</script>
<% } %>
</body>
</html>
