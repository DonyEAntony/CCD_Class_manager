<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('user_registrations') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>

<main class="container py-4 app-shell mx-auto">
  <% const adultProgramLookup = Array.isArray(ADULT_PROGRAMS) ? Object.fromEntries(ADULT_PROGRAMS.map((program) => [program.key, program])) : (ADULT_PROGRAMS || {}); %>
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>
  <% const totalCount = (studentRegs || []).length + (familyRegs || []).length + (adultRegs || []).length + (sponsorRegs || []).length; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('associated_registrations') %></h1>
      <p class="sub mb-0"><%= t('associated_registrations_subtitle') %></p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/users"><%= t('back') %></a>
  </div>

  <div class="page-card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="fw-semibold"><%= targetUser.full_name || targetUser.email %></div>
        <div class="text-muted" style="font-size:.85rem"><%= targetUser.email %></div>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="badge badge-role badge-<%= targetUser.role %>"><%= targetUser.role %></span>
        <span class="badge text-bg-light"><%= totalCount %> <%= t('registrations_word') %></span>
        <a class="btn btn-sm btn-outline-primary" href="/admin/users/<%= targetUser.id %>/uploads"><%= t('user_uploads') %></a>
      </div>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('faith_formation_children') %></h2></div>
    <div class="card-body p-0">
      <% if (!studentRegs || !studentRegs.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_children_regs') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><%= t('grade') %></th>
                <th><%= t('primary_contact') %></th>
                <th><%= t('status') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% studentRegs.forEach((r) => { %>
                <tr>
                  <td style="font-weight:600"><%= r.student_full_name %></td>
                  <td><%= (typeof resolveCcdGrade === 'function' ? resolveCcdGrade(r) : r.ccd_grade_level) || '-' %></td>
                  <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '-' %></td>
                  <td><span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(r.status) %></span></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(r.created_at) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/registration/children/edit/<%= r.id %>"><%= t('edit') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('family_faith_registrations') %></h2></div>
    <div class="card-body p-0">
      <% if (!familyRegs || !familyRegs.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_family_regs') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('family_name') %></th>
                <th><%= t('family_primary_contact') %></th>
                <th><%= t('members_col') %></th>
                <th><%= t('status') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% familyRegs.forEach((r) => { %>
                <tr>
                  <td style="font-weight:600"><%= r.family_name %></td>
                  <td style="font-size:.85rem"><%= r.primary_contact_name || r.primary_contact_email || '-' %></td>
                  <td><%= Array.isArray(r.members) ? r.members.length : 0 %></td>
                  <td><span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(r.status) %></span></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(r.created_at) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/registration/family-faith/edit/<%= r.id %>"><%= t('edit') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5"><%= t('adult_program_regs') %></h2></div>
    <div class="card-body p-0">
      <% if (!adultRegs || !adultRegs.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_adult_regs') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('name_col') %></th>
                <th><%= t('program_col') %></th>
                <th><%= t('status') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% adultRegs.forEach((r) => { %>
                <% const program = adultProgramLookup[r.program_type] || { title: r.program_type }; %>
                <tr>
                  <td style="font-weight:600"><%= r.full_name %></td>
                  <td><%= program.title %></td>
                  <td><span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(r.status) %></span></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(r.created_at) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/registration/adult/edit/<%= r.program_type %>/<%= r.id %>"><%= t('edit') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="page-card">
    <div class="card-header"><h2 class="h5"><%= t('sponsor_confirmation_forms_header') %></h2></div>
    <div class="card-body p-0">
      <% if (!sponsorRegs || !sponsorRegs.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_sponsor_forms') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><%= t('sponsor_form_sponsor_name') %></th>
                <th><%= t('status') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% sponsorRegs.forEach((r) => { %>
                <tr>
                  <td style="font-weight:600"><%= r.student_name %></td>
                  <td><%= r.sponsor_name %></td>
                  <td><span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(r.status) %></span></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(r.created_at) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/registration/sponsor-confirmation/edit/<%= r.id %>"><%= t('edit') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
