<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('adult_classes_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .class-card {
      display: block;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface);
      padding: 1.25rem;
      text-decoration: none;
      transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
      height: 100%;
    }
    .class-card:hover {
      box-shadow: 0 6px 24px var(--shadow-md);
      transform: translateY(-2px);
      border-color: var(--gold);
      text-decoration: none;
    }
    .class-card .class-grade-eyebrow {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.35rem;
    }
    .class-card .class-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 0.4rem;
    }
    .class-card .class-meta {
      font-size: 0.82rem;
      color: var(--ink-soft);
      margin-bottom: 0.75rem;
    }
    .class-card .class-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .class-card .class-badge {
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: 2rem;
      padding: 0.3em 0.8em;
      border: 1px solid var(--border);
      background: var(--white);
      color: var(--navy-soft);
    }
    .class-card .class-badge.next-badge {
      background: var(--gold-pale);
      color: #7a5a1a;
      border-color: #f0d090;
    }
    .class-card .class-badge.pending-badge {
      background: var(--gold-pale);
      color: #7a5a1a;
      border-color: #f0d090;
    }
  </style>
</head>
<body>
<%- include('_topbar') %>
<% if (user.role === 'admin') { %>
  <%- include('_admin_nav') %>
<% } else { %>
  <div class="admin-nav">
    <div class="admin-nav-links"></div>
    <a class="admin-nav-back" href="/dashboard"><%= t('back_to_dashboard') %></a>
  </div>
<% } %>
<main class="container py-4 app-shell mx-auto">
  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('adult_classes_header') %></h1>
      <p class="sub mb-0"><%= t('adult_classes_subtitle') %></p>
    </div>
  </div>

  <% if (user.role === 'admin') { %>
    <div class="page-card mb-4">
      <div class="card-body">
        <form class="row g-3 align-items-end" method="post" action="/admin/ccd-classes">
          <div class="col-md-3">
            <label class="form-label"><%= t('adult_program_label') %></label>
            <select class="form-select" name="grade_level" required>
              <option value="" disabled selected><%= t('select_placeholder') %></option>
              <option value="ocia"><%= adultProgramLabels.ocia || 'OCIA' %></option>
              <option value="family_faith"><%= adultProgramLabels.family_faith %></option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label"><%= t('linked_class_label') %></label>
            <select class="form-select" name="linked_class_id">
              <option value=""><%= t('linked_class_none_option') %></option>
              <% childrenClasses.forEach((c) => { %>
                <option value="<%= c.id %>"><%= ccdGradeMeanings[c.grade_level] || c.grade_level %><%= c.sectionLabel || '' %> &mdash; <%= c.class_time || '—' %></option>
              <% }) %>
            </select>
            <div class="form-text"><%= t('linked_class_help') %></div>
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('class_time_label') %></label>
            <input class="form-control" type="text" name="class_time" placeholder="<%= t('class_time_placeholder') %>">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('room') %></label>
            <input class="form-control" type="text" name="classroom" placeholder="<%= t('room_placeholder') %>">
          </div>
          <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit"><%= t('add_adult_class_button') %></button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <% if (!classes || classes.length === 0) { %>
    <div class="page-card">
      <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_classes_configured_yet') %></em></div>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% classes.forEach((ccdClass) => { %>
        <% const isFamilyFaith = ccdClass.sourceProgramType === 'family_faith'; %>
        <div class="col-sm-6 col-lg-4">
          <a href="/admin/classes/<%= ccdClass.id %>" class="class-card">
            <div class="class-grade-eyebrow"><%= t('adult_faith_formation_label') %></div>
            <div class="class-title"><%= adultProgramLabels[ccdClass.grade_level] || (ccdClass.grade_level === 'ocia' ? 'OCIA' : ccdClass.grade_level) %></div>
            <div class="class-meta">
              <% const cardCatechists = ccdClass.catechists || []; %>
              <% const cardCatechistNames = cardCatechists.slice(0, 2).map((c) => c.name || c.email); %>
              <%= cardCatechists.length ? cardCatechistNames.join(', ') : t('unassigned') %><% if (cardCatechists.length > 2) { %> +<%= cardCatechists.length - 2 %> <%= t('catechists_more_suffix') %><% } %> &middot; <%= ccdClass.class_time || '—' %><% if (ccdClass.classroom) { %>, <%= ccdClass.classroom %><% } %>
              <% if (ccdClass.linkedClassLabel) { %><br><%= t('linked_class_label') %>: <%= ccdClass.linkedClassLabel %><% } %>
            </div>
            <div class="class-badges">
              <span class="class-badge">
                <%= ccdClass.studentCount %>
                <%= isFamilyFaith
                  ? (ccdClass.studentCount === 1 ? t('family_count_singular') : t('family_count_plural'))
                  : (ccdClass.studentCount === 1 ? t('student_count_singular') : t('student_count_plural')) %>
              </span>
              <% if (ccdClass.nextSessionDate) { %>
                <span class="class-badge next-badge"><%= t('next_label') %>: <%= ccdClass.nextSessionDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
              <% } %>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
