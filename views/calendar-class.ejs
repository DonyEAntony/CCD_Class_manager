<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= className %> &mdash; <%= t('year_calendar_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Figtree:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    /* Tokens below are namespaced (--sl-*) and scoped to .session-ledger so they
       never collide with the app's own --navy/--gold theme used by the topbar.
       Palette matches the "Organic" design system used for the class panel and
       the printable First Communion schedule flier, for a consistent look. */
    .session-ledger {
      --sl-bg: #f5ead8;
      --sl-surface: #f9f4ed;
      --sl-text: #201e1d;
      --sl-accent: #c67139;
      --sl-accent-100: #fff2eb;
      --sl-accent-200: #ffe1d0;
      --sl-accent-300: #ffc6a5;
      --sl-accent-700: #8c491a;
      --sl-accent-800: #643312;
      --sl-accent-900: #402310;
      --sl-accent2-200: #e1eecc;
      --sl-accent2-800: #3d472b;
      --sl-accent2-900: #272e1b;
      --sl-mass-200: #dde2f6;
      --sl-mass-900: #2c3568;
      --sl-neutral-200: #eee7db;
      --sl-neutral-600: #82796a;
      --sl-neutral-700: #645c50;
      --sl-divider: rgba(32, 30, 29, 0.16);
      --sl-font-heading: "Caprasimo", Georgia, serif;
      --sl-font-body: "Figtree", system-ui, sans-serif;
      --sl-radius-lg: 28px;
      --sl-shadow-md: 0 3px 10px rgba(46, 43, 37, 0.16);

      background: var(--sl-surface);
      border-radius: var(--sl-radius-lg);
      box-shadow: var(--sl-shadow-md);
      padding: 44px 46px 38px;
      font-family: var(--sl-font-body);
      color: var(--sl-text);
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .sl-eyebrow-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      font: 700 11px var(--sl-font-body);
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--sl-accent-700);
    }
    .sl-eyebrow-row span:last-child { color: var(--sl-accent2-800); }
    .sl-hero {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .sl-hero h1 {
      font-family: var(--sl-font-heading);
      font-weight: 400;
      font-size: 40px;
      line-height: .98;
      margin: 6px 0 0;
      color: var(--sl-text);
      max-width: 19ch;
    }
    .sl-hero-subtitle {
      font: 600 15px var(--sl-font-body);
      color: var(--sl-accent2-800);
      margin-top: 4px;
    }
    .sl-badge {
      flex: none;
      width: 96px;
      height: 96px;
      border-radius: 999px;
      background: var(--sl-accent);
      color: var(--sl-accent-100);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      box-shadow: var(--sl-shadow-md);
    }
    .sl-badge-count {
      font-family: var(--sl-font-heading);
      font-size: 30px;
      line-height: 1;
    }
    .sl-badge-label {
      font: 700 9.5px var(--sl-font-body);
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .sl-info-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .sl-info-pill {
      border-radius: 999px;
      background: var(--sl-accent2-200);
      color: var(--sl-accent2-900);
      padding: 7px 18px;
      font: 700 14px var(--sl-font-body);
    }
    .sl-month-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 22px 32px;
    }
    .sl-month-block {
      display: flex;
      flex-direction: column;
      gap: 9px;
      break-inside: avoid;
    }
    .sl-month-header {
      font-family: var(--sl-font-heading);
      font-size: 19px;
      color: var(--sl-accent-700);
      border-bottom: 2px solid var(--sl-accent-300);
      padding-bottom: 4px;
    }
    .sl-session-row {
      display: flex;
      align-items: center;
      gap: 13px;
    }
    .sl-day-badge {
      flex: none;
      width: 34px;
      height: 34px;
      border-radius: 999px;
      background: var(--sl-neutral-200);
      display: grid;
      place-items: center;
      font-family: var(--sl-font-heading);
      font-size: 16px;
    }
    .sl-day-badge.has-note { background: var(--sl-accent-200); color: var(--sl-accent-900); }
    .sl-day-badge.type-retreat { background: var(--sl-accent-200); color: var(--sl-accent-900); }
    .sl-day-badge.type-rehearsal { background: var(--sl-accent2-200); color: var(--sl-accent2-900); }
    .sl-day-badge.type-mass { background: var(--sl-mass-200); color: var(--sl-mass-900); }
    .sl-session-label {
      font: 600 15px var(--sl-font-body);
      flex: 1 1 auto;
      min-width: 0;
    }
    .sl-type-tag {
      flex: none;
      font: 700 10px var(--sl-font-body);
      letter-spacing: .04em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 999px;
    }
    .sl-type-tag-retreat { background: var(--sl-accent-200); color: var(--sl-accent-900); }
    .sl-type-tag-rehearsal { background: var(--sl-accent2-200); color: var(--sl-accent2-900); }
    .sl-type-tag-mass { background: var(--sl-mass-200); color: var(--sl-mass-900); }
    .sl-type-select {
      border: 1px solid var(--sl-divider);
      border-radius: 6px;
      padding: 3px 6px;
      font: 400 12px var(--sl-font-body);
      background: var(--sl-surface);
      color: var(--sl-text);
      flex: none;
    }
    .sl-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 24px;
      border-top: 2px solid var(--sl-neutral-200);
      padding-top: 12px;
      font: 400 12px/1.5 var(--sl-font-body);
      color: var(--sl-neutral-700);
    }
    .sl-footer span:first-child { font-weight: 700; color: var(--sl-text); }
    .sl-empty {
      color: var(--sl-neutral-600);
      font-size: 14px;
      padding: 20px 0;
    }
    .sl-pill-edit-btn, .sl-pill-remove-btn, .sl-pill-save-btn {
      border: none;
      background: var(--sl-neutral-200);
      color: var(--sl-neutral-700);
      width: 22px;
      height: 22px;
      border-radius: 999px;
      font-size: 12px;
      line-height: 1;
      display: inline-grid;
      place-items: center;
      cursor: pointer;
      flex: none;
    }
    .sl-pill-edit-btn:hover, .sl-pill-remove-btn:hover, .sl-pill-save-btn:hover { background: var(--sl-accent-200); color: var(--sl-accent-900); }
    .sl-inline-edit-input {
      border: 1px solid var(--sl-divider);
      border-radius: 6px;
      padding: 3px 8px;
      font: 400 14px var(--sl-font-body);
      min-width: 0;
      flex: 1 1 auto;
      color: var(--sl-text);
      background: var(--sl-surface);
    }
    .sl-add-day-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      background: var(--sl-bg);
      border-radius: 16px;
    }
    .sl-add-day-row input[type="date"], .sl-add-day-row input[type="text"], .sl-add-day-row select {
      border: 1px solid var(--sl-divider);
      border-radius: 8px;
      padding: 6px 10px;
      font: 400 13px var(--sl-font-body);
      background: var(--sl-surface);
      color: var(--sl-text);
    }
    .sl-add-day-row button {
      border: none;
      border-radius: 8px;
      padding: 7px 16px;
      background: var(--sl-accent);
      color: var(--sl-accent-100);
      font: 600 13px var(--sl-font-body);
      cursor: pointer;
    }
    .sl-generate-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 18px;
    }
    .sl-generate-hint {
      font-size: 12px;
      color: var(--sl-neutral-600);
    }
    .sl-generate-row button {
      border: 1px solid var(--sl-divider);
      border-radius: 8px;
      padding: 7px 16px;
      background: var(--sl-surface);
      color: var(--sl-text);
      font: 600 13px var(--sl-font-body);
      cursor: pointer;
    }

    @media print {
      @page { size: A4 portrait; margin: 12mm; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print, .site-topbar { display: none !important; }
      .session-ledger { box-shadow: none; max-width: 100%; }
    }
  </style>
</head>
<body>
<%- include('_topbar') %>
<main class="container py-4 app-shell-wide mx-auto">

  <% if (success.length) { %><div class="alert alert-success no-print" style="margin-bottom:1rem;padding:10px 16px"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger no-print" style="margin-bottom:1rem;padding:10px 16px"><%= error[0] %></div><% } %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-print">
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary" onclick="window.print()"><%= t('print_button') %></button>
      <a class="btn btn-outline-secondary" href="/calendar/year?class_id=<%= ccdClass.id %>"><%= t('year_view_label') %></a>
      <a class="btn btn-outline-secondary" href="/admin/classes/<%= ccdClass.id %>"><%= t('back_to_calendar') %></a>
    </div>
  </div>

  <div class="session-ledger">

    <div class="sl-eyebrow-row">
      <span><%= t('app_title') %> &middot; <%= t('faith_formation_col') %></span>
      <span><%= schoolYear.replace('-', ' – ') %></span>
    </div>

    <div class="sl-hero">
      <div>
        <h1><%= className %></h1>
        <div class="sl-hero-subtitle"><%= t('year_calendar_title') %> &middot; <%= t('session_calendar_label') %></div>
      </div>
      <div class="sl-badge">
        <div class="sl-badge-count"><%= sessionCount %></div>
        <div class="sl-badge-label"><%= t('session_count_label') %></div>
      </div>
    </div>

    <div class="sl-info-pills">
      <% if (classWeekdayText) { %><div class="sl-info-pill"><%= classWeekdayText %></div><% } %>
      <% if (classTimeRangeText) { %><div class="sl-info-pill"><%= classTimeRangeText %></div><% } %>
      <% if (rangeLabel) { %><div class="sl-info-pill"><%= rangeLabel %></div><% } %>
    </div>

    <% if (canEdit) { %>
      <form method="post" action="/admin/classes/<%= ccdClass.id %>/schedule/add" class="sl-add-day-row no-print">
        <input type="hidden" name="return_to" value="<%= currentUrl %>">
        <input type="date" name="session_date" aria-label="<%= t('add_class_day_label') %>" required>
        <select name="event_type" aria-label="<%= t('event_type_label') %>">
          <% eventTypes.forEach((type) => { %>
            <option value="<%= type %>"><%= t('event_type_' + type) %></option>
          <% }) %>
        </select>
        <input type="text" name="description" placeholder="<%= t('class_day_description_placeholder') %>" maxlength="255">
        <button type="submit"><%= t('add_class_day_button') %></button>
      </form>
      <form method="post" action="/admin/classes/<%= ccdClass.id %>/schedule/generate" class="sl-generate-row no-print">
        <input type="hidden" name="return_to" value="<%= currentUrl %>">
        <input type="hidden" name="school_year" value="<%= schoolYear %>">
        <span class="sl-generate-hint"><%= t('generate_schedule_hint') %></span>
        <button type="submit"><%= t('generate_schedule_label') %></button>
      </form>
    <% } %>

    <% if (!monthGroups.length) { %>
      <div class="sl-empty"><%= t('no_sessions_scheduled') %></div>
    <% } else { %>
      <div class="sl-month-grid">
        <% monthGroups.forEach((month) => { %>
          <div class="sl-month-block">
            <div class="sl-month-header"><%= month.label %> <%= month.year %></div>
            <% month.sessions.forEach((session) => { %>
              <% const badgeClass = session.eventType && session.eventType !== 'class_day' ? 'type-' + session.eventType : (session.description ? 'has-note' : ''); %>
              <div class="sl-session-row <%= canEdit ? 'editable' : '' %>" data-session-date="<%= session.value %>">
                <span class="sl-day-badge <%= badgeClass %>"><%= session.day %></span>
                <% if (session.eventType && session.eventType !== 'class_day') { %>
                  <span class="sl-type-tag sl-type-tag-<%= session.eventType %>"><%= t('event_type_' + session.eventType) %></span>
                <% } %>
                <span class="sl-session-label" data-role="display"><%= session.description || t('class_session_fallback_label') %></span>
                <% if (canEdit) { %>
                  <input type="text" class="sl-inline-edit-input no-print" data-role="input" style="display:none" value="<%= session.description || '' %>" placeholder="<%= t('class_day_description_placeholder') %>" maxlength="255">
                  <button type="button" class="sl-pill-edit-btn no-print" data-role="edit-btn" aria-label="<%= t('edit_class_day_note') %>" title="<%= t('edit_class_day_note') %>">&#9998;</button>
                  <button type="button" class="sl-pill-save-btn no-print" data-role="save-btn" style="display:none" aria-label="<%= t('save_description_button') %>" title="<%= t('save_description_button') %>">&#10003;</button>
                  <form method="post" action="/admin/classes/<%= ccdClass.id %>/schedule/type" class="no-print sl-type-form" style="display:inline">
                    <input type="hidden" name="session_date" value="<%= session.value %>">
                    <input type="hidden" name="return_to" value="<%= currentUrl %>">
                    <select name="event_type" class="sl-type-select" aria-label="<%= t('event_type_label') %>" onchange="this.form.submit()">
                      <% eventTypes.forEach((type) => { %>
                        <option value="<%= type %>" <%= session.eventType === type ? 'selected' : '' %>><%= t('event_type_' + type) %></option>
                      <% }) %>
                    </select>
                  </form>
                  <form method="post" action="/admin/classes/<%= ccdClass.id %>/schedule/remove" class="no-print" style="display:inline" onsubmit="return confirm('<%= t('remove_class_day') %>?');">
                    <input type="hidden" name="session_date" value="<%= session.value %>">
                    <input type="hidden" name="return_to" value="<%= currentUrl %>">
                    <button type="submit" class="sl-pill-remove-btn" aria-label="<%= t('remove_class_day') %>" title="<%= t('remove_class_day') %>">&times;</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="sl-footer">
      <span><%= t('parish_faith_formation_office') %></span>
      <span><%= t('verify_sacramental_records_note') %></span>
    </div>
  </div>

  <p class="footer-note no-print"><%= t('footer_note') %></p>

  <% if (canEdit) { %>
    <form method="post" action="/admin/classes/<%= ccdClass.id %>/schedule/description" id="description-edit-form" class="no-print" style="display:none">
      <input type="hidden" name="session_date" id="description-edit-date">
      <input type="hidden" name="description" id="description-edit-value">
      <input type="hidden" name="return_to" value="<%= currentUrl %>">
    </form>
    <script>
      document.querySelectorAll('.sl-session-row.editable').forEach((row) => {
        const displaySpan = row.querySelector('[data-role="display"]');
        const input = row.querySelector('[data-role="input"]');
        const editBtn = row.querySelector('[data-role="edit-btn"]');
        const saveBtn = row.querySelector('[data-role="save-btn"]');

        const startEditing = () => {
          displaySpan.style.display = 'none';
          editBtn.style.display = 'none';
          input.style.display = '';
          saveBtn.style.display = '';
          input.focus();
          input.select();
        };

        const save = () => {
          document.getElementById('description-edit-date').value = row.getAttribute('data-session-date');
          document.getElementById('description-edit-value').value = input.value.trim();
          document.getElementById('description-edit-form').submit();
        };

        editBtn.addEventListener('click', startEditing);
        saveBtn.addEventListener('click', save);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); save(); }
        });
      });
    </script>
  <% } %>
</main>
</body>
</html>
