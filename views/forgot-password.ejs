<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('forgot_password') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<%- include('_topbar') %>

<main class="container py-5 app-shell mx-auto">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">

      <div style="text-align:center;margin-bottom:1.5rem">
        <span style="font-size:2.5rem;color:var(--gold)">&#10022;</span>
        <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin:.25rem 0 0"><%= t('forgot_password') %></h1>
      </div>

      <div class="page-card">
        <div class="card-body p-4">
          <% if (error.length) { %><div class="alert alert-danger"><%= error[0] %></div><% } %>
          <% if (success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>

          <p class="mb-3" style="color:var(--muted);font-size:.9rem"><%= t('forgot_password_intro') %></p>

          <form method="post" action="/forgot-password" class="d-grid gap-3">
            <div>
              <label class="form-label"><%= t('email') %></label>
              <input class="form-control" type="email" name="email" autocomplete="email" required>
            </div>
            <button class="btn btn-primary w-100" type="submit"><%= t('send_reset_link') %></button>
          </form>

          <p class="mt-3 mb-0 text-center" style="font-size:.85rem;color:var(--muted)">
            <a href="/login"><%= t('back_to_login') %></a>
          </p>
        </div>
      </div>

    </div>
  </div>
</main>
</body>
</html>
