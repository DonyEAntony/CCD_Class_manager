<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('uploaded_documents') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>

<main class="container py-4 app-shell mx-auto">
  <% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
  <% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>
  <% const isAdminView = !!(typeof adminView !== 'undefined' && adminView); %>
  <% const shownUser = typeof targetUser !== 'undefined' ? targetUser : null; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('uploaded_documents') %></h1>
      <p class="sub mb-0">
        <% if (isAdminView && shownUser) { %>
          <%= shownUser.full_name || shownUser.email %> &mdash; <%= shownUser.email %>
        <% } else { %>
          <%= t('uploaded_documents_subtitle') %>
        <% } %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (isAdminView && shownUser) { %>
        <a class="btn btn-outline-primary" href="/admin/users/<%= shownUser.id %>/registrations"><%= t('view_registrations') %></a>
        <a class="btn btn-outline-secondary" href="/admin/users"><%= t('back') %></a>
      <% } else { %>
        <a class="btn btn-outline-secondary" href="/account"><%= t('my_account') %></a>
        <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
      <% } %>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!uploads || !uploads.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_uploads') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('file') %></th>
                <th><%= t('document_type') %></th>
                <th><%= t('registration') %></th>
                <th><%= t('submitted_col') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% uploads.forEach((uploadItem) => { %>
                <tr>
                  <td style="font-weight:600"><%= uploadFileNameForView(uploadItem.filePath) || t('view_file') %></td>
                  <td><%= t(uploadItem.documentTypeKey) %></td>
                  <td style="font-size:.85rem">
                    <div><%= t(uploadItem.registrationTypeKey) %></div>
                    <% if (uploadItem.registrationHref) { %>
                      <a href="<%= uploadItem.registrationHref %>"><%= uploadItem.registrationLabel || t('registration') %></a>
                    <% } else { %>
                      <span class="text-muted"><%= uploadItem.registrationLabel || '-' %></span>
                    <% } %>
                  </td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= dateLabel(uploadItem.createdAt) %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="<%= uploadHrefForView(uploadItem.filePath) %>" target="_blank" rel="noopener"><%= t('view_file') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
