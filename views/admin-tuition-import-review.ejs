<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('tuition_import_review_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell-wide mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <% const availableRows = Array.isArray(typeof rows === 'undefined' ? null : rows) ? rows : []; %>
  <% const statusBadgeStyle = "font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;"; %>
  <% const statusStyles = {
       matched: statusBadgeStyle + 'background:#e6f4ea;color:#1e7e34;',
       review: statusBadgeStyle + 'background:#fff3cd;color:#7a5a1a;',
       no_match: statusBadgeStyle + 'background:#fde2e1;color:#a12622;',
     }; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('tuition_import_review_header') %> &mdash; <%= schoolYear %></h1>
      <p class="sub mb-0"><%= t('tuition_import_review_subtitle') %></p>
    </div>
  </div>

  <form method="post" action="/admin/tuition-import/apply" id="tuition-import-apply-form">
    <% availableRows.forEach((row) => { %>
      <div class="page-card mb-3">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
            <div>
              <div style="font-weight:600"><%= row.raw.childNames.replace(/\n+/g, ', ') || '—' %></div>
              <div style="font-size:.8rem;color:var(--muted)">
                <%= t('tuition_import_row_email') %>: <%= row.raw.parentEmail || row.raw.billingEmail || '—' %>
              </div>
            </div>
            <div class="text-end">
              <% if (!row.isAccepted) { %>
                <span class="badge" style="<%= statusBadgeStyle %>background:var(--surface);color:var(--muted);border:1px solid var(--border)"><%= t('tuition_import_status_declined') %></span>
              <% } else if (row.matchStatus === 'matched') { %>
                <span class="badge" style="<%= statusStyles.matched %>"><%= t('tuition_import_status_matched') %></span>
              <% } else if (row.matchStatus === 'review') { %>
                <span class="badge" style="<%= statusStyles.review %>"><%= t('tuition_import_status_review') %></span>
              <% } else { %>
                <span class="badge" style="<%= statusStyles.no_match %>"><%= t('tuition_import_status_no_match') %></span>
              <% } %>
            </div>
          </div>

          <div class="row g-2 mb-2" style="font-size:.85rem">
            <div class="col-sm-4"><strong><%= t('tuition_import_row_amount') %>:</strong> $<%= row.amount ?? '—' %></div>
            <div class="col-sm-4"><strong><%= t('tuition_import_row_date') %>:</strong> <%= row.raw.createdAt || '—' %></div>
            <div class="col-sm-4"><strong><%= t('tuition_import_row_transaction') %>:</strong> <%= row.raw.transactionId || '—' %></div>
          </div>

          <% if (!row.isAccepted) { %>
            <div style="font-size:.85rem;color:var(--muted)"><%= row.raw.paidStatus %> / <%= row.raw.transactionResult %></div>
          <% } else if (!row.candidateRegistrations.length) { %>
            <div class="alert alert-secondary mb-0" style="font-size:.85rem"><%= t('tuition_import_no_candidates') %></div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm mb-2">
                <thead>
                  <tr>
                    <th style="width:2.5rem"></th>
                    <th><%= t('student') %></th>
                    <th><%= t('primary_contact') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% row.candidateRegistrations.forEach((candidate) => { %>
                    <tr>
                      <td>
                        <input
                          type="checkbox"
                          class="form-check-input"
                          name="selected_<%= row.rowIndex %>"
                          value="<%= candidate.id %>"
                          id="candidate-<%= row.rowIndex %>-<%= candidate.id %>"
                          <%= row.selectedIds.includes(candidate.id) ? 'checked' : '' %>
                        >
                      </td>
                      <td><label class="mb-0" for="candidate-<%= row.rowIndex %>-<%= candidate.id %>"><%= candidate.student_full_name %></label></td>
                      <td style="font-size:.85rem;color:var(--muted)"><%= candidate.parent_name || candidate.primary_contact_email || '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="skip" value="<%= row.rowIndex %>" id="skip-<%= row.rowIndex %>">
              <label class="form-check-label" style="font-size:.85rem" for="skip-<%= row.rowIndex %>"><%= t('tuition_import_skip_row') %></label>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>

    <div class="d-flex gap-2 mb-4">
      <button type="submit" class="btn btn-primary"><%= t('tuition_import_confirm') %></button>
      <a href="/admin/tuition-import" class="btn btn-outline-secondary"><%= t('tuition_import_cancel') %></a>
    </div>
  </form>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script>
  (function () {
    var form = document.getElementById('tuition-import-apply-form');
    if (!form) return;
    var confirmMessage = <%- JSON.stringify(t('tuition_import_confirm')) %> + '?';
    form.addEventListener('submit', function (event) {
      if (!confirm(confirmMessage)) event.preventDefault();
    });
  }());
</script>
</body>
</html>
