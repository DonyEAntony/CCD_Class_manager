<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('tuition_import_header') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <% const availableRegistrationYearOptions = Array.isArray(typeof registrationYearOptions === 'undefined' ? null : registrationYearOptions) ? registrationYearOptions : []; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('tuition_import_header') %></h1>
      <p class="sub mb-0"><%= t('tuition_import_subtitle') %></p>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body">
      <form method="post" action="/admin/tuition-import/preview" enctype="multipart/form-data" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label"><%= t('tuition_import_year_label') %></label>
          <select class="form-select" name="school_year" required>
            <% availableRegistrationYearOptions.forEach((yearOption) => { %>
              <option value="<%= yearOption %>" <%= yearOption === activeSchoolYear ? 'selected' : '' %>><%= yearOption %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-5">
          <label class="form-label"><%= t('tuition_import_file_label') %></label>
          <input class="form-control" type="file" name="csv_file" accept=".csv,text/csv" required>
        </div>
        <div class="col-md-3">
          <button class="btn btn-primary w-100" type="submit"><%= t('tuition_import_submit') %></button>
        </div>
      </form>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
</body>
</html>
