<%
const label = (en, es) => lang === 'es' ? es : en;
const active = href => typeof currentPath === 'string' && (currentPath === href || currentPath.startsWith(href + '/'));
// A link's 3rd element is the roles allowed to see it; omitted means every authenticated
// role (the route itself has no requireRole, e.g. Resources/Resource Pages, which degrade
// to a filtered view for non-admins rather than needing to be hidden). Groups that end up
// with no visible links for the current role are dropped entirely.
const rawGroups = [
[label('Registrations','Inscripciones'), [['/admin/registrations',label('Registrations','Inscripciones'),['admin']],['/admin/students',t('students_nav'),['admin']]]],
[label('Classes','Clases'), [['/admin/classes',t('classes_nav'),['admin','catechist']],['/admin/adult-classes',t('adult_events_nav'),['admin','catechist','family_faith_leader']],['/family-faith/visits/availability',t('manage_visit_availability'),['admin','family_faith_leader']]]],
[label('People','Personas'), [['/admin/users',t('user_administration'),['admin']],['/admin/catechists',t('manage_catechists_nav'),['admin']]]],
[label('More','Más'), [['/resources',t('manage_resources_nav')],['/resource-pages',t('manage_resource_pages_nav')],['/admin/notifications',t('manage_notifications_nav'),['admin']],['/admin/tuition-import',t('tuition_import_nav'),['admin']],['/admin/payment-review',label('Payment review','Revisión de pagos'),['admin']],['/admin/scan-registration',t('scan_legacy_form'),['admin']],['/admin/health/mail',t('mail_health'),['admin']],['/admin/health/document-ai',t('document_ai_health'),['admin']]]]
];
const groups = rawGroups
  .map(([title, links]) => [title, links.filter(([, , roles]) => !roles || roles.includes(user.role))])
  .filter(([, links]) => links.length);
%>
<nav class="admin-nav" aria-label="<%= label('Administration','Administración') %>">
<button type="button" class="admin-nav-toggle" aria-expanded="false" aria-controls="admin-nav-links">☰ <%= t('admin_nav_menu_label') %></button>
<div class="admin-nav-links" id="admin-nav-links">
<a class="admin-nav-primary<%= active('/dashboard') ? ' is-active' : '' %>" href="/dashboard" <% if(active('/dashboard')) { %>aria-current="page"<% } %>><%= label('Overview','Resumen') %></a>
<% groups.forEach(([title, links], i) => { %>
<div class="admin-nav-dropdown">
<button type="button" class="admin-nav-dropdown-toggle<%= links.some(([href]) => active(href)) ? ' is-active' : '' %>" aria-expanded="false" aria-controls="admin-nav-group-<%= i %>"><%= title %> <span aria-hidden="true">▾</span></button>
<div class="admin-nav-dropdown-menu" id="admin-nav-group-<%= i %>" hidden>
<% links.forEach(([href, title]) => { %><a href="<%= href %>" <% if(active(href)) { %>aria-current="page"<% } %>><%= title %></a><% }) %>
</div></div><% }) %>
</div></nav>
<script>
(() => {
const nav = document.currentScript.previousElementSibling;
const mobile = nav.querySelector('.admin-nav-toggle'), links = nav.querySelector('.admin-nav-links');
const buttons = [...nav.querySelectorAll('.admin-nav-dropdown-toggle')];
const close = () => buttons.forEach(b => { b.setAttribute('aria-expanded','false'); b.nextElementSibling.hidden = true; });
mobile.addEventListener('click', () => { const open = links.classList.toggle('open'); mobile.setAttribute('aria-expanded',String(open)); if (!open) close(); });
buttons.forEach(b => b.addEventListener('click', () => { const open = b.getAttribute('aria-expanded') !== 'true'; close(); b.setAttribute('aria-expanded',String(open)); b.nextElementSibling.hidden = !open; }));
nav.addEventListener('keydown', e => { if(e.key !== 'Escape') return; const open = buttons.find(b => b.getAttribute('aria-expanded') === 'true'); close(); if(open) open.focus(); else { links.classList.remove('open'); mobile.setAttribute('aria-expanded','false'); mobile.focus(); } });
document.addEventListener('click', e => { if(nav.contains(e.target)) return; close(); links.classList.remove('open'); mobile.setAttribute('aria-expanded','false'); });
nav.addEventListener('focusout', e => { if(!nav.contains(e.relatedTarget)) close(); });
})();
</script>
