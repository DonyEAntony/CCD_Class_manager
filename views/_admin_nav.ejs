<%# _admin_nav.ejs - include under _topbar on every /admin/* page %>
<div class="admin-nav">
  <button type="button" class="admin-nav-toggle" id="admin-nav-toggle" aria-expanded="false" aria-controls="admin-nav-links">
    <span aria-hidden="true">&#9776;</span> <%= t('admin_nav_menu_label') %>
  </button>
  <div class="admin-nav-links" id="admin-nav-links">
    <a href="/admin/registrations">Registrations</a>
    <a href="/admin/students"><%= t('students_nav') %></a>
    <a href="/admin/classes"><%= t('classes_nav') %></a>
    <a href="/admin/adult-classes"><%= t('adult_events_nav') %></a>
    <a href="/admin/users"><%= t('user_administration') %></a>
    <a href="/family-faith/visits/availability"><%= t('manage_visit_availability') %></a>
    <% if (user.role === 'admin') { %>
      <a href="/resources"><%= t('manage_resources_nav') %></a>
      <a href="/resource-pages"><%= t('manage_resource_pages_nav') %></a>
      <a href="/admin/notifications"><%= t('manage_notifications_nav') %></a>
      <a href="/admin/catechists"><%= t('manage_catechists_nav') %></a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <div class="admin-nav-dropdown">
        <button type="button" class="admin-nav-dropdown-toggle" id="admin-tools-toggle" aria-expanded="false"><%= t('admin_tools_menu') %> &#9662;</button>
        <div class="admin-nav-dropdown-menu d-none" id="admin-tools-menu">
          <a href="/admin/tuition-import"><%= t('tuition_import_nav') %></a>
          <a href="/admin/scan-registration"><%= t('scan_legacy_form') %></a>
          <a href="/admin/health/mail" target="_blank" rel="noreferrer"><%= t('mail_health') %></a>
          <a href="/admin/health/document-ai" target="_blank" rel="noreferrer"><%= t('document_ai_health') %></a>
        </div>
      </div>
    <% } %>
  </div>
  <a class="admin-nav-back" href="/dashboard"><%= t('back_to_dashboard') %></a>
</div>
<script>
  (function () {
    var navToggle = document.getElementById('admin-nav-toggle');
    var navLinks = document.getElementById('admin-nav-links');
    if (navToggle && navLinks) {
      navToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = navLinks.classList.contains('open');
        navLinks.classList.toggle('open', !isOpen);
        navToggle.setAttribute('aria-expanded', String(!isOpen));
      });
      // Close on an outside click, and on picking a link — a mobile drawer that's still
      // open after navigating away, or after tapping elsewhere on the page, just looks broken.
      document.addEventListener('click', function (e) {
        if (navLinks.classList.contains('open') && !navLinks.contains(e.target) && e.target !== navToggle) {
          navLinks.classList.remove('open');
          navToggle.setAttribute('aria-expanded', 'false');
        }
      });
      navLinks.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          navLinks.classList.remove('open');
          navToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  }());
</script>
<% if (user.role === 'admin') { %>
  <script>
    (function () {
      var toggle = document.getElementById('admin-tools-toggle');
      var menu = document.getElementById('admin-tools-menu');
      if (!toggle || !menu) return;
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = !menu.classList.contains('d-none');
        menu.classList.toggle('d-none', isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
      document.addEventListener('click', function () {
        menu.classList.add('d-none');
        toggle.setAttribute('aria-expanded', 'false');
      });
    }());
  </script>
<% } %>
