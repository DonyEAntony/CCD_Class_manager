<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('registrations_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell-wide mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <% const availableCcdGradeMeanings = (typeof ccdGradeMeanings !== 'undefined' && ccdGradeMeanings) ? ccdGradeMeanings : {}; %>
  <% const activeGradeFilter = typeof gradeFilter !== 'undefined' ? gradeFilter : ''; %>
  <% const activeParentFilter = typeof parentFilter !== 'undefined' ? parentFilter : ''; %>
  <% const activeTypeFilter = typeof typeFilter !== 'undefined' ? typeFilter : 'child'; %>
  <% const activeStatusFilter = typeof statusFilter !== 'undefined' ? statusFilter : 'all'; %>
  <% const availableStatusOptions = (typeof statusOptionsForType !== 'undefined' && statusOptionsForType) ? statusOptionsForType : ['all']; %>
  <% const activeSortBy = typeof sortBy !== 'undefined' ? sortBy : ''; %>
  <% const activeSortDir = typeof sortDir !== 'undefined' ? sortDir : 'desc'; %>
  <% const tabBadgeStyle = "background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"; %>
  <% const statusOptionLabel = (opt) => {
       if (opt === 'all') return t('all_statuses');
       if (opt === 'active') return t('status_filter_active');
       if (opt === 'archived') return t('status_filter_archived');
       return t(opt);
     }; %>
  <% const registrationTypes = [
       { value: 'child', labelKey: 'registration_type_child' },
       { value: 'family_faith', labelKey: 'registration_type_family_faith' },
       { value: 'adult', labelKey: 'registration_type_adult' },
       { value: 'sponsor_confirmation', labelKey: 'registration_type_sponsor_confirmation' },
     ]; %>
  <% const defaultStatusByType = { child: 'in_progress', family_faith: 'in_progress', adult: 'active', sponsor_confirmation: 'in_progress' }; %>
  <% const filtersActive = activeStatusFilter !== defaultStatusByType[activeTypeFilter] || activeGradeFilter || activeParentFilter; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('all_registrations_header') %></h1>
      <p class="sub mb-0"><%= t('all_registrations_subtitle') %></p>
    </div>
    <% const exportQuery = [
         `type=${encodeURIComponent(activeTypeFilter)}`,
         activeGradeFilter ? `grade=${encodeURIComponent(activeGradeFilter)}` : '',
         activeParentFilter ? `parent=${encodeURIComponent(activeParentFilter)}` : '',
       ].filter(Boolean).join('&'); %>
    <a class="btn btn-outline-primary" id="export-csv-link" href="/admin/registrations/export.csv?<%= exportQuery %>" download>
      <%= t('export_registrations_csv') %>
    </a>
  </div>

  <% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
  <% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
  <% const uploadPathsForView = typeof certificateUploadPaths === 'function' ? certificateUploadPaths : ((value) => value ? [value] : []); %>

  <% const activeTypeCounts = (typeof typeCounts !== 'undefined' && typeCounts) ? typeCounts : {}; %>
  <% const activeStatusCounts = (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts : {}; %>
  <% const activeGrandTotal = typeof grandTotal !== 'undefined' ? grandTotal : 0; %>
  <% const activeFilteredCount = typeof filteredCount !== 'undefined' ? filteredCount : 0; %>
  <% const chipQuery = (overrides) => {
       const params = new URLSearchParams();
       params.set('type', overrides.type !== undefined ? overrides.type : activeTypeFilter);
       const status = overrides.status !== undefined ? overrides.status : activeStatusFilter;
       if (status && status !== defaultStatusByType[params.get('type')]) params.set('status', status);
       const grade = overrides.grade !== undefined ? overrides.grade : activeGradeFilter;
       if (grade) params.set('grade', grade);
       const parent = overrides.parent !== undefined ? overrides.parent : activeParentFilter;
       if (parent) params.set('parent', parent);
       return '/admin/registrations?' + params.toString();
     }; %>
  <% const sortLink = (column) => {
       const params = new URLSearchParams(chipQuery({}).split('?')[1] || '');
       const nextDir = (activeSortBy === column && activeSortDir === 'asc') ? 'desc' : 'asc';
       params.set('sort', column);
       params.set('dir', nextDir);
       return '/admin/registrations?' + params.toString();
     }; %>
  <% const sortIndicator = (column) => activeSortBy === column ? (activeSortDir === 'asc' ? ' ▲' : ' ▼') : ''; %>
  <% const activeChips = []; %>
  <% activeChips.push({ label: t(registrationTypes.find((rt) => rt.value === activeTypeFilter).labelKey), href: '/admin/registrations' }); %>
  <% if (activeStatusFilter !== defaultStatusByType[activeTypeFilter]) { activeChips.push({ label: statusOptionLabel(activeStatusFilter), href: chipQuery({ status: defaultStatusByType[activeTypeFilter] }) }); } %>
  <% if (activeGradeFilter) { activeChips.push({ label: `${t('grade')} ${activeGradeFilter}`, href: chipQuery({ grade: '' }) }); } %>
  <% if (activeParentFilter) { activeChips.push({ label: activeParentFilter, href: chipQuery({ parent: '' }) }); } %>

  <style>
    .rf-shell{display:flex;align-items:stretch;background:#fffdf8;border:1px solid rgba(32,30,29,.08);border-radius:20px;box-shadow:0 1px 3px rgba(32,30,29,.06);overflow:hidden;margin-bottom:1.5rem}
    .rf-sidebar{width:300px;flex:none;background:#ebddc5;border-radius:0 20px 20px 0;padding:1.6rem 1.4rem;display:flex;flex-direction:column;transition:width .18s ease,padding .18s ease}
    .rf-sidebar-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:2px}
    .rf-sidebar-head h4{margin:0;font-size:1.1rem;color:#201e1d}
    .rf-collapse-btn{width:26px;height:26px;flex:none;border-radius:50%;border:1px solid rgba(32,30,29,.2);background:transparent;color:#201e1d;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;line-height:1;padding:0}
    .rf-collapse-btn:hover{border-color:#c67139;color:#8c491a}
    .rf-sidebar-rail{display:none;flex-direction:column;align-items:center;gap:.7rem;margin-top:.6rem}
    .rf-rail-label{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(32,30,29,.6);font-weight:600}
    .rf-rail-badge{background:#c67139;color:#f5ead8;border-radius:999px;font-size:.68rem;font-weight:700;min-width:18px;height:18px;display:flex;align-items:center;justify-content:center;padding:0 4px}
    .rf-sidebar.rf-collapsed{width:60px;padding:1.4rem .6rem}
    .rf-sidebar.rf-collapsed .rf-sidebar-head{justify-content:center}
    .rf-sidebar.rf-collapsed .rf-sidebar-head h4{display:none}
    .rf-sidebar.rf-collapsed .rf-sidebar-body{display:none}
    .rf-sidebar.rf-collapsed .rf-sidebar-rail{display:flex}
    .rf-sidebar-sub{font-size:.78rem;color:rgba(32,30,29,.55);margin-bottom:1.2rem}
    .rf-lbl{font:600 .68rem/1 inherit;letter-spacing:.09em;text-transform:uppercase;color:rgba(32,30,29,.6);display:block;margin-bottom:.45rem}
    .rf-facet-list{display:flex;flex-direction:column;gap:2px;margin-bottom:1.2rem}
    .rf-facet{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.45rem .75rem;border-radius:999px;font-size:.85rem;cursor:pointer;color:#201e1d}
    .rf-facet:hover{background:rgba(32,30,29,.06)}
    .rf-facet.on{background:#e1eecc;color:#3d472b}
    .rf-facet .rf-n{font-size:.7rem;opacity:.55}
    .rf-facet input{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
    .rf-input{width:100%;min-height:36px;padding:.4rem .75rem;font-size:.85rem;color:#201e1d;background:#fffdf8;border:1px solid rgba(32,30,29,.18);border-radius:999px;margin-bottom:1.2rem}
    .rf-sidebar-actions{margin-top:auto;padding-top:1.2rem;display:flex;flex-direction:column;gap:.5rem}
    .rf-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;text-decoration:none;font-size:.85rem;font-weight:600;border-radius:999px;border:1px solid transparent;padding:.55rem 1rem}
    .rf-btn-primary{background:#c67139;color:#f5ead8}
    .rf-btn-primary:hover{background:#b2622d;color:#f5ead8}
    .rf-btn-ghost{color:#8c491a;background:transparent}
    .rf-btn-ghost:hover{background:rgba(198,113,57,.12)}
    .rf-main{flex:1;padding:1.6rem 1.8rem;min-width:0}
    .rf-main-header{display:flex;align-items:baseline;gap:.7rem;margin-bottom:.5rem}
    .rf-main-header h3{margin:0}
    .rf-result-count{font-size:.78rem;color:rgba(32,30,29,.5)}
    .rf-chip-row{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1.1rem}
    .rf-chip{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .7rem;border-radius:999px;font-size:.78rem;background:#ffe1d0;color:#8c491a;text-decoration:none;border:none}
    .rf-chip:hover{background:#ffc6a5;color:#8c491a}
    .rf-chip .rf-x{font-size:.8rem;opacity:.6}
    .rf-sort-link{color:inherit;text-decoration:none;white-space:nowrap}
    .rf-sort-link:hover{text-decoration:underline}
    @media (max-width:900px){.rf-shell{flex-direction:column}.rf-sidebar{width:auto;border-radius:20px 20px 0 0}.rf-sidebar.rf-collapsed{width:auto}}
  </style>

  <% const activeFilterCount = activeChips.length - 1; %>
  <div class="rf-shell">
    <aside class="rf-sidebar" id="rf-sidebar">
      <div class="rf-sidebar-head">
        <h4><%= t('filters_panel_title') %></h4>
        <button type="button" class="rf-collapse-btn" id="rf-collapse-toggle" aria-expanded="true" aria-controls="registrations-filter-form" title="<%= t('collapse_filters') %>">&#8249;</button>
      </div>
      <div class="rf-sidebar-rail">
        <button type="button" class="rf-collapse-btn" id="rf-expand-toggle" aria-label="<%= t('expand_filters') %>" title="<%= t('expand_filters') %>">&#8250;</button>
        <span class="rf-rail-label"><%= t('filters_panel_title') %></span>
        <% if (activeFilterCount > 0) { %><span class="rf-rail-badge"><%= activeFilterCount %></span><% } %>
      </div>
      <form method="get" action="/admin/registrations" id="registrations-filter-form" class="rf-sidebar-body">
        <div class="rf-sidebar-sub"><%= t('registrations_filter_summary').replace('%s', activeFilteredCount).replace('%s', activeGrandTotal) %></div>

        <span class="rf-lbl"><%= t('filter_by_type') %></span>
        <div class="rf-facet-list">
          <% registrationTypes.forEach((opt) => { %>
            <label class="rf-facet <%= activeTypeFilter === opt.value ? 'on' : '' %>">
              <input type="radio" name="type" value="<%= opt.value %>" <%= activeTypeFilter === opt.value ? 'checked' : '' %> onchange="this.form.submit()">
              <span><%= t(opt.labelKey) %></span>
              <span class="rf-n"><%= activeTypeCounts[opt.value] ?? 0 %></span>
            </label>
          <% }) %>
        </div>

        <span class="rf-lbl"><%= t('filter_by_status') %></span>
        <div class="rf-facet-list">
          <% availableStatusOptions.forEach((opt) => { %>
            <label class="rf-facet <%= activeStatusFilter === opt ? 'on' : '' %>">
              <input type="radio" name="status" value="<%= opt %>" <%= activeStatusFilter === opt ? 'checked' : '' %> onchange="this.form.submit()">
              <span><%= statusOptionLabel(opt) %></span>
              <span class="rf-n"><%= activeStatusCounts[opt] ?? 0 %></span>
            </label>
          <% }) %>
        </div>

        <% if (activeTypeFilter === 'child') { %>
          <span class="rf-lbl"><%= t('filter_by_grade') %></span>
          <select class="rf-input" name="grade" onchange="this.form.submit()">
            <option value="" <%= !activeGradeFilter ? 'selected' : '' %>><%= t('all_grades') %></option>
            <% Object.keys(availableCcdGradeMeanings).forEach((g) => { %>
              <option value="<%= g %>" <%= activeGradeFilter === g ? 'selected' : '' %>><%= g %> &mdash; <%= availableCcdGradeMeanings[g] %></option>
            <% }) %>
          </select>
          <span class="rf-lbl"><%= t('filter_by_parent') %></span>
          <input type="text" class="rf-input" name="parent" placeholder="<%= t('parent_filter_placeholder') %>" value="<%= activeParentFilter %>">
        <% } %>

        <div class="rf-sidebar-actions">
          <button type="submit" class="rf-btn rf-btn-primary"><%= t('apply_filters') %></button>
          <% if (filtersActive) { %>
            <a href="/admin/registrations?type=<%= activeTypeFilter %>" class="rf-btn rf-btn-ghost"><%= t('clear_filters') %></a>
          <% } %>
        </div>
      </form>
    </aside>
    <div class="rf-main">
      <div class="rf-main-header">
        <h3><%= t('all_registrations_header') %></h3>
        <span class="rf-result-count"><%= t('results_count_label').replace('%s', activeFilteredCount) %></span>
      </div>
      <div class="rf-chip-row">
        <% activeChips.forEach((chip) => { %>
          <a class="rf-chip" href="<%= chip.href %>"><%= chip.label %><span class="rf-x">&times;</span></a>
        <% }) %>
      </div>

      <% if (activeTypeFilter === 'child') { %>
        <% if (!studentRegs || studentRegs.length === 0) { %>
          <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= filtersActive ? t('no_registrations_match_filters') : t('no_children_regs') %></em></div>
        <% } else { %>
        <% const childHasArchivedRows = studentRegs.some((r) => r.archived_at); %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><a class="rf-sort-link" href="<%= sortLink('grade') %>"><%= t('grade') %><%= sortIndicator('grade') %></a></th>
                <th><%= t('primary_contact') %></th>
                <th><%= t('total_fees') %></th>
                <th><%= t('certificates') %></th>
                <th><%= t('child_verification_col_header') %></th>
                <th><%= t('status') %></th>
                <th><a class="rf-sort-link" href="<%= sortLink('submitted') %>"><%= t('submitted_col') %><%= sortIndicator('submitted') %></a></th>
                <% if (childHasArchivedRows) { %><th><%= t('archived_col') %></th><% } %>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
            <% studentRegs.forEach(r => { %>
              <tr>
                <td style="font-weight:600"><%= r.student_full_name %><% if (r.is_altar_server) { %> <span title="<%= t('altar_server_badge') %>">⛪</span><% } %></td>
                <td><%= (typeof resolveCcdGrade === 'function' ? resolveCcdGrade(r) : r.ccd_grade_level) || '—' %></td>
                <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
                <td><strong>$<%= (r.registration_fee||0)+(r.sacramental_fee||0)+(r.late_fee||0) %></strong></td>
                <td style="font-size:.85rem">
                  <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                  <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                  <%
                    const certFiles = [];
                    baptismPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('baptism'), sub: t('baptism'), href: uploadHrefForView(filePath) }));
                    communionPaths.forEach((filePath) => certFiles.push({ label: uploadFileNameForView(filePath) || t('communion'), sub: t('communion'), href: uploadHrefForView(filePath) }));
                  %>
                  <% if (certFiles.length) { %>
                    <button type="button" class="btn btn-sm btn-outline-secondary cert-files-btn" data-files="<%= JSON.stringify(certFiles) %>" data-name="<%= r.student_full_name || '' %>">
                      &#128206; <%= t('view_files_count').replace('%s', certFiles.length) %>
                    </button>
                  <% } else { %>
                    <span style="color:var(--muted)">&mdash;</span>
                  <% } %>
                </td>
                <td style="font-size:.78rem;min-width:180px">
                  <% ['certificates_verified', 'tuition_paid', 'parent_contacted'].forEach((field) => { %>
                    <div class="form-check verification-check-row" style="margin-bottom:2px">
                      <input
                        type="checkbox"
                        class="form-check-input verification-checkbox"
                        data-registration-id="<%= r.id %>"
                        data-field="<%= field %>"
                        id="verify-<%= field %>-<%= r.id %>"
                        <%= r[field] ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="verify-<%= field %>-<%= r.id %>"><%= t(field + '_label') %></label>
                      <div class="verification-meta" style="color:var(--muted)">
                        <% if (r[field] && r[field + '_by'] && verifierLookup && verifierLookup[r[field + '_by']]) { %>
                          <%= t('verified_by_on').replace('%s', verifierLookup[r[field + '_by']]).replace('%s', (typeof r[field + '_at'] === 'string' ? r[field + '_at'].slice(0, 16).replace('T', ' ') : (r[field + '_at'] ? r[field + '_at'].toISOString().slice(0, 16).replace('T', ' ') : ''))) %>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </td>
                <td>
                  <span class="badge" style="<%= tabBadgeStyle %>">
                    <%= t(r.status) %>
                  </span>
                </td>
                <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                <% if (childHasArchivedRows) { %>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.archived_at ? (typeof r.archived_at === 'string' ? r.archived_at.slice(0, 16).replace('T', ' ') : r.archived_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                <% } %>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false" aria-label="<%= t('more_actions') %>">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" href="/registration/children/edit/<%= r.id %>"><%= t('edit') %></a></li>
                      <li>
                        <form method="post" action="/registration/children/<%= r.id %>/status" class="px-3 py-1">
                          <label class="form-label mb-1" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)"><%= t('status') %></label>
                          <select class="form-select form-select-sm" name="status" onchange="this.form.submit()" onclick="event.stopPropagation()">
                            <% childRegistrationStatuses.forEach((statusOption) => { %>
                              <option value="<%= statusOption %>" <%= r.status === statusOption ? 'selected' : '' %>><%= t(statusOption) %></option>
                            <% }) %>
                          </select>
                          <input type="hidden" name="redirect_to" value="<%= chipQuery({}) %>">
                        </form>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <% if (r.archived_at) { %>
                          <form method="post" action="/admin/registrations/children/<%= r.id %>/unarchive">
                            <button class="dropdown-item" type="submit"><%= t('unarchive') %></button>
                          </form>
                        <% } else { %>
                          <form method="post" action="/admin/registrations/children/<%= r.id %>/archive">
                            <button class="dropdown-item" type="submit"><%= t('archive') %></button>
                          </form>
                        <% } %>
                      </li>
                      <li>
                        <form method="post" action="/admin/registrations/children/<%= r.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm_delete_registration_prefix')) %> + ' ' + <%= JSON.stringify(r.student_full_name || 'this student') %> + '? ' + <%= JSON.stringify(t('confirm_delete_registration_suffix')) %>);">
                          <button class="dropdown-item text-danger" type="submit"><%= t('remove') %></button>
                        </form>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      <% } else if (activeTypeFilter === 'family_faith') { %>
        <% if (!familyRegs || familyRegs.length === 0) { %>
          <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= filtersActive ? t('no_registrations_match_filters') : t('no_family_regs') %></em></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('family_name') %></th>
                <th><%= t('family_primary_contact') %></th>
                <th><%= t('members_col') %></th>
                <th><%= t('family_badges') %></th>
                <th><%= t('visit_window') %></th>
                <th><%= t('status') %></th>
                <th><a class="rf-sort-link" href="<%= sortLink('submitted') %>"><%= t('submitted_col') %><%= sortIndicator('submitted') %></a></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
            <% familyRegs.forEach((r) => { %>
              <tr>
                <td style="font-weight:600"><%= r.family_name %></td>
                <td style="font-size:.85rem">
                  <div><%= r.primary_contact_name || '—' %></div>
                  <div style="color:var(--muted)"><%= r.primary_contact_email || r.primary_contact_phone || '—' %></div>
                </td>
                <td style="font-size:.85rem">
                  <% if (!r.members.length) { %>
                    <span style="color:var(--muted)">&mdash;</span>
                  <% } else { %>
                    <% r.members.forEach((member) => { %>
                      <div>
                        <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %></strong>
                        <% if (member.role) { %><span style="color:var(--muted)">(<%= t(`role_${member.role}_member`) %>)</span><% } %>
                      </div>
                    <% }) %>
                  <% } %>
                </td>
                <td style="font-size:.85rem">
                  <% const membersWithNeeds = r.members.filter((member) => member.sacramentNeeds && member.sacramentNeeds.length); %>
                  <% if (!membersWithNeeds.length) { %>
                    <span style="color:var(--muted)"><%= t('family_badges_none') %></span>
                  <% } else { %>
                    <% membersWithNeeds.forEach((member) => { %>
                      <div class="mb-1">
                        <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %>:</strong>
                        <% member.sacramentNeeds.forEach((need) => { %>
                          <span class="badge" style="<%= tabBadgeStyle %>"><%= t(need) %></span>
                        <% }) %>
                      </div>
                    <% }) %>
                  <% } %>
                </td>
                <td style="font-size:.85rem">
                  <% if (r.visit_label) { %>
                    <div><strong><%= t('visit') %>:</strong> <%= r.visit_label %></div>
                  <% } else { %>
                    <span style="color:var(--muted)">&mdash;</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge" style="<%= tabBadgeStyle %>">
                    <%= t(r.status) %>
                  </span>
                </td>
                <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false" aria-label="<%= t('more_actions') %>">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" href="/registration/family-faith/edit/<%= r.id %>"><%= t('edit') %></a></li>
                      <li>
                        <form method="post" action="/registration/family-faith/<%= r.id %>/status" class="px-3 py-1">
                          <label class="form-label mb-1" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)"><%= t('status') %></label>
                          <select class="form-select form-select-sm" name="status" onchange="this.form.submit()" onclick="event.stopPropagation()">
                            <% familyFaithRegistrationStatuses.forEach((statusOption) => { %>
                              <option value="<%= statusOption %>" <%= r.status === statusOption ? 'selected' : '' %>><%= t(statusOption) %></option>
                            <% }) %>
                          </select>
                          <input type="hidden" name="redirect_to" value="<%= chipQuery({}) %>">
                        </form>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      <% } else if (activeTypeFilter === 'adult') { %>
        <% if (!adultRegs || adultRegs.length === 0) { %>
          <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= filtersActive ? t('no_registrations_match_filters') : t('no_adult_regs') %></em></div>
        <% } else { %>
        <% const adultHasArchivedRows = adultRegs.some((r) => r.archived_at); %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('name_col') %></th>
                <th><%= t('program_col') %></th>
                <th><%= t('email') %></th>
                <th><%= t('phone') %></th>
                <th><a class="rf-sort-link" href="<%= sortLink('submitted') %>"><%= t('date_col') %><%= sortIndicator('submitted') %></a></th>
                <th><%= t('status') %></th>
                <% if (adultHasArchivedRows) { %><th><%= t('archived_col') %></th><% } %>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
            <% adultRegs.forEach(r => { %>
              <% const prog = ADULT_PROGRAMS[r.program_type] || { title: r.program_type }; %>
              <tr>
                <td style="font-weight:600"><%= r.full_name %></td>
                <td>
                  <span class="badge" style="<%= tabBadgeStyle %>">
                    <%= prog.title %>
                  </span>
                </td>
                <td style="font-size:.85rem"><%= r.email || '—' %></td>
                <td style="font-size:.85rem"><%= r.phone || '—' %></td>
                <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
                <td>
                  <span class="badge" style="<%= tabBadgeStyle %>">
                    <%= t(r.status) %>
                  </span>
                </td>
                <% if (adultHasArchivedRows) { %>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.archived_at ? (typeof r.archived_at === 'string' ? r.archived_at.slice(0, 16).replace('T', ' ') : r.archived_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                <% } %>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false" aria-label="<%= t('more_actions') %>">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" href="/registration/adult/edit/<%= r.program_type %>/<%= r.id %>"><%= t('edit') %></a></li>
                      <li>
                        <% if (r.archived_at) { %>
                          <form method="post" action="/admin/registrations/adult/<%= r.id %>/unarchive">
                            <button class="dropdown-item" type="submit"><%= t('unarchive') %></button>
                          </form>
                        <% } else { %>
                          <form method="post" action="/admin/registrations/adult/<%= r.id %>/archive">
                            <button class="dropdown-item" type="submit"><%= t('archive') %></button>
                          </form>
                        <% } %>
                      </li>
                      <li>
                        <form method="post" action="/admin/registrations/adult/<%= r.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm_delete_registration_prefix')) %> + ' ' + <%= JSON.stringify(r.full_name || 'this person') %> + '? ' + <%= JSON.stringify(t('confirm_delete_registration_suffix')) %>);">
                          <button class="dropdown-item text-danger" type="submit"><%= t('remove') %></button>
                        </form>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      <% } else if (activeTypeFilter === 'sponsor_confirmation') { %>
        <% if (!sponsorRegs || sponsorRegs.length === 0) { %>
          <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= filtersActive ? t('no_registrations_match_filters') : t('no_sponsor_forms') %></em></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('student') %></th>
                <th><%= t('confirmation_name_col') %></th>
                <th><%= t('sponsor_col') %></th>
                <th><%= t('certificate_col') %></th>
                <th><%= t('verification_col') %></th>
                <th><a class="rf-sort-link" href="<%= sortLink('submitted') %>"><%= t('submitted_col') %><%= sortIndicator('submitted') %></a></th>
                <th><%= t('status') %></th>
                <th><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
            <% sponsorRegs.forEach(r => { %>
              <tr>
                <td style="font-weight:600"><%= r.student_name %></td>
                <td><%= r.confirmation_name || '—' %></td>
                <td><%= r.sponsor_name %></td>
                <td>
                  <% if (Number(r.is_st_matthew_parishioner)) { %>
                    <span><%= t('st_matthew_parishioner') %></span>
                  <% } else if (r.sponsor_certificate_path) { %>
                    <a href="<%= uploadHref(r.sponsor_certificate_path) %>" target="_blank" rel="noopener"><%= uploadFileName(r.sponsor_certificate_path) || t('view_file') %></a>
                  <% } else { %>
                    <span style="color:var(--muted)">&mdash;</span>
                  <% } %>
                </td>
                <td>
                  <% if (Number(r.is_st_matthew_parishioner)) { %>
                    <% if (Number(r.admin_verified)) { %>
                      <span class="badge text-bg-success"><%= t('admin_verified') %></span>
                    <% } else { %>
                      <span class="badge text-bg-warning"><%= t('pending_admin_review') %></span>
                    <% } %>
                  <% } else if (r.sponsor_certificate_path) { %>
                    <span style="color:var(--muted)"><%= t('certificate_provided') %></span>
                  <% } else { %>
                    <span class="badge text-bg-danger"><%= t('missing_certificate') %></span>
                  <% } %>
                </td>
                <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
                <td>
                  <span class="badge" style="<%= tabBadgeStyle %>">
                    <%= t(r.status) %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false" aria-label="<%= t('more_actions') %>">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <% if (Number(r.is_st_matthew_parishioner) && !Number(r.admin_verified)) { %>
                        <li>
                          <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/verify">
                            <button class="dropdown-item" type="submit"><%= t('verify') %></button>
                          </form>
                        </li>
                      <% } %>
                      <li><a class="dropdown-item" href="/registration/sponsor-confirmation/edit/<%= r.id %>"><%= t('edit') %></a></li>
                      <li>
                        <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/delete" onsubmit="return confirm('<%= t('confirm_delete_sponsor_form') %>');">
                          <button class="dropdown-item text-danger" type="submit"><%= t('remove') %></button>
                        </form>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>

<div class="modal fade" id="certFilesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="certFilesModalTitle"><%= t('certificate_files') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled mb-0" id="certFilesModalList"></ul>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    var sidebar = document.getElementById('rf-sidebar');
    var collapseBtn = document.getElementById('rf-collapse-toggle');
    var expandBtn = document.getElementById('rf-expand-toggle');
    if (!sidebar || !collapseBtn) return;
    var STORAGE_KEY = 'ccd-registrations-filters-collapsed';
    function setCollapsed(collapsed) {
      sidebar.classList.toggle('rf-collapsed', collapsed);
      collapseBtn.setAttribute('aria-expanded', String(!collapsed));
      try { window.localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch (e) {}
    }
    collapseBtn.addEventListener('click', function () { setCollapsed(true); });
    if (expandBtn) expandBtn.addEventListener('click', function () { setCollapsed(false); });
    try {
      if (window.localStorage.getItem(STORAGE_KEY) === '1') setCollapsed(true);
    } catch (e) {}
  }());
</script>
<script>
  (function () {
    var verifiedByOnTemplate = <%- JSON.stringify(t('verified_by_on')) %>;
    document.querySelectorAll('.verification-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        var registrationId = checkbox.dataset.registrationId;
        var field = checkbox.dataset.field;
        var checked = checkbox.checked;
        checkbox.disabled = true;
        fetch('/admin/registrations/children/' + registrationId + '/verification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ field: field, checked: checked }),
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            checkbox.disabled = false;
            if (!data.ok) {
              checkbox.checked = !checked;
              return;
            }
            var metaEl = checkbox.closest('.verification-check-row').querySelector('.verification-meta');
            if (data.checked && data.verifierName && data.at) {
              metaEl.textContent = verifiedByOnTemplate.replace('%s', data.verifierName).replace('%s', String(data.at).slice(0, 16).replace('T', ' '));
            } else {
              metaEl.textContent = '';
            }
          })
          .catch(function () {
            checkbox.disabled = false;
            checkbox.checked = !checked;
          });
      });
    });
  }());
</script>
<script>
  (function () {
    var modalEl = document.getElementById('certFilesModal');
    var modalTitleEl = document.getElementById('certFilesModalTitle');
    var modalListEl = document.getElementById('certFilesModalList');
    var certFilesModalTitleTemplate = <%- JSON.stringify(t('certificate_files')) %>;
    if (!modalEl) return;
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    document.querySelectorAll('.cert-files-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var files = [];
        try {
          files = JSON.parse(btn.dataset.files || '[]');
        } catch (e) {
          files = [];
        }
        modalTitleEl.textContent = btn.dataset.name ? (btn.dataset.name + ' — ' + certFilesModalTitleTemplate) : certFilesModalTitleTemplate;
        modalListEl.innerHTML = '';
        files.forEach(function (file) {
          var li = document.createElement('li');
          li.className = 'mb-2';
          var link = document.createElement('a');
          link.href = file.href;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = file.label;
          li.appendChild(link);
          if (file.sub) {
            var sub = document.createElement('span');
            sub.style.color = 'var(--muted)';
            sub.style.fontSize = '.8rem';
            sub.textContent = ' (' + file.sub + ')';
            li.appendChild(sub);
          }
          modalListEl.appendChild(li);
        });
        modal.show();
      });
    });
  }());
</script>
</body>
</html>
