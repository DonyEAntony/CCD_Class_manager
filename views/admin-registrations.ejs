<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registrations &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1>All Registrations</h1>
      <p class="sub mb-0">Every family, child, adult, and sponsor confirmation submission across the parish.</p>
    </div>
  </div>

  <!-- Children Registrations -->
  <div class="page-card mb-4">
    <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#children-regs-collapse" role="button" aria-expanded="false" aria-controls="children-regs-collapse" style="cursor:pointer">
      <h2 class="h5 mb-0"><%= t('faith_formation_children') %></h2>
      <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= (studentRegs || []).length %></span>
      <span class="collapse-chevron ms-auto">&#9656;</span>
    </div>
    <div class="collapse" id="children-regs-collapse">
    <div class="card-body p-0">
      <% if (!studentRegs || studentRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_children_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('student') %></th>
              <th><%= t('grade') %></th>
              <th><%= t('primary_contact') %></th>
              <th><%= t('total_fees') %></th>
              <th><%= t('certificates') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% studentRegs.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.student_full_name %></td>
              <td><%= r.ccd_grade_level || '&mdash;' %></td>
              <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '&mdash;' %></td>
              <td><strong>$<%= (r.registration_fee||0)+(r.sacramental_fee||0)+(r.late_fee||0) %></strong></td>
              <td style="font-size:.85rem">
                <% if (r.baptism_certificate_path) { %><a href="/<%= r.baptism_certificate_path %>"><%= t('baptism') %></a><% } %>
                <% if (r.baptism_certificate_path && r.first_communion_certificate_path) { %> &middot; <% } %>
                <% if (r.first_communion_certificate_path) { %><a href="/<%= r.first_communion_certificate_path %>"><%= t('communion') %></a><% } %>
                <% if (!r.baptism_certificate_path && !r.first_communion_certificate_path) { %><span style="color:var(--muted)">&mdash;</span><% } %>
              </td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <a href="/registration/children/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <form method="post" action="/admin/registrations/children/<%= r.id %>/archive" class="d-inline">
                  <button class="btn btn-sm btn-outline-secondary" type="submit">Archive</button>
                </form>
                <form method="post" action="/admin/registrations/children/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm('Permanently delete the registration for ' + <%- JSON.stringify(r.student_full_name || 'this student') %> + '? This cannot be undone.');">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    </div>
  </div>

  <!-- Archived Children Registrations -->
  <div class="page-card mb-4">
    <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#archived-children-regs-collapse" role="button" aria-expanded="false" aria-controls="archived-children-regs-collapse" style="cursor:pointer">
      <h2 class="h5 mb-0">Archived Children Registrations</h2>
      <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= (archivedStudentRegs || []).length %></span>
      <span class="collapse-chevron ms-auto">&#9656;</span>
    </div>
    <div class="collapse" id="archived-children-regs-collapse">
    <div class="card-body p-0">
      <% if (!archivedStudentRegs || archivedStudentRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em>No archived registrations.</em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('student') %></th>
              <th><%= t('primary_contact') %></th>
              <th>Archived</th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% archivedStudentRegs.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.student_full_name %></td>
              <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '&mdash;' %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.archived_at ? (typeof r.archived_at === 'string' ? r.archived_at.slice(0,10) : r.archived_at.toISOString().slice(0,10)) : '' %></td>
              <td>
                <form method="post" action="/admin/registrations/children/<%= r.id %>/unarchive" class="d-inline">
                  <button class="btn btn-sm btn-outline-primary" type="submit">Unarchive</button>
                </form>
                <form method="post" action="/admin/registrations/children/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm('Permanently delete the registration for ' + <%- JSON.stringify(r.student_full_name || 'this student') %> + '? This cannot be undone.');">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#family-regs-collapse" role="button" aria-expanded="false" aria-controls="family-regs-collapse" style="cursor:pointer">
      <h2 class="h5 mb-0"><%= t('family_faith_registrations') %></h2>
      <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= (familyRegs || []).length %></span>
      <span class="collapse-chevron ms-auto">&#9656;</span>
    </div>
    <div class="collapse" id="family-regs-collapse">
    <div class="card-body p-0">
      <% if (!familyRegs || familyRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_family_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('family_name') %></th>
              <th><%= t('family_primary_contact') %></th>
              <th><%= t('members_col') %></th>
              <th><%= t('family_badges') %></th>
              <th><%= t('visit_window') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% familyRegs.forEach((r) => { %>
            <tr>
              <td style="font-weight:600"><%= r.family_name %></td>
              <td style="font-size:.85rem">
                <div><%= r.primary_contact_name || '&mdash;' %></div>
                <div style="color:var(--muted)"><%= r.primary_contact_email || r.primary_contact_phone || '&mdash;' %></div>
              </td>
              <td style="font-size:.85rem">
                <% if (!r.members.length) { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } else { %>
                  <% r.members.forEach((member) => { %>
                    <div>
                      <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %></strong>
                      <% if (member.role) { %><span style="color:var(--muted)">(<%= t(`role_${member.role}_member`) %>)</span><% } %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td style="font-size:.85rem">
                <% const membersWithNeeds = r.members.filter((member) => member.sacramentNeeds && member.sacramentNeeds.length); %>
                <% if (!membersWithNeeds.length) { %>
                  <span style="color:var(--muted)"><%= t('family_badges_none') %></span>
                <% } else { %>
                  <% membersWithNeeds.forEach((member) => { %>
                    <div class="mb-1">
                      <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %>:</strong>
                      <% member.sacramentNeeds.forEach((need) => { %>
                        <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= t(need) %></span>
                      <% }) %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td style="font-size:.85rem">
                <% if (r.visit_label) { %>
                  <div><strong><%= t('visit') %>:</strong> <%= r.visit_label %></div>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <a href="/registration/family-faith/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    </div>
  </div>

  <!-- Adult Registrations -->
  <div class="page-card mb-4">
    <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#adult-regs-collapse" role="button" aria-expanded="false" aria-controls="adult-regs-collapse" style="cursor:pointer">
      <h2 class="h5 mb-0"><%= t('adult_program_regs') %></h2>
      <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= (adultRegs || []).length %></span>
      <span class="collapse-chevron ms-auto">&#9656;</span>
    </div>
    <div class="collapse" id="adult-regs-collapse">
    <div class="card-body p-0">
      <% if (!adultRegs || adultRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_adult_regs') %></em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th><%= t('name_col') %></th>
              <th><%= t('program_col') %></th>
              <th><%= t('email') %></th>
              <th><%= t('phone') %></th>
              <th><%= t('date_col') %></th>
              <th><%= t('status') %></th>
              <th><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
          <% adultRegs.forEach(r => { %>
            <% const prog = ADULT_PROGRAMS[r.program_type] || { title: r.program_type }; %>
            <tr>
              <td style="font-weight:600"><%= r.full_name %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= prog.title %>
                </span>
              </td>
              <td style="font-size:.85rem"><%= r.email || '&mdash;' %></td>
              <td style="font-size:.85rem"><%= r.phone || '&mdash;' %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0,10) : r.created_at.toISOString().slice(0,10)) : '' %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <a href="/registration/adult/edit/<%= r.program_type %>/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    </div>
  </div>

  <div class="page-card mb-4">
    <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#sponsor-regs-collapse" role="button" aria-expanded="false" aria-controls="sponsor-regs-collapse" style="cursor:pointer">
      <h2 class="h5 mb-0">Sponsor Confirmation Forms</h2>
      <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"><%= (sponsorRegs || []).length %></span>
      <span class="collapse-chevron ms-auto">&#9656;</span>
    </div>
    <div class="collapse" id="sponsor-regs-collapse">
    <div class="card-body p-0">
      <% if (!sponsorRegs || sponsorRegs.length === 0) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em>No sponsor confirmation forms yet.</em></div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Student</th>
              <th>Confirmation Name</th>
              <th>Sponsor</th>
              <th>Certificate</th>
              <th>Verification</th>
              <th>Submitted</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          <% sponsorRegs.forEach(r => { %>
            <tr>
              <td style="font-weight:600"><%= r.student_name %></td>
              <td><%= r.confirmation_name || '&mdash;' %></td>
              <td><%= r.sponsor_name %></td>
              <td>
                <% if (Number(r.is_st_matthew_parishioner)) { %>
                  <span>St. Matthew parishioner</span>
                <% } else if (r.sponsor_certificate_path) { %>
                  <a href="/<%= r.sponsor_certificate_path %>">View File</a>
                <% } else { %>
                  <span style="color:var(--muted)">&mdash;</span>
                <% } %>
              </td>
              <td>
                <% if (Number(r.is_st_matthew_parishioner)) { %>
                  <% if (Number(r.admin_verified)) { %>
                    <span class="badge text-bg-success">Admin verified</span>
                  <% } else { %>
                    <span class="badge text-bg-warning">Pending admin review</span>
                  <% } %>
                <% } else if (r.sponsor_certificate_path) { %>
                  <span style="color:var(--muted)">Certificate provided</span>
                <% } else { %>
                  <span class="badge text-bg-danger">Missing certificate</span>
                <% } %>
              </td>
              <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0,10) : r.created_at.toISOString().slice(0,10)) : '' %></td>
              <td>
                <span class="badge" style="background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)">
                  <%= t(r.status) %>
                </span>
              </td>
              <td>
                <% if (Number(r.is_st_matthew_parishioner) && !Number(r.admin_verified)) { %>
                  <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/verify" class="d-inline">
                    <button class="btn btn-sm btn-outline-success" type="submit">Verify</button>
                  </form>
                <% } %>
                <a href="/registration/sponsor-confirmation/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this sponsor confirmation form? This is helpful for removing test entries.');">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    </div>
  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
