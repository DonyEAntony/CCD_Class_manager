<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('registrations_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('all_registrations_header') %></h1>
      <p class="sub mb-0"><%= t('all_registrations_subtitle') %></p>
    </div>
  </div>

  <% const availableCcdGradeMeanings = (typeof ccdGradeMeanings !== 'undefined' && ccdGradeMeanings) ? ccdGradeMeanings : {}; %>
  <% const activeGradeFilter = typeof gradeFilter !== 'undefined' ? gradeFilter : ''; %>
  <% const tabBadgeStyle = "background:var(--surface);color:var(--navy-soft);font-size:.7rem;border-radius:2rem;padding:.3em .8em;font-weight:700;border:1px solid var(--border)"; %>
  <% const uploadHrefForView = typeof uploadHref === 'function' ? uploadHref : ((filePath) => filePath ? `/${String(filePath).replace(/\\/g, '/')}` : ''); %>
  <% const uploadFileNameForView = typeof uploadFileName === 'function' ? uploadFileName : ((filePath) => filePath ? String(filePath).replace(/\\/g, '/').split('/').pop() : ''); %>
  <% const uploadPathsForView = typeof certificateUploadPaths === 'function' ? certificateUploadPaths : ((value) => value ? [value] : []); %>

  <ul class="nav nav-tabs mb-4" id="registrationsTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active d-flex align-items-center gap-2" id="children-tab" data-bs-toggle="tab" data-bs-target="#children-pane" type="button" role="tab" aria-controls="children-pane" aria-selected="true">
        <%= t('faith_formation_children') %>
        <span class="badge" style="<%= tabBadgeStyle %>"><%= (studentRegs || []).length %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link d-flex align-items-center gap-2" id="archived-children-tab" data-bs-toggle="tab" data-bs-target="#archived-children-pane" type="button" role="tab" aria-controls="archived-children-pane" aria-selected="false">
        <%= t('archived_children_registrations_header') %>
        <span class="badge" style="<%= tabBadgeStyle %>"><%= (archivedStudentRegs || []).length %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link d-flex align-items-center gap-2" id="family-tab" data-bs-toggle="tab" data-bs-target="#family-pane" type="button" role="tab" aria-controls="family-pane" aria-selected="false">
        <%= t('family_faith_registrations') %>
        <span class="badge" style="<%= tabBadgeStyle %>"><%= (familyRegs || []).length %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link d-flex align-items-center gap-2" id="adult-tab" data-bs-toggle="tab" data-bs-target="#adult-pane" type="button" role="tab" aria-controls="adult-pane" aria-selected="false">
        <%= t('adult_program_regs') %>
        <span class="badge" style="<%= tabBadgeStyle %>"><%= (adultRegs || []).length %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link d-flex align-items-center gap-2" id="sponsor-tab" data-bs-toggle="tab" data-bs-target="#sponsor-pane" type="button" role="tab" aria-controls="sponsor-pane" aria-selected="false">
        <%= t('sponsor_confirmation_forms_header') %>
        <span class="badge" style="<%= tabBadgeStyle %>"><%= (sponsorRegs || []).length %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content" id="registrationsTabsContent">

    <!-- Children Registrations -->
    <div class="tab-pane fade show active" id="children-pane" role="tabpanel" aria-labelledby="children-tab">
      <div class="page-card mb-4">
        <div class="card-body p-0">
          <div class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom">
            <label class="form-label mb-0" for="children-grade-filter" style="font-size:.85rem"><%= t('filter_by_grade') %></label>
            <select class="form-select form-select-sm" id="children-grade-filter" style="max-width:280px" onchange="window.location.href = this.value ? '/admin/registrations?grade=' + this.value : '/admin/registrations';">
              <option value="" <%= !activeGradeFilter ? 'selected' : '' %>><%= t('all_grades') %></option>
              <% Object.keys(availableCcdGradeMeanings).forEach((g) => { %>
                <option value="<%= g %>" <%= activeGradeFilter === g ? 'selected' : '' %>><%= g %> &mdash; <%= availableCcdGradeMeanings[g] %></option>
              <% }) %>
            </select>
          </div>
          <% if (!studentRegs || studentRegs.length === 0) { %>
            <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= activeGradeFilter ? t('no_grade_match') : t('no_children_regs') %></em></div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th><%= t('student') %></th>
                  <th><%= t('grade') %></th>
                  <th><%= t('primary_contact') %></th>
                  <th><%= t('total_fees') %></th>
                  <th><%= t('certificates') %></th>
                  <th><%= t('child_verification_col_header') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('submitted_col') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
              <% studentRegs.forEach(r => { %>
                <tr>
                  <td style="font-weight:600"><%= r.student_full_name %></td>
                  <td><%= (typeof resolveCcdGrade === 'function' ? resolveCcdGrade(r) : r.ccd_grade_level) || '—' %></td>
                  <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
                  <td><strong>$<%= (r.registration_fee||0)+(r.sacramental_fee||0)+(r.late_fee||0) %></strong></td>
                  <td style="font-size:.85rem">
                    <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                    <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                    <% baptismPaths.forEach((filePath, index) => { %>
                      <% if (index > 0) { %> &middot; <% } %>
                      <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('baptism') %></a>
                    <% }) %>
                    <% if (baptismPaths.length && communionPaths.length) { %> &middot; <% } %>
                    <% communionPaths.forEach((filePath, index) => { %>
                      <% if (index > 0) { %> &middot; <% } %>
                      <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('communion') %></a>
                    <% }) %>
                    <% if (!baptismPaths.length && !communionPaths.length) { %><span style="color:var(--muted)">&mdash;</span><% } %>
                  </td>
                  <td style="font-size:.78rem;min-width:180px">
                    <% ['certificates_verified', 'tuition_paid', 'parent_contacted'].forEach((field) => { %>
                      <div class="form-check verification-check-row" style="margin-bottom:2px">
                        <input
                          type="checkbox"
                          class="form-check-input verification-checkbox"
                          data-registration-id="<%= r.id %>"
                          data-field="<%= field %>"
                          id="verify-<%= field %>-<%= r.id %>"
                          <%= r[field] ? 'checked' : '' %>
                        >
                        <label class="form-check-label" for="verify-<%= field %>-<%= r.id %>"><%= t(field + '_label') %></label>
                        <div class="verification-meta" style="color:var(--muted)">
                          <% if (r[field] && r[field + '_by'] && verifierLookup && verifierLookup[r[field + '_by']]) { %>
                            <%= t('verified_by_on').replace('%s', verifierLookup[r[field + '_by']]).replace('%s', (typeof r[field + '_at'] === 'string' ? r[field + '_at'].slice(0, 16).replace('T', ' ') : (r[field + '_at'] ? r[field + '_at'].toISOString().slice(0, 16).replace('T', ' ') : ''))) %>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  </td>
                  <td>
                    <span class="badge" style="<%= tabBadgeStyle %>">
                      <%= t(r.status) %>
                    </span>
                  </td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                  <td>
                    <a href="/registration/children/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                    <form method="post" action="/admin/registrations/children/<%= r.id %>/archive" class="d-inline">
                      <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t('archive') %></button>
                    </form>
                    <form method="post" action="/admin/registrations/children/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm(<%- JSON.stringify(t('confirm_delete_registration_prefix')) %> + ' ' + <%- JSON.stringify(r.student_full_name || 'this student') %> + '? ' + <%- JSON.stringify(t('confirm_delete_registration_suffix')) %>);">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Archived Children Registrations -->
    <div class="tab-pane fade" id="archived-children-pane" role="tabpanel" aria-labelledby="archived-children-tab">
      <div class="page-card mb-4">
        <div class="card-body p-0">
          <% if (!archivedStudentRegs || archivedStudentRegs.length === 0) { %>
            <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_archived_registrations') %></em></div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th><%= t('student') %></th>
                  <th><%= t('certificates') %></th>
                  <th><%= t('primary_contact') %></th>
                  <th><%= t('submitted_col') %></th>
                  <th><%= t('archived_col') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
              <% archivedStudentRegs.forEach(r => { %>
                <tr>
                  <td style="font-weight:600"><%= r.student_full_name %></td>
                  <td style="font-size:.85rem">
                    <% const baptismPaths = uploadPathsForView(r.baptism_certificate_path); %>
                    <% const communionPaths = uploadPathsForView(r.first_communion_certificate_path); %>
                    <% baptismPaths.forEach((filePath, index) => { %>
                      <% if (index > 0) { %> &middot; <% } %>
                      <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('baptism') %></a>
                    <% }) %>
                    <% if (baptismPaths.length && communionPaths.length) { %> &middot; <% } %>
                    <% communionPaths.forEach((filePath, index) => { %>
                      <% if (index > 0) { %> &middot; <% } %>
                      <a href="<%= uploadHrefForView(filePath) %>" target="_blank" rel="noopener"><%= uploadFileNameForView(filePath) || t('communion') %></a>
                    <% }) %>
                    <% if (!baptismPaths.length && !communionPaths.length) { %><span style="color:var(--muted)">&mdash;</span><% } %>
                  </td>
                  <td style="font-size:.85rem"><%= r.parent_name || r.primary_contact_email || '—' %></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.archived_at ? (typeof r.archived_at === 'string' ? r.archived_at.slice(0, 16).replace('T', ' ') : r.archived_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
                  <td>
                    <form method="post" action="/admin/registrations/children/<%= r.id %>/unarchive" class="d-inline">
                      <button class="btn btn-sm btn-outline-primary" type="submit"><%= t('unarchive') %></button>
                    </form>
                    <form method="post" action="/admin/registrations/children/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm(<%- JSON.stringify(t('confirm_delete_registration_prefix')) %> + ' ' + <%- JSON.stringify(r.student_full_name || 'this student') %> + '? ' + <%- JSON.stringify(t('confirm_delete_registration_suffix')) %>);">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Family Faith Registrations -->
    <div class="tab-pane fade" id="family-pane" role="tabpanel" aria-labelledby="family-tab">
      <div class="page-card mb-4">
        <div class="card-body p-0">
          <% if (!familyRegs || familyRegs.length === 0) { %>
            <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_family_regs') %></em></div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th><%= t('family_name') %></th>
                  <th><%= t('family_primary_contact') %></th>
                  <th><%= t('members_col') %></th>
                  <th><%= t('family_badges') %></th>
                  <th><%= t('visit_window') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('submitted_col') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
              <% familyRegs.forEach((r) => { %>
                <tr>
                  <td style="font-weight:600"><%= r.family_name %></td>
                  <td style="font-size:.85rem">
                    <div><%= r.primary_contact_name || '—' %></div>
                    <div style="color:var(--muted)"><%= r.primary_contact_email || r.primary_contact_phone || '—' %></div>
                  </td>
                  <td style="font-size:.85rem">
                    <% if (!r.members.length) { %>
                      <span style="color:var(--muted)">&mdash;</span>
                    <% } else { %>
                      <% r.members.forEach((member) => { %>
                        <div>
                          <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %></strong>
                          <% if (member.role) { %><span style="color:var(--muted)">(<%= t(`role_${member.role}_member`) %>)</span><% } %>
                        </div>
                      <% }) %>
                    <% } %>
                  </td>
                  <td style="font-size:.85rem">
                    <% const membersWithNeeds = r.members.filter((member) => member.sacramentNeeds && member.sacramentNeeds.length); %>
                    <% if (!membersWithNeeds.length) { %>
                      <span style="color:var(--muted)"><%= t('family_badges_none') %></span>
                    <% } else { %>
                      <% membersWithNeeds.forEach((member) => { %>
                        <div class="mb-1">
                          <strong><%= [member.firstName, member.lastName].filter(Boolean).join(' ') %>:</strong>
                          <% member.sacramentNeeds.forEach((need) => { %>
                            <span class="badge" style="<%= tabBadgeStyle %>"><%= t(need) %></span>
                          <% }) %>
                        </div>
                      <% }) %>
                    <% } %>
                  </td>
                  <td style="font-size:.85rem">
                    <% if (r.visit_label) { %>
                      <div><strong><%= t('visit') %>:</strong> <%= r.visit_label %></div>
                    <% } else { %>
                      <span style="color:var(--muted)">&mdash;</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge" style="<%= tabBadgeStyle %>">
                      <%= t(r.status) %>
                    </span>
                  </td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '—' %></td>
                  <td>
                    <a href="/registration/family-faith/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Adult Registrations -->
    <div class="tab-pane fade" id="adult-pane" role="tabpanel" aria-labelledby="adult-tab">
      <div class="page-card mb-4">
        <div class="card-body p-0">
          <% if (!adultRegs || adultRegs.length === 0) { %>
            <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_adult_regs') %></em></div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th><%= t('name_col') %></th>
                  <th><%= t('program_col') %></th>
                  <th><%= t('email') %></th>
                  <th><%= t('phone') %></th>
                  <th><%= t('date_col') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
              <% adultRegs.forEach(r => { %>
                <% const prog = ADULT_PROGRAMS[r.program_type] || { title: r.program_type }; %>
                <tr>
                  <td style="font-weight:600"><%= r.full_name %></td>
                  <td>
                    <span class="badge" style="<%= tabBadgeStyle %>">
                      <%= prog.title %>
                    </span>
                  </td>
                  <td style="font-size:.85rem"><%= r.email || '—' %></td>
                  <td style="font-size:.85rem"><%= r.phone || '—' %></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
                  <td>
                    <span class="badge" style="<%= tabBadgeStyle %>">
                      <%= t(r.status) %>
                    </span>
                  </td>
                  <td>
                    <a href="/registration/adult/edit/<%= r.program_type %>/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Sponsor Confirmation Forms -->
    <div class="tab-pane fade" id="sponsor-pane" role="tabpanel" aria-labelledby="sponsor-tab">
      <div class="page-card mb-4">
        <div class="card-body p-0">
          <% if (!sponsorRegs || sponsorRegs.length === 0) { %>
            <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_sponsor_forms') %></em></div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th><%= t('student') %></th>
                  <th><%= t('confirmation_name_col') %></th>
                  <th><%= t('sponsor_col') %></th>
                  <th><%= t('certificate_col') %></th>
                  <th><%= t('verification_col') %></th>
                  <th><%= t('submitted_col') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
              <% sponsorRegs.forEach(r => { %>
                <tr>
                  <td style="font-weight:600"><%= r.student_name %></td>
                  <td><%= r.confirmation_name || '—' %></td>
                  <td><%= r.sponsor_name %></td>
                  <td>
                    <% if (Number(r.is_st_matthew_parishioner)) { %>
                      <span><%= t('st_matthew_parishioner') %></span>
                    <% } else if (r.sponsor_certificate_path) { %>
                      <a href="<%= uploadHref(r.sponsor_certificate_path) %>" target="_blank" rel="noopener"><%= uploadFileName(r.sponsor_certificate_path) || t('view_file') %></a>
                    <% } else { %>
                      <span style="color:var(--muted)">&mdash;</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (Number(r.is_st_matthew_parishioner)) { %>
                      <% if (Number(r.admin_verified)) { %>
                        <span class="badge text-bg-success"><%= t('admin_verified') %></span>
                      <% } else { %>
                        <span class="badge text-bg-warning"><%= t('pending_admin_review') %></span>
                      <% } %>
                    <% } else if (r.sponsor_certificate_path) { %>
                      <span style="color:var(--muted)"><%= t('certificate_provided') %></span>
                    <% } else { %>
                      <span class="badge text-bg-danger"><%= t('missing_certificate') %></span>
                    <% } %>
                  </td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= r.created_at ? (typeof r.created_at === 'string' ? r.created_at.slice(0, 16).replace('T', ' ') : r.created_at.toISOString().slice(0, 16).replace('T', ' ')) : '' %></td>
                  <td>
                    <span class="badge" style="<%= tabBadgeStyle %>">
                      <%= t(r.status) %>
                    </span>
                  </td>
                  <td>
                    <% if (Number(r.is_st_matthew_parishioner) && !Number(r.admin_verified)) { %>
                      <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/verify" class="d-inline">
                        <button class="btn btn-sm btn-outline-success" type="submit"><%= t('verify') %></button>
                      </form>
                    <% } %>
                    <a href="/registration/sponsor-confirmation/edit/<%= r.id %>" class="btn btn-sm btn-outline-primary"><%= t('edit') %></a>
                    <form method="post" action="/admin/sponsor-confirmation/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm('<%= t('confirm_delete_sponsor_form') %>');">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>

  <p class="footer-note"><%= t('footer_note') %></p>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<% if (activeGradeFilter) { %>
<script>
  (function () {
    var childrenTab = document.getElementById('children-tab');
    if (childrenTab) bootstrap.Tab.getOrCreateInstance(childrenTab).show();
  }());
</script>
<% } %>
<script>
  (function () {
    var verifiedByOnTemplate = <%- JSON.stringify(t('verified_by_on')) %>;
    document.querySelectorAll('.verification-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        var registrationId = checkbox.dataset.registrationId;
        var field = checkbox.dataset.field;
        var checked = checkbox.checked;
        checkbox.disabled = true;
        fetch('/admin/registrations/children/' + registrationId + '/verification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ field: field, checked: checked }),
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            checkbox.disabled = false;
            if (!data.ok) {
              checkbox.checked = !checked;
              return;
            }
            var metaEl = checkbox.closest('.verification-check-row').querySelector('.verification-meta');
            if (data.checked && data.verifierName && data.at) {
              metaEl.textContent = verifiedByOnTemplate.replace('%s', data.verifierName).replace('%s', String(data.at).slice(0, 16).replace('T', ' '));
            } else {
              metaEl.textContent = '';
            }
          })
          .catch(function () {
            checkbox.disabled = false;
            checkbox.checked = !checked;
          });
      });
    });
  }());
</script>
</body>
</html>
