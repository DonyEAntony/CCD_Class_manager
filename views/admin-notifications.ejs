<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('admin_notifications_title') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>
<%- include('_admin_nav') %>
<main class="container py-4 app-shell mx-auto">
  <% const dateLabel = (value) => value ? (typeof value === 'string' ? value.slice(0, 16).replace('T', ' ') : value.toISOString().slice(0, 16).replace('T', ' ')) : '-'; %>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('admin_notifications_title') %></h1>
      <p class="sub mb-0"><%= t('admin_notifications_subtitle') %></p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/resources"><%= t('resources_nav') %></a>
  </div>

  <div class="page-card mb-4">
    <div class="card-header"><h2 class="h5 mb-0"><%= t('add_notification_button') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/notifications" class="row gy-3 gx-3">
        <div class="col-12 col-md-6">
          <label class="form-label" for="notification-title"><%= t('notification_title_label') %></label>
          <input class="form-control" type="text" id="notification-title" name="title" maxlength="255" required>
        </div>
        <div class="col-12">
          <label class="form-label" for="notification-message"><%= t('notification_message_label') %></label>
          <textarea class="form-control" id="notification-message" name="message" rows="2" maxlength="2000"></textarea>
        </div>

        <div class="col-12 col-md-3">
          <label class="form-label"><%= t('resource_visible_to_roles_label') %></label>
          <% assignableRoles.forEach((role) => { %>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="roles" value="<%= role %>" id="notification-role-<%= role %>">
              <label class="form-check-label" for="notification-role-<%= role %>"><%= roleLabels[role] || role %></label>
            </div>
          <% }) %>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="notification-class-teachers"><%= t('resource_visible_to_class_teachers_label') %></label>
          <select class="form-select" id="notification-class-teachers" name="class_teacher_ids" multiple size="5">
            <% ccdClasses.forEach((c) => { %>
              <option value="<%= c.id %>"><%= ccdGradeMeanings[c.grade_level] || c.grade_level %><%= c.sectionLabel || '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="notification-class-parents"><%= t('resource_visible_to_class_parents_label') %></label>
          <select class="form-select" id="notification-class-parents" name="class_parent_ids" multiple size="5">
            <% ccdClasses.forEach((c) => { %>
              <option value="<%= c.id %>"><%= ccdGradeMeanings[c.grade_level] || c.grade_level %><%= c.sectionLabel || '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="notification-individuals"><%= t('resource_visible_to_individuals_label') %></label>
          <select class="form-select" id="notification-individuals" name="target_user_ids" multiple size="5">
            <% assignableUsers.forEach((u) => { %>
              <option value="<%= u.id %>"><%= u.full_name || u.email %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <button class="btn btn-primary" type="submit"><%= t('add_notification_button') %></button>
        </div>
      </form>
    </div>
  </div>

  <div class="page-card">
    <div class="card-body p-0">
      <% if (!notifications.length) { %>
        <div class="p-4 text-center" style="color:var(--muted);font-size:.9rem"><em><%= t('no_notifications_yet') %></em></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= t('notification_title_label') %></th>
                <th><%= t('resource_visibility_label') %></th>
                <th><%= t('submitted_col') %></th>
                <th style="text-align:right"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% notifications.forEach((notification) => { %>
                <tr>
                  <td>
                    <div style="font-weight:600">
                      <%= notification.title %>
                      <% if (notification.type === 'resource') { %><span class="badge text-bg-secondary" style="font-size:.65rem;vertical-align:middle"><%= t('resources_nav') %></span><% } %>
                    </div>
                    <% if (notification.message) { %><div style="font-size:.82rem;color:var(--muted)"><%= notification.message %></div><% } %>
                  </td>
                  <td style="font-size:.85rem"><%= notification.assignmentLabels.join(', ') || '—' %></td>
                  <td style="font-size:.8rem;color:var(--muted)">
                    <%= dateLabel(notification.created_at) %><br>
                    <%= notification.acknowledgedCount %> <%= t('acknowledged_count_label') %>
                  </td>
                  <td style="text-align:right">
                    <form method="post" action="/admin/notifications/<%= notification.id %>/delete" onsubmit="return confirm('<%= t('remove_notification_confirm') %>');">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><%= t('remove') %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
