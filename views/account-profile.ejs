<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('account_profile') %> &mdash; <%= t('app_title') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('_topbar') %>

<main class="container py-4 app-shell mx-auto">
  <% const providerLabel = account.provider === 'local' ? 'Email and password' : (account.provider === 'google' ? 'Google' : (account.provider === 'github' ? 'GitHub' : account.provider)); %>
  <% const displayName = account.full_name || [account.first_name, account.last_name].filter(Boolean).join(' ') || account.email; %>
  <% const createdLabel = account.created_at ? (typeof account.created_at === 'string' ? account.created_at.slice(0, 10) : account.created_at.toISOString().slice(0, 10)) : ''; %>
  <% const verifiedLabel = account.email_verified_at ? (typeof account.email_verified_at === 'string' ? account.email_verified_at.slice(0, 10) : account.email_verified_at.toISOString().slice(0, 10)) : ''; %>

  <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
      <h1><%= t('account_profile') %></h1>
      <p class="sub mb-0"><%= t('account_profile_subtitle') %></p>
    </div>
    <a class="btn btn-outline-secondary" href="/dashboard"><%= t('back_to_dashboard') %></a>
  </div>

  <% if (success.length) { %><div class="alert alert-success mb-3"><%= success[0] %></div><% } %>
  <% if (error.length) { %><div class="alert alert-danger mb-3"><%= error[0] %></div><% } %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="page-card">
        <div class="card-header"><h2 class="h5"><%= t('profile_information') %></h2></div>
        <div class="card-body p-0">
          <table class="table mb-0">
            <tbody>
              <tr>
                <th style="width:38%"><%= t('full_name') %></th>
                <td><%= displayName %></td>
              </tr>
              <tr>
                <th><%= t('email') %></th>
                <td><%= account.email %></td>
              </tr>
              <tr>
                <th><%= t('phone') %></th>
                <td><%= account.phone || '-' %></td>
              </tr>
              <tr>
                <th><%= t('role') %></th>
                <td><span class="badge badge-role badge-<%= account.role %>"><%= account.role %></span></td>
              </tr>
              <tr>
                <th><%= t('member_since') %></th>
                <td><%= createdLabel || '-' %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="page-card">
        <div class="card-header"><h2 class="h5"><%= t('account_security') %></h2></div>
        <div class="card-body">
          <div class="d-grid gap-3">
            <div>
              <div class="text-muted small"><%= t('sign_in_method') %></div>
              <div class="fw-semibold"><%= providerLabel %></div>
            </div>
            <div>
              <div class="text-muted small"><%= t('account_status') %></div>
              <div class="fw-semibold"><%= account.is_active ? t('active_status') : t('inactive_status') %></div>
            </div>
            <div>
              <div class="text-muted small"><%= t('verified_status') %></div>
              <div class="fw-semibold"><%= verifiedLabel || t('not_verified_status') %></div>
            </div>
            <a class="btn btn-outline-primary" href="/account/uploads"><%= t('my_uploads') %></a>
            <% if (account.provider === 'local') { %>
              <a class="btn btn-primary" href="/account/password"><%= t('change_password') %></a>
            <% } %>
            <a class="btn btn-outline-secondary" href="/logout"><%= t('logout') %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
</body>
</html>
