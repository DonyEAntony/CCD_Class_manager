<!doctype html><html lang="<%= lang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lang === 'es' ? 'Corregir monto' : 'Correct payment amount' %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/styles.css"></head>
<body><%- include('_topbar') %><%- include('_admin_nav') %><main class="container app-shell-narrow py-4">
<% const text = (en,es) => lang === 'es' ? es : en; %>
<h1><%= text('Correct payment amount','Corregir monto del pago') %></h1>
<% for (const message of success) { %><div class="alert alert-success"><%= message %></div><% } %><% for (const message of error) { %><div class="alert alert-danger"><%= message %></div><% } %>
<section class="page-card p-4 mb-3">
<h2 class="h5"><%= text('Payment','Pago') %> #<%= payment.id %></h2>
<p><%= payment.method ? t('payment_method_'+payment.method) : '—' %> · <%= payment.paid_at ? formatDateOnly(payment.paid_at) : '—' %> · <%= payment.transaction_id || '—' %></p>
<p><%= text('Current amount','Monto actual') %>: <strong><%= payment.amount == null ? text('Unknown','Desconocido') : '$'+Number(payment.amount).toFixed(2) %></strong></p>
<p><%= text('Correct this existing entry using the receipt or payment export. All linked children will use the corrected amount. This does not add a payment or charge a card.','Corrija esta entrada usando el recibo o archivo de pagos. Todos los niños vinculados usarán el monto corregido. No se agrega un pago ni se cobra una tarjeta.') %></p>
<p class="small text-muted"><%= text('If you already added a separate payment for this same transaction, review and void the duplicate so it is not counted twice.','Si ya agregó otro pago para esta misma transacción, revise y anule el duplicado para evitar contarlo dos veces.') %></p>
<% if (payment.voided_at) { %><p><%= text('This payment is voided.','Este pago está anulado.') %></p><% } else { %>
<form method="post" action="/admin/payments/<%= payment.id %>/correct">
<input type="hidden" name="original_amount" value="<%= payment.amount ?? '' %>">
<label class="form-label d-block"><%= text('Correct amount','Monto correcto') %><input class="form-control" type="number" name="amount" min="0.01" max="9999999999.99" step="0.01" value="<%= payment.amount ?? '' %>" required></label>
<label class="form-label d-block"><%= text('Reason (required)','Motivo (obligatorio)') %><textarea class="form-control" name="reason" maxlength="500" required></textarea></label>
<button class="btn btn-primary"><%= text('Save correction','Guardar corrección') %></button>
</form><% } %></section>
<section class="page-card p-4 mb-3"><h2 class="h5"><%= text('Correction history','Historial de correcciones') %></h2>
<% if (!corrections.length) { %><p><%= text('No corrections recorded.','Sin correcciones registradas.') %></p><% } %>
<% corrections.forEach(c => { %><div class="border-top py-2"><strong><%= c.old_amount == null ? text('Unknown','Desconocido') : '$'+Number(c.old_amount).toFixed(2) %> → $<%= Number(c.new_amount).toFixed(2) %></strong><p class="mb-0"><%= c.reason %></p><small><%= c.actor_name || '#'+c.recorded_by %> · <%= formatDateOnly(c.created_at) %></small></div><% }) %></section>
<a href="/dashboard"><%= text('Back to overview','Volver al resumen') %></a> · <a href="/admin/students?status=all"><%= text('Student payment history','Historial de pagos del estudiante') %></a>
</main></body></html>
